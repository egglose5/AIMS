            </NavLink>
        </div>

<div class="nav-item px-3">
            <NavLink class="nav-link" href="show-brain">
                <span class="bi bi-lightbulb-nav-menu" aria-hidden="true"></span> Show Brain
            </NavLink>
        </div>

        <div class="nav-item px-3">
