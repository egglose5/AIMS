            <NavLink class="nav-link" href="show-orders">
                <span class="bi bi-clipboard-check-nav-menu" aria-hidden="true"></span> Show Orders
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="online-orders">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Online Orders
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="employees">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Employees
            </NavLink>
        </div>
<div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog-audit">
