                <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Purchase Orders
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sales">
                <span class="bi bi-graph-up-arrow-nav-menu" aria-hidden="true"></span> Square Sales
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fulfillment">
                <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Fulfillment
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="brain-core">
                <span class="bi bi-cpu-nav-menu" aria-hidden="true"></span> Brain Core
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="scout-discovery">
                <span class="bi bi-search" aria-hidden="true"></span> Scout Discovery
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="scout-research">
