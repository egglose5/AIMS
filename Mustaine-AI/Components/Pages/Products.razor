    private async Task SubmitDuplicateAsync()
    {
        _saving = true;
        _hasError = false;
        _message = null;
        try
        {
            if (!Guid.TryParse(_duplicateSourceId, out var sourceId))
                throw new InvalidOperationException("Pick a source product first.");

            _duplicateInput.SourceProductId = sourceId;
            var result = await ProductRegistry.DuplicateProductAsync(_duplicateInput);
            _message = result.Message;
            ResetDuplicateForm();
            await RefreshWorkspaceAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RetryBatchAsync(Guid batchId)
    {
        _saving = true;
        _hasError = false;
        _message = null;
        try
        {
            var result = await ProductRegistry.RetryBatchAsync(batchId);
            _message = result.Message;
