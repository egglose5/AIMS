@page "/products"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using MustaineAI.Services
@inject IProductRegistryService ProductRegistry
@inject INebulaAssetStorageService NebulaAssetStorage

<PageTitle>Products</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <p class="text-uppercase small text-secondary fw-semibold mb-1">Nebula</p>
            <h1 class="mb-2">Products</h1>
            <p class="text-body-secondary mb-0">Create artwork, variants, and reusable family defaults inside the live Control App. Square SKUs stay in the verified 4-digit convention, and each sellable variant keeps its own identity.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick="RefreshWorkspaceAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "Refresh Nebula")</button>
            <button class="btn btn-outline-secondary" @onclick="RefreshReconciliationAsync" disabled="@_reconLoading">@(_reconLoading ? "Refreshing…" : "Refresh Square Reconciliation")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_hasError ? "alert-danger" : "alert-success")">@_message</div>
    }

    @if (_workspace is null)
    {
        <div class="alert alert-info">Loading Nebula…</div>
    }
    else
    {
        var dashboard = _workspace.Dashboard;

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="text-body-secondary small">Products</div><div class="fs-2 fw-bold">@dashboard.TotalProducts</div></div></div></div>
            <div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="text-body-secondary small">Drafts</div><div class="fs-2 fw-bold">@dashboard.DraftProducts</div></div></div></div>
            <div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="text-body-secondary small">Active</div><div class="fs-2 fw-bold">@dashboard.ActiveProducts</div></div></div></div>
            <div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="text-body-secondary small">Mapped to Square</div><div class="fs-2 fw-bold">@dashboard.SquareMappedProducts</div></div></div></div>
            <div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="text-body-secondary small">Reserved SKUs</div><div class="fs-2 fw-bold">@dashboard.ReservedSkuCount</div></div></div></div>
        </div>

        <section class="card p-3 mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="h4 mb-1">+ Add Product</h2>
                    <p class="text-body-secondary mb-0">Choose the fastest path. Nebula keeps the decisions short and pulls defaults from the family/template layer whenever possible.</p>
                </div>
                <span class="badge text-bg-secondary">Round 2 operational workflow</span>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-4">
                <button class="btn @(FlowButton("NEW_ARTWORK"))" @onclick="@(() => SetFlow("NEW_ARTWORK"))">New Artwork / Design</button>
                <button class="btn @(FlowButton("NEW_PRODUCT"))" @onclick="@(() => SetFlow("NEW_PRODUCT"))">New Product</button>
                <button class="btn @(FlowButton("NEW_FAMILY"))" @onclick="@(() => SetFlow("NEW_FAMILY"))">New Product Family</button>
                <button class="btn @(FlowButton("DUPLICATE"))" @onclick="@(() => SetFlow("DUPLICATE"))">Duplicate Existing Product</button>
            </div>

            @if (_activeFlow == "NEW_ARTWORK")
            {
                <EditForm Model="_artworkInput" OnValidSubmit="SubmitArtworkAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <label class="form-label">Artwork / design name</label>
                            <InputText class="form-control" @bind-Value="_artworkInput.ArtworkName" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Artwork asset upload</label>
                            <InputFile class="form-control" OnChange="OnArtworkDesignFileChanged" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Product image upload</label>
                            <InputFile class="form-control" OnChange="OnArtworkProductImageChanged" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Product types / families</label>
                            <div class="row g-2">
                                @foreach (var family in _workspace.FamilyTemplates)
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <label class="border rounded p-2 d-block">
                                            <input class="form-check-input me-2" type="checkbox" checked="@_artworkInput.FamilyKeys.Contains(family.FamilyKey)" @onchange="args => ToggleArtworkFamily(family.FamilyKey, args.Value as bool? == true)" />
                                            <span class="fw-semibold">@family.FamilyName</span>
                                            <span class="small text-body-secondary d-block">@((family.ProductTypeCode ?? "—")) · @VariantPreview(family)</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Listing notes / overrides</label>
                            <InputText class="form-control" @bind-Value="_artworkInput.Notes" />
                        </div>
                        <div class="col-12 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_artworkInput.SyncToSquare" />
                            <label class="form-check-label">Create Square catalog records now</label>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit" disabled="@_saving">@(_saving ? "Creating…" : "Create Artwork Variants")</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetArtworkForm">Clear</button>
                    </div>
                </EditForm>
            }
            else if (_activeFlow == "NEW_PRODUCT")
            {
                <EditForm Model="_productInput" OnValidSubmit="SubmitProductAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <label class="form-label">Product name</label>
                            <InputText class="form-control" @bind-Value="_productInput.ProductName" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Family</label>
                            <InputSelect class="form-select" @bind-Value="_productInput.FamilyKey" @bind-Value:after="OnProductFamilyChangedAsync">
                                <option value="">Select a family…</option>
                                @foreach (var family in _workspace.FamilyTemplates)
                                {
                                    <option value="@family.FamilyKey">@family.FamilyName (@family.ProductTypeCode)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Artwork name if applicable</label>
                            <InputText class="form-control" @bind-Value="_productInput.ArtworkName" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Price override (USD)</label>
                            <InputNumber class="form-control" @bind-Value="_productInput.PriceOverride" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Artwork asset upload</label>
                            <InputFile class="form-control" OnChange="OnProductDesignFileChanged" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="col-lg-5">
                            <label class="form-label">Product image upload</label>
                            <InputFile class="form-control" OnChange="OnProductProductImageChanged" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Variants to create</label>
                            @if (SelectedProductFamily is null)
                            {
                                <div class="text-body-secondary small">Pick a family first.</div>
                            }
                            else if (SelectedProductFamily.VariantOptions.Count == 0)
                            {
                                <div class="text-body-secondary small">This family currently creates one Regular variant.</div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    @foreach (var option in SelectedProductFamily.VariantOptions.OrderBy(x => x.SortOrder))
                                    {
                                        <div class="col-md-4">
                                            <label class="border rounded p-2 d-block">
                                                <input class="form-check-input me-2" type="checkbox" checked="@_productInput.SelectedVariantCodes.Contains(option.OptionCode)" @onchange="args => ToggleProductVariant(option.OptionCode, args.Value as bool? == true)" />
                                                <span class="fw-semibold">@option.OptionName</span>
                                                <span class="small text-body-secondary d-block">@option.OptionCode</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <InputText class="form-control" @bind-Value="_productInput.Notes" />
                        </div>
                        <div class="col-12 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_productInput.SyncToSquare" />
                            <label class="form-check-label">Create Square catalog records now</label>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit" disabled="@_saving">@(_saving ? "Creating…" : "Create Product")</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetProductForm">Clear</button>
                    </div>
                </EditForm>
            }
            else if (_activeFlow == "NEW_FAMILY")
            {
                <EditForm Model="_familyInput" OnValidSubmit="SubmitFamilyAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <label class="form-label">Family name</label>
                            <InputText class="form-control" @bind-Value="_familyInput.FamilyName" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Product type code</label>
                            <InputText class="form-control" @bind-Value="_familyInput.ProductTypeCode" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Production family</label>
                            <InputText class="form-control" @bind-Value="_familyInput.ProductionFamily" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Square category</label>
                            <InputText class="form-control" @bind-Value="_familyInput.SquareCategoryName" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Woo category</label>
                            <InputText class="form-control" @bind-Value="_familyInput.WooCategoryName" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Default price (USD)</label>
                            <InputNumber class="form-control" @bind-Value="_familyInput.DefaultPrice" />
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Variant options</label>
                            <InputText class="form-control" @bind-Value="_familyInput.VariantOptionsText" />
                            <div class="form-text">Use `BK:Black, BR:Brown` style entries.</div>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Tax behavior</label>
                            <InputText class="form-control" @bind-Value="_familyInput.TaxBehavior" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Fulfillment model</label>
                            <InputText class="form-control" @bind-Value="_familyInput.FulfillmentModel" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Shipping length</label>
                            <InputNumber class="form-control" @bind-Value="_familyInput.ShippingLengthInches" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Shipping width</label>
                            <InputNumber class="form-control" @bind-Value="_familyInput.ShippingWidthInches" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Shipping height</label>
                            <InputNumber class="form-control" @bind-Value="_familyInput.ShippingHeightInches" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Shipping weight oz</label>
                            <InputNumber class="form-control" @bind-Value="_familyInput.ShippingWeightOunces" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Default description</label>
                            <InputText class="form-control" @bind-Value="_familyInput.DefaultDescription" />
                        </div>
                        <div class="col-12 d-flex gap-3 flex-wrap">
                            <label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_familyInput.SellInPerson" /> <span class="form-check-label">Sell in person</span></label>
                            <label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_familyInput.SellOnline" /> <span class="form-check-label">Sell online</span></label>
                            <label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_familyInput.TrackInventory" /> <span class="form-check-label">Track inventory</span></label>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit" disabled="@_saving">@(_saving ? "Saving…" : "Save Product Family")</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetFamilyForm">Clear</button>
                    </div>
                </EditForm>
            }
            else if (_activeFlow == "DUPLICATE")
            {
                <EditForm Model="_duplicateInput" OnValidSubmit="SubmitDuplicateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-lg-5">
                            <label class="form-label">Source product</label>
                            <InputSelect class="form-select" @bind-Value="_duplicateSourceId">
                                <option value="">Select a product…</option>
                                @foreach (var product in dashboard.Products.Take(100))
                                {
                                    <option value="@product.Id.ToString()">@product.Name (@VariantLabel(product))</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">New product name</label>
                            <InputText class="form-control" @bind-Value="_duplicateInput.NewProductName" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">New artwork name</label>
                            <InputText class="form-control" @bind-Value="_duplicateInput.ArtworkName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <InputText class="form-control" @bind-Value="_duplicateInput.Notes" />
                        </div>
                        <div class="col-12 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_duplicateInput.SyncToSquare" />
                            <label class="form-check-label">Create Square catalog record now</label>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" type="submit" disabled="@_saving">@(_saving ? "Duplicating…" : "Duplicate Product")</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetDuplicateForm">Clear</button>
                    </div>
                </EditForm>
            }
        </section>

        <section class="card mb-4">
            <div class="card-header">
                <strong>Recent Nebula batches</strong>
                <div class="small text-body-secondary">Each row shows the per-variant creation state so failed Square work can be retried without reusing SKUs.</div>
            </div>
            <div class="card-body">
                @if (_workspace.RecentBatches.Count == 0)
                {
                    <div class="text-body-secondary">No Nebula batches yet.</div>
                }
                else
                {
                    @foreach (var batch in _workspace.RecentBatches)
                    {
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start">
                                <div>
                                    <div class="fw-semibold">@batch.RequestedName</div>
                                    <div class="small text-body-secondary">@batch.WorkflowType · @batch.CreatedAt.ToLocalTime().ToString("g") · @batch.OperationKey</div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @BatchBadge(batch.Status)">@batch.Status</span>
                                    @if (batch.Variants.Any(x => x.RetryAllowed))
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => RetryBatchAsync(batch.BatchId)">Retry Failed</button>
                                    }
                                </div>
                            </div>
                            <div class="table-responsive mt-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Variant</th>
                                            <th>Square SKU</th>
                                            <th>Status</th>
                                            <th>Square IDs</th>
                                            <th>Error</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var variant in batch.Variants)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@variant.ProductName</div>
                                                    <div class="small text-body-secondary">@BuildVariantLabel(variant.ProductTypeCode, variant.LeatherCode)</div>
                                                </td>
                                                <td>@(variant.ReservedSquareSku ?? "Pending")</td>
                                                <td><span class="badge @VariantBadge(variant.Status)">@variant.Status</span></td>
                                                <td class="small text-body-secondary">@(string.IsNullOrWhiteSpace(variant.SquareCatalogVariationId) ? (variant.SquareCatalogItemId ?? "—") : $"{variant.SquareCatalogItemId} / {variant.SquareCatalogVariationId}")</td>
                                                <td class="small text-body-secondary">@(variant.LastError ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-header d-flex justify-content-between gap-2 flex-wrap">
                <div>
                    <strong>Registry products</strong>
                    <div class="small text-body-secondary">Newest 200 sellable variants in the live Control App registry.</div>
                </div>
                <input class="form-control form-control-sm" style="max-width: 280px;" placeholder="Filter products…" @bind="_filter" @bind:event="oninput" />
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Square SKU</th>
                            <th>Internal SKU</th>
                            <th>Status</th>
                            <th>Variant</th>
                            <th>Family</th>
                            <th>Square</th>
                            <th>Woo</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in FilteredProducts)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@product.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(product.ArtworkName))
                                    {
                                        <div class="small text-body-secondary">@product.ArtworkName</div>
                                    }
                                </td>
                                <td>@(product.SquareSku ?? "Pending")</td>
                                <td class="small text-body-secondary">@(product.PermanentSku ?? "—")</td>
                                <td><span class="badge @LifecycleBadge(product.LifecycleStatus)">@product.LifecycleStatus</span></td>
                                <td class="small text-body-secondary">@VariantLabel(product)</td>
                                <td>@(product.ProductFamily ?? "—")</td>
                                <td class="small text-body-secondary">@(string.IsNullOrWhiteSpace(product.SquareCatalogVariationId) ? (product.SquareCatalogItemId ?? "—") : $"{product.SquareCatalogItemId} / {product.SquareCatalogVariationId}")</td>
                                <td class="small text-body-secondary">@(string.IsNullOrWhiteSpace(product.WooVariationId) ? (product.WooProductId ?? "—") : $"{product.WooProductId} / {product.WooVariationId}")</td>
                                <td>@product.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card">
            <div class="card-header d-flex justify-content-between gap-2 flex-wrap">
                <div>
                    <strong>Square SKU reconciliation</strong>
                    <div class="small text-body-secondary">Compares live Square catalog SKU usage with the Control App registry without auto-linking uncertain matches.</div>
                </div>
                @if (_reconciliation is not null)
                {
                    <span class="badge text-bg-secondary">Assigned SKUs: @_reconciliation.AssignedSkuCount</span>
                }
            </div>

            @if (_reconciliation is null)
            {
                <div class="card-body text-body-secondary">Run the reconciliation when you want a fresh Square comparison.</div>
            }
            else
            {
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-body-secondary small">Duplicate SKUs</div><div class="fs-4 fw-bold">@_reconciliation.DuplicateSkuCount</div></div></div>
                        <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-body-secondary small">Missing Square SKUs</div><div class="fs-4 fw-bold">@_reconciliation.MissingSquareSkuCount</div></div></div>
                        <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-body-secondary small">Square not mapped</div><div class="fs-4 fw-bold">@_reconciliation.UnmappedSquareCount</div></div></div>
                        <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-body-secondary small">Safe matches</div><div class="fs-4 fw-bold">@_reconciliation.SafeMatchCount</div></div></div>
                        <div class="col-6 col-xl"><div class="border rounded p-3 h-100"><div class="text-body-secondary small">Conflicts</div><div class="fs-4 fw-bold">@_reconciliation.ConflictCount</div></div></div>
                    </div>
                </div>
            }
        </section>
    }
</div>

@code {
    private NebulaWorkspace? _workspace;
    private SquareSkuReconciliationReport? _reconciliation;
    private string _activeFlow = "NEW_ARTWORK";
    private string _filter = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _loading;
    private bool _saving;
    private bool _reconLoading;

    private SaveFamilyTemplateInput _familyInput = new()
    {
        VariantOptionsText = "BK:Black, BR:Brown"
    };
    private NebulaArtworkWorkflowInput _artworkInput = new();
    private NebulaProductWorkflowInput _productInput = new();
    private NebulaDuplicateWorkflowInput _duplicateInput = new();
    private string? _duplicateSourceId;

    private IBrowserFile? _artworkDesignFile;
    private IBrowserFile? _artworkProductImageFile;
    private IBrowserFile? _productDesignFile;
    private IBrowserFile? _productProductImageFile;

    private IReadOnlyList<ProductRegistryRow> FilteredProducts => _workspace?.Dashboard.Products
        .Where(x => string.IsNullOrWhiteSpace(_filter)
                    || x.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                    || (x.SquareSku?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.PermanentSku?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.ProductFamily?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.ArtworkName?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList() ?? [];

    private NebulaFamilyTemplateSummary? SelectedProductFamily => _workspace?.FamilyTemplates
        .FirstOrDefault(x => string.Equals(x.FamilyKey, _productInput.FamilyKey, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await RefreshWorkspaceAsync();
    }

    private async Task RefreshWorkspaceAsync()
    {
        _loading = true;
        try
        {
            _workspace = await ProductRegistry.GetWorkspaceAsync();
            if (SelectedProductFamily is not null && _productInput.SelectedVariantCodes.Count == 0)
                SeedProductVariantDefaults(SelectedProductFamily);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetFlow(string flow)
    {
        _activeFlow = flow;
        _message = null;
        _hasError = false;
    }

    private async Task SubmitArtworkAsync()
    {
        _saving = true;
        _hasError = false;
        _message = null;
        try
        {
            var input = new NebulaArtworkWorkflowInput
            {
                ArtworkName = _artworkInput.ArtworkName,
                FamilyKeys = _artworkInput.FamilyKeys.ToList(),
                Notes = _artworkInput.Notes,
                SyncToSquare = _artworkInput.SyncToSquare
            };

            if (_artworkDesignFile is not null)
                input.DesignAssetPath = (await NebulaAssetStorage.SaveAssetAsync(_artworkDesignFile, "artwork")).RelativeUrl;
            if (_artworkProductImageFile is not null)
                input.ProductImagePath = (await NebulaAssetStorage.SaveAssetAsync(_artworkProductImageFile, "product-image")).RelativeUrl;

            var result = await ProductRegistry.CreateArtworkBatchAsync(input);
            _message = result.Message;
            ResetArtworkForm();
            await RefreshWorkspaceAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SubmitProductAsync()
    {
        _saving = true;
        _hasError = false;
        _message = null;
        try
        {
            var input = new NebulaProductWorkflowInput
            {
                ProductName = _productInput.ProductName,
                FamilyKey = _productInput.FamilyKey,
                ArtworkName = _productInput.ArtworkName,
                Notes = _productInput.Notes,
                PriceOverride = _productInput.PriceOverride,
                SelectedVariantCodes = _productInput.SelectedVariantCodes.ToList(),
                SyncToSquare = _productInput.SyncToSquare
            };

            if (_productDesignFile is not null)
                input.DesignAssetPath = (await NebulaAssetStorage.SaveAssetAsync(_productDesignFile, "artwork")).RelativeUrl;
            if (_productProductImageFile is not null)
                input.ProductImagePath = (await NebulaAssetStorage.SaveAssetAsync(_productProductImageFile, "product-image")).RelativeUrl;

            var result = await ProductRegistry.CreateProductBatchAsync(input);
            _message = result.Message;
            ResetProductForm();
            await RefreshWorkspaceAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SubmitFamilyAsync()
    {
        _saving = true;
        _hasError = false;
        _message = null;
        try
        {
            var result = await ProductRegistry.SaveFamilyTemplateAsync(_familyInput);
            _message = $"Saved family template {result.FamilyName}.";
