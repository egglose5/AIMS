    private async Task RefreshReconciliationAsync()
    {
        _reconLoading = true;
        _hasError = false;
        _message = null;
        try
        {
            _reconciliation = await ProductRegistry.ReconcileSquareCatalogAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _message = $"Square reconciliation failed: {ex.Message}";
        }
        finally
        {
            _reconLoading = false;
        }
    }

