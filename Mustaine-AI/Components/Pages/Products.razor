        _artworkProductImageFile = e.File;
        return Task.CompletedTask;
    }

    private Task OnProductDesignFileChanged(InputFileChangeEventArgs e)
    {
        _productDesignFile = e.File;
        return Task.CompletedTask;
    }

    private Task OnProductProductImageChanged(InputFileChangeEventArgs e)
    {
        _productProductImageFile = e.File;
        return Task.CompletedTask;
    }

    private Task OnProductFamilyChangedAsync()
    {
        if (SelectedProductFamily is not null)
            SeedProductVariantDefaults(SelectedProductFamily);
        return Task.CompletedTask;
    }

    private void SeedProductVariantDefaults(NebulaFamilyTemplateSummary family)
    {
        _productInput.SelectedVariantCodes = family.VariantOptions.Count == 0
            ? []
            : family.VariantOptions.Where(x => x.IsDefaultSelected).Select(x => x.OptionCode).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void ToggleArtworkFamily(string familyKey, bool isSelected)
    {
        if (isSelected)
        {
            if (!_artworkInput.FamilyKeys.Contains(familyKey, StringComparer.OrdinalIgnoreCase))
                _artworkInput.FamilyKeys.Add(familyKey);
        }
        else
        {
            _artworkInput.FamilyKeys.RemoveAll(x => string.Equals(x, familyKey, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ToggleProductVariant(string optionCode, bool isSelected)
    {
        if (isSelected)
        {
            if (!_productInput.SelectedVariantCodes.Contains(optionCode, StringComparer.OrdinalIgnoreCase))
                _productInput.SelectedVariantCodes.Add(optionCode);
        }
        else
        {
            _productInput.SelectedVariantCodes.RemoveAll(x => string.Equals(x, optionCode, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ResetArtworkForm()
    {
        _artworkInput = new NebulaArtworkWorkflowInput();
        _artworkDesignFile = null;
        _artworkProductImageFile = null;
    }

    private void ResetProductForm()
    {
        _productInput = new NebulaProductWorkflowInput();
        _productDesignFile = null;
        _productProductImageFile = null;
    }

    private void ResetFamilyForm()
    {
        _familyInput = new SaveFamilyTemplateInput
        {
            VariantOptionsText = "BK:Black, BR:Brown"
        };
    }

    private void ResetDuplicateForm()
    {
        _duplicateInput = new NebulaDuplicateWorkflowInput();
        _duplicateSourceId = null;
    }

    private static string VariantPreview(NebulaFamilyTemplateSummary family)
        => family.VariantOptions.Count == 0
            ? "Regular"
            : string.Join(", ", family.VariantOptions.OrderBy(x => x.SortOrder).Select(x => x.OptionName));

    private static string BuildVariantLabel(string? productTypeCode, string? leatherCode)
    {
        var parts = new[] { productTypeCode, leatherCode }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();

        return parts.Length == 0 ? "—" : string.Join(" / ", parts);
    }

    private static string LifecycleBadge(string status) => status switch
    {
        "ACTIVE" => "text-bg-success",
        "PAUSED" => "text-bg-warning",
        "DISCONTINUED" => "text-bg-secondary",
        _ => "text-bg-primary"
    };

    private static string BatchBadge(string status) => status switch
    {
        "COMPLETE" => "text-bg-success",
        "DRAFT_READY" => "text-bg-primary",
        "PARTIAL_FAILURE" => "text-bg-warning",
        "FAILED" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string VariantBadge(string status) => status switch
    {
        "SQUARE_SYNCED" => "text-bg-success",
        "SQUARE_FAILED" => "text-bg-danger",
        "DRAFT_READY" => "text-bg-primary",
        _ => "text-bg-secondary"
    };

    private static string VariantLabel(ProductRegistryRow product)
        => BuildVariantLabel(product.ProductTypeCode, product.LeatherCode);

    private string FlowButton(string flow)
        => _activeFlow == flow ? "btn-primary" : "btn-outline-primary";
}
