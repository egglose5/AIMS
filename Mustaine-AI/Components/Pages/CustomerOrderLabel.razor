@page "/production/customer-order-label"
@rendermode InteractiveServer
@layout BlankLayout
@using Microsoft.EntityFrameworkCore
@using MustaineAI.Components.Layout
@using MustaineAI.Data
@inject ApplicationDbContext DbContext
@inject IJSRuntime JSRuntime

<PageTitle>Customer Order Completion Label</PageTitle>

<style>
@@page { size: 2in .75in; margin: 0; }
@@media print {
    html, body { width: 2in !important; height: .75in !important; margin: 0 !important; padding: 0 !important; overflow: hidden !important; }
    .customer-order-print-label { width: 2in !important; height: .75in !important; margin: 0 !important; padding: .04in .06in !important; box-sizing: border-box !important; overflow: hidden !important; break-after: avoid !important; page-break-after: avoid !important; }
    .customer-order-print-label svg { width: 100% !important; height: .48in !important; display: block !important; }
}
</style>

@if (Order is not null)
{
    <article class="customer-order-print-label" style="width:2in;height:.75in;padding:.04in .06in;box-sizing:border-box;overflow:hidden;background:white;color:black;font-family:Arial,sans-serif">
        <div style="font-size:10px;font-weight:700;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@Order.ProductName · @Order.CustomerName</div>
        <div style="height:.50in;overflow:hidden">@((MarkupString)GenerateCode128Svg($"SO:{Order.Id:N}", 1, 38))</div>
    </article>
}

@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "autoprint")] public bool AutoPrint { get; set; } = true;
    private FulfillmentOrderLineEntity? Order;
    private bool _printed;

    protected override async Task OnParametersSetAsync()
    {
        Order = Id is null ? null : await DbContext.FulfillmentOrderLines.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_printed && AutoPrint && Order is not null)
        {
            _printed = true;
            await JSRuntime.InvokeVoidAsync("print");
        }
    }

    private static string GenerateCode128Svg(string value, int moduleWidth = 2, int barHeight = 48)
    {
        var payload = string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();
        var codes = new List<int> { 104 };

        foreach (var character in payload)
        {
            var normalized = character is < ' ' or > '~' ? '?' : character;
            codes.Add(normalized - 32);
        }

        var checksum = codes[0];
        for (var index = 1; index < codes.Count; index++)
        {
            checksum += codes[index] * index;
        }

        checksum %= 103;
        codes.Add(checksum);
        codes.Add(106);

        const int quietZone = 10;

        var x = quietZone;
        var bars = new List<string>();

        foreach (var code in codes)
        {
            var pattern = Code128Patterns[code];
            var drawBar = true;

            foreach (var digit in pattern)
            {
                var width = (digit - '0') * moduleWidth;
                if (drawBar)
                {
                    bars.Add($"<rect x=\"{x}\" y=\"0\" width=\"{width}\" height=\"{barHeight}\" fill=\"#000\" />");
                }

                x += width;
                drawBar = !drawBar;
            }
        }

        var totalWidth = x + quietZone;
        var text = System.Net.WebUtility.HtmlEncode(payload);

        return $"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{totalWidth}\" height=\"{barHeight}\" viewBox=\"0 0 {totalWidth} {barHeight}\" shape-rendering=\"crispEdges\" role=\"img\" aria-label=\"Code 128 barcode for {text}\"><rect width=\"100%\" height=\"100%\" fill=\"#fff\" />{string.Join(string.Empty, bars)}</svg>";
    }

    private static readonly string[] Code128Patterns =
    [
        "212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
        "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
        "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
        "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
        "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
        "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
        "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
        "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
        "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
        "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
        "114131", "311141", "411131", "211412", "211214", "211232", "2331112"
    ];
}
