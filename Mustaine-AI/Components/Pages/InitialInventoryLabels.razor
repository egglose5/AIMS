@page "/initial-inventory/labels"
@rendermode InteractiveServer
@layout BlankLayout
@using MustaineAI.Components.Layout
@inject IJSRuntime JSRuntime

<PageTitle>Initial Inventory Labels</PageTitle>

<style>
@@page {
    size: 2in 0.75in;
    margin: 0;
}

html, body {
    margin: 0;
    padding: 0;
}

@@media print {
    html, body,
    .production-label-page,
    .production-label-grid {
        width: 2in !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .production-label-card {
        box-sizing: border-box !important;
        width: 2in !important;
        height: 0.74in !important;
        margin: 0 !important;
        padding: 0.075in 0.10in !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        break-after: page !important;
        page-break-after: always !important;
    }

    .production-label-card:last-child {
        break-after: auto !important;
        page-break-after: auto !important;
    }

    .production-label-svg {
        display: block !important;
        width: 1.80in !important;
        height: 0.58in !important;
        margin: 0 !important;
        padding: 0 !important;
    }
}
</style>

<div class="production-label-page">
    <div class="production-label-grid">
        @foreach (var label in ParsedLabels)
        {
            @for (var i = 0; i < label.Quantity; i++)
            {
                <article class="production-label-card">
                    @((MarkupString)GenerateCode128LabelSvg(label.Sku, label.Leather))
                </article>
            }
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "labels")] public string Labels { get; set; } = string.Empty;
    private bool _printed;
    private IEnumerable<LabelSpec> ParsedLabels => (Labels ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Split(':'))
        .Where(x => x.Length == 3 && int.TryParse(x[1], out _))
        .Select(x => new LabelSpec(x[0], int.Parse(x[1]), x[2]));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_printed)
        {
            _printed = true;
            await Task.Delay(250);
            await JSRuntime.InvokeVoidAsync("print");
        }
    }

    private static string GenerateCode128LabelSvg(string value, string humanText)
    {
        var payload = string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();
        var codes = new List<int> { 104 };

        foreach (var character in payload)
        {
            var normalized = character is < ' ' or > '~' ? '?' : character;
            codes.Add(normalized - 32);
        }

        var checksum = codes[0];
        for (var index = 1; index < codes.Count; index++)
        {
            checksum += codes[index] * index;
        }

        checksum %= 103;
        codes.Add(checksum);
        codes.Add(106);

        const int moduleWidth = 2;
        const int quietZone = 10;
        const int barHeight = 28;
        const int labelHeight = 48;

        var x = quietZone;
        var bars = new List<string>();

        foreach (var code in codes)
        {
            var pattern = Code128Patterns[code];
            var drawBar = true;

            foreach (var digit in pattern)
            {
                var width = (digit - '0') * moduleWidth;
                if (drawBar)
                {
                    bars.Add($"<rect x=\"{x}\" y=\"0\" width=\"{width}\" height=\"{barHeight}\" fill=\"#000\" />");
                }

                x += width;
                drawBar = !drawBar;
            }
        }

        var totalWidth = x + quietZone;
        var aria = System.Net.WebUtility.HtmlEncode(payload);
        var text = System.Net.WebUtility.HtmlEncode(humanText ?? string.Empty);

        // Barcode and stitcher text live in ONE SVG. The browser cannot split them across
        // two physical DYMO labels.
        return $"<svg class=\"production-label-svg\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1.80in\" height=\"0.58in\" viewBox=\"0 0 {totalWidth} {labelHeight}\" preserveAspectRatio=\"none\" shape-rendering=\"crispEdges\" role=\"img\" aria-label=\"Code 128 barcode for {aria}\"><rect width=\"100%\" height=\"100%\" fill=\"#fff\" />{string.Join(string.Empty, bars)}<text x=\"{totalWidth / 2}\" y=\"44\" text-anchor=\"middle\" font-family=\"Arial, Helvetica, sans-serif\" font-size=\"10\" font-weight=\"700\" fill=\"#000\" shape-rendering=\"auto\">{text}</text></svg>";
    }

    private static readonly string[] Code128Patterns =
    [
        "212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
        "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
        "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
        "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
        "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
        "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
        "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
        "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
        "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
        "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
        "114131", "311141", "411131", "211412", "211214", "211232", "2331112"
    ];

    private sealed record LabelSpec(string Sku, int Quantity, string Leather);
}
