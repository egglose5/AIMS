@page "/scout"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Scout</PageTitle>

<div class="shows-hero">
    <p class="shows-eyebrow">Scout</p>
    <h1>Scout Moved</h1>
    <p>The legacy Scout surface is deprecated. Use Scout Discovery for Phase 1 and Scout Research for Phase 2.</p>
</div>

<div class="alert alert-info mt-3">Redirecting to Scout Discovery…</div>

@code {
    protected override void OnInitialized()
        => NavigationManager.NavigateTo("/scout-discovery", replace: true);
}
