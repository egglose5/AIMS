    private string? GetRowSelectedStockId(string elementKey) =>
        _rowSelectedStockIds.TryGetValue(elementKey, out var selectedStockId) ? selectedStockId : null;

    private void SetRowSelectedStockId(string elementKey, string? value)
    {
        _rowSelectedStockIds[elementKey] = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private string GetRowSelectedStockAmountText(string elementKey) =>
        _rowSelectedStockAmounts.TryGetValue(elementKey, out var selectedAmount) && selectedAmount is > 0
            ? selectedAmount.Value.ToString("0.##")
            : string.Empty;

    private void SetRowSelectedStockAmount(string elementKey, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var amount) && amount > 0)
        {
            _rowSelectedStockAmounts[elementKey] = decimal.Round(amount, 2, MidpointRounding.AwayFromZero);
            return;
        }

        _rowSelectedStockAmounts[elementKey] = null;
    }

    private bool CanAddRowInputDefinition(string elementKey)
    {
        var selectedStockId = GetRowSelectedStockId(elementKey);
        return !string.IsNullOrWhiteSpace(selectedStockId) &&
               _rowSelectedStockAmounts.TryGetValue(elementKey, out var selectedAmount) &&
               selectedAmount is > 0;
    }

    private void AddRowInputDefinition(string elementKey)
    {
        if (!CanAddRowInputDefinition(elementKey))
        {
            return;
        }

        var selectedStockId = _rowSelectedStockIds[elementKey]!;
        var selectedStock = StockConsumableOptions.FirstOrDefault(option => string.Equals(option.Key, selectedStockId, StringComparison.OrdinalIgnoreCase));
        if (selectedStock is null)
        {
            return;
        }

        var selectedAmount = _rowSelectedStockAmounts[elementKey]!.Value;
        if (!_rowInputDefinitions.TryGetValue(elementKey, out var definitions))
        {
            definitions = [];
            _rowInputDefinitions[elementKey] = definitions;
        }

        var existing = definitions.FirstOrDefault(definition => string.Equals(definition.StockKey, selectedStock.Key, StringComparison.OrdinalIgnoreCase));
        if (existing is null)
        {
            definitions.Add(new RowInputDefinition(
                selectedStock.Key,
                selectedStock.Name,
                selectedStock.Type,
                selectedAmount));
        }
        else
        {
            definitions.Remove(existing);
            definitions.Add(existing with
            {
                QuantityPerRun = decimal.Round(existing.QuantityPerRun + selectedAmount, 2, MidpointRounding.AwayFromZero)
            });
        }

        _rowSelectedStockIds[elementKey] = null;
        _rowSelectedStockAmounts[elementKey] = null;
    }

    private IReadOnlyList<RowInputDefinition> GetRowInputDefinitions(string elementKey) =>
        _rowInputDefinitions.TryGetValue(elementKey, out var definitions)
            ? definitions
            : [];

    private void RemoveRowInputDefinition(string elementKey, string stockKey)
    {
        if (!_rowInputDefinitions.TryGetValue(elementKey, out var definitions))
        {
            return;
        }

        definitions.RemoveAll(definition => string.Equals(definition.StockKey, stockKey, StringComparison.OrdinalIgnoreCase));
        if (definitions.Count == 0)
        {
            _rowInputDefinitions.Remove(elementKey);
        }
    }

    private string GetRowOutputPerRunText(string elementKey) =>
        _rowOutputPerRun.TryGetValue(elementKey, out var outputPerRun) && outputPerRun is > 0
            ? outputPerRun.Value.ToString("0.##")
            : string.Empty;

    private void SetRowOutputPerRun(string elementKey, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var outputPerRun) && outputPerRun > 0)
        {
            _rowOutputPerRun[elementKey] = decimal.Round(outputPerRun, 2, MidpointRounding.AwayFromZero);
            return;
        }

        _rowOutputPerRun[elementKey] = null;
    }

    private bool CanUploadRowManufacturingFile(string elementKey) =>
        !_isUploadingManufacturingFile &&
        _rowPendingManufacturingFiles.ContainsKey(elementKey) &&
        GetRowInputDefinitions(elementKey).Count > 0 &&
        _rowOutputPerRun.TryGetValue(elementKey, out var outputPerRun) &&
        outputPerRun is > 0;

    private bool TryGetRowPendingFileName(string elementKey, out string fileName)
    {
        if (_rowPendingManufacturingFiles.TryGetValue(elementKey, out var file))
        {
            fileName = file.Name;
            return true;
        }

        fileName = string.Empty;
        return false;
    }

    private string BuildRowInputDefinitionText(string elementKey)
    {
        var definitions = GetRowInputDefinitions(elementKey);
        if (definitions.Count == 0)
        {
            return "Unspecified";
        }

        return string.Join(", ", definitions.Select(definition => $"{definition.StockName} ({definition.StockType}) x {definition.QuantityPerRun:0.##}"));
    }

    private string BuildRowOutputDefinitionText(string elementKey)
    {
        if (!_rowOutputPerRun.TryGetValue(elementKey, out var outputPerRun) || outputPerRun is <= 0)
        {
            return "Unspecified";
        }

        return $"{outputPerRun:0.##} output unit(s) per file run";
    }

