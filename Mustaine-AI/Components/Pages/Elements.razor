    private static string? FindDirectoryIgnoreCase(string parentDirectory, string directoryName)
    {
        if (!Directory.Exists(parentDirectory))
        {
            return null;
        }

        return Directory.GetDirectories(parentDirectory)
            .FirstOrDefault(directory =>
                string.Equals(Path.GetFileName(directory), directoryName, StringComparison.OrdinalIgnoreCase));
    }

    private static string ToDisplaySegment(string segment) =>
        segment.Replace('_', ' ').Replace('-', ' ').Trim();

    private static string[] ParseColors(string colors) =>
        colors
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(color => !string.IsNullOrWhiteSpace(color))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static bool IsMetadataFile(string filePath)
    {
        var fileName = Path.GetFileName(filePath);
        return string.Equals(fileName, "colors.txt", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(fileName, "cogs.txt", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDesignFile(string filePath) =>
        Path.GetFileName(filePath).StartsWith("design-file", StringComparison.OrdinalIgnoreCase);

    private static bool IsSupportedAssetFile(string filePath)
    {
        if (IsMetadataFile(filePath))
        {
            return false;
        }

        var extension = Path.GetExtension(filePath);
        return IsImageFile(filePath) ||
               extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".nc", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".gc", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".gcode", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".tap", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".lbrn", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".lbrn2", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".svg", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".dxf", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsImageFile(string filePath)
    {
        var extension = Path.GetExtension(filePath);
        return extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".gif", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".webp", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".bmp", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".svg", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".tif", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".tiff", StringComparison.OrdinalIgnoreCase) ||
               extension.Equals(".avif", StringComparison.OrdinalIgnoreCase);
    }

    private static IEnumerable<StoredNonImageElementFolder> EnumerateNonImageElementEntries(string typeDirectory)
    {
        foreach (var directory in EnumerateCandidateElementDirectories(typeDirectory))
        {
            var colorsPath = Path.Combine(directory, "colors.txt");
            var cogsPath = Path.Combine(directory, "cogs.txt");
            var colors = File.Exists(colorsPath)
                ? File.ReadAllLines(colorsPath).Where(color => !string.IsNullOrWhiteSpace(color)).ToArray()
                : [];
            var cogs = File.Exists(cogsPath) ? File.ReadAllText(cogsPath).Trim() : "";
            var designFile = Directory.GetFiles(directory)
                .Where(file => !IsMetadataFile(file))
                .OrderBy(file => file, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault();
            var details = colors.Length == 0 ? "No colors saved" : $"Colors: {string.Join(", ", colors)}";
            var label = Path.GetFileName(directory);
            var cogsValue = TryParseCogsValue(cogs);
            var cogsLabel = FormatCogsValue(cogsValue);

            yield return new StoredNonImageElementFolder(
                Path.GetFileName(typeDirectory),
                label,
                Path.GetRelativePath(typeDirectory, directory).Replace(Path.DirectorySeparatorChar, '/'),
                designFile is null ? "No design file" : Path.GetFileName(designFile),
                details,
                cogsLabel,
                cogsValue);
        }
    }

    private static IEnumerable<string> EnumerateCandidateElementDirectories(string directory)
    {
        foreach (var childDirectory in Directory.GetDirectories(directory))
        {
            if (File.Exists(Path.Combine(childDirectory, "cogs.txt")))
            {
                yield return childDirectory;
            }

            foreach (var nestedDirectory in EnumerateCandidateElementDirectories(childDirectory))
            {
                yield return nestedDirectory;
            }
        }
    }

    private static IEnumerable<string> EnumerateAssetDirectories(string directory)
    {
        var childDirectories = Directory.GetDirectories(directory)
            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var childAssetDirectories = childDirectories
            .SelectMany(EnumerateAssetDirectories)
            .ToList();
        var assetFiles = Directory.GetFiles(directory).Where(IsSupportedAssetFile).ToList();

        if (assetFiles.Count > 0 && childAssetDirectories.Count == 0)
        {
            yield return directory;
        }

        foreach (var childAssetDirectory in childAssetDirectories)
        {
            yield return childAssetDirectory;
        }
    }

    private static (string Label, decimal? Value) GetCogsMetadata(string filePath)
    {
        var current = new FileInfo(filePath).Directory;
        while (current is not null)
        {
            var cogsPath = Path.Combine(current.FullName, "cogs.txt");
            if (File.Exists(cogsPath))
            {
                var cogs = File.ReadAllText(cogsPath).Trim();
                var cogsValue = TryParseCogsValue(cogs);
                return cogsValue is null
                    ? ("COGS unset", null)
                    : (FormatCogsValue(cogsValue), cogsValue);
            }

            current = current.Parent;
        }

        return ("COGS unset", null);
    }

    private static decimal? TryParseCogsValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var normalized = value.Trim();

        if (normalized.StartsWith("COGS", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized[4..].TrimStart(':', '-', ' ').Trim();
        }

        normalized = normalized.Replace("$", string.Empty).Trim();

        if (decimal.TryParse(
                normalized,
                System.Globalization.NumberStyles.Number | System.Globalization.NumberStyles.AllowCurrencySymbol,
                System.Globalization.CultureInfo.CurrentCulture,
                out var parsedCurrentCulture))
        {
            return parsedCurrentCulture;
        }

        if (decimal.TryParse(
                normalized,
                System.Globalization.NumberStyles.Number | System.Globalization.NumberStyles.AllowCurrencySymbol,
                System.Globalization.CultureInfo.InvariantCulture,
                out var parsedInvariantCulture))
        {
            return parsedInvariantCulture;
        }

        return null;
    }

    private static string FormatCogsValue(decimal? value) =>
        value is null ? "COGS unset" : $"COGS {value.Value.ToString("C")}";

    private static string Slugify(string value)
    {
        var cleaned = new string(value
            .Trim()
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray());
        var parts = cleaned.Split('-', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length == 0 ? "uncategorized" : string.Join("-", parts);
    }

    private static string GetSafeFileName(string fileName)
    {
        var name = Path.GetFileName(fileName);
        foreach (var invalidCharacter in Path.GetInvalidFileNameChars())
        {
            name = name.Replace(invalidCharacter, '-');
        }

        return string.IsNullOrWhiteSpace(name) ? $"upload-{DateTimeOffset.UtcNow:yyyyMMddHHmmss}" : name;
    }

    private static string? NormalizeInput(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

