    private async Task UploadManufacturingFileForElementAsync(string sourceGroupKey, string relativePath, string elementLabel, string elementKey)
    {
        if (!CanUploadRowManufacturingFile(elementKey))
        {
            _manufacturingFileMessage = "Choose at least one stock/consumable input, output quantity per run, and the manufacturing file before uploading.";
            return;
        }

        var pendingFile = _rowPendingManufacturingFiles[elementKey];

        try
        {
            var processRoot = GetProcessFilesRoot();
            var normalizedRelativePath = NormalizeRelativePath(relativePath);
            var targetDirectory = Path.Combine(processRoot, sourceGroupKey, normalizedRelativePath);
            Directory.CreateDirectory(targetDirectory);

            var safeFileName = GetSafeFileName(pendingFile.Name);
            var targetPath = Path.Combine(targetDirectory, safeFileName);

            await using (var readStream = pendingFile.BrowserFile.OpenReadStream(MaxUploadSize))
            await using (var writeStream = File.Create(targetPath))
            {
                await readStream.CopyToAsync(writeStream);
            }

            var manufacturingElementKey = BuildManufacturingElementKey(sourceGroupKey, normalizedRelativePath);
            var existing = await DbContext.FinishedGoodsManufacturingFiles
                .FirstOrDefaultAsync(item => item.ElementKey == manufacturingElementKey);

            var inputDefinition = BuildRowInputDefinitionText(elementKey);
            var outputDefinition = BuildRowOutputDefinitionText(elementKey);

            if (existing is null)
            {
                existing = new FinishedGoodsManufacturingFileEntity
                {
                    ElementKey = manufacturingElementKey,
                    SourceGroupKey = sourceGroupKey,
                    ElementLabel = elementLabel,
                    StoredFileName = safeFileName,
                    RelativeFilePath = Path.GetRelativePath(Environment.WebRootPath, targetPath).Replace(Path.DirectorySeparatorChar, '/'),
                    InputDefinition = inputDefinition,
                    OutputDefinition = outputDefinition,
                    UploadedAt = DateTimeOffset.UtcNow,
                    UpdatedAt = DateTimeOffset.UtcNow,
                };

                DbContext.FinishedGoodsManufacturingFiles.Add(existing);
            }
            else
            {
                existing.SourceGroupKey = sourceGroupKey;
                existing.ElementLabel = elementLabel;
                existing.StoredFileName = safeFileName;
                existing.RelativeFilePath = Path.GetRelativePath(Environment.WebRootPath, targetPath).Replace(Path.DirectorySeparatorChar, '/');
                existing.InputDefinition = inputDefinition;
                existing.OutputDefinition = outputDefinition;
                existing.UpdatedAt = DateTimeOffset.UtcNow;
            }

            await DbContext.SaveChangesAsync();
            await LoadManufacturingFileLinksAsync();
            _manufacturingFileMessage = $"Uploaded manufacturing file for {elementLabel}.";

            _rowPendingManufacturingFiles.Remove(elementKey);
            _rowSelectedStockIds.Remove(elementKey);
            _rowSelectedStockAmounts.Remove(elementKey);
            _rowInputDefinitions.Remove(elementKey);
            _rowOutputPerRun.Remove(elementKey);
        }
        catch (Exception exception)
        {
            _manufacturingFileMessage = $"Manufacturing file upload failed for {elementLabel}. {exception.Message}";
        }
    }

