@page "/elements"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MustaineAI
@using MustaineAI.Components
@using MustaineAI.Components.Layout
@using MustaineAI.Data
@using MustaineAI.Services
@inject ApplicationDbContext DbContext
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS

<PageTitle>Elements</PageTitle>

<div class="elements-hero">
    <p class="elements-eyebrow">Stash</p>
    <h1 class="elements-title">Elements</h1>
    <p class="elements-subtitle">
        Turn raw materials and design files into reusable elements, then attach the inputs and output notes that finished goods will inherit.
    </p>
</div>

<section class="elements-card">
    <div class="elements-card-header">
        <h2>Element Flow Controls</h2>
        <span class="text-body-secondary">Ready for raw-material to element workflows</span>
    </div>
    <div class="elements-button-grid">
        <button class="btn btn-outline-primary" type="button">Rename</button>
        <button class="btn btn-outline-primary" type="button">Categorize</button>
        <button class="btn btn-outline-primary" type="button">Set Price</button>
        <button class="btn btn-outline-primary" type="button">Assign Tax</button>
        <button class="btn btn-outline-primary" type="button">Merge</button>
        <button class="btn btn-outline-primary" type="button">Archive</button>
    </div>

    <div class="elements-form mt-3">
        <div>
            <label class="form-label" for="bulk-cogs-section">Section</label>
            <InputSelect id="bulk-cogs-section" class="form-select" @bind-Value="_bulkCogsTargetKey">
                <option value="">Select a section</option>
                @foreach (var target in BulkCogsTargets)
                {
                    <option value="@target.Key">@target.DisplayName</option>
                }
            </InputSelect>
        </div>
        <div>
            <label class="form-label" for="bulk-cogs-value">COGS</label>
            <InputNumber id="bulk-cogs-value" class="form-control" @bind-Value="_bulkCogsValue" />
        </div>
        <div class="d-flex align-items-end">
            <button class="btn btn-primary" type="button" @onclick="ApplySectionCogsAsync" disabled="@(!CanApplyBulkCogs)">Apply to Section</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_bulkCogsTargetKey))
    {
        <div class="elements-status">This will update @BulkCogsTargetFolderCount folder(s).</div>
    }

    @if (!string.IsNullOrWhiteSpace(_bulkCogsMessage))
    {
        <div class="elements-status">@_bulkCogsMessage</div>
    }
</section>

<section class="elements-card mt-3">
    <div class="elements-card-header">
        <div>
            <h2>Element Type Manager</h2>
            <span class="text-body-secondary">Create types like spine-options, then add, replace, or delete files for any element type.</span>
        </div>
        <span class="elements-badge">@ElementTypeDirectories.Count type(s)</span>
    </div>

    <div class="elements-form">
        <div>
            <label class="form-label" for="new-element-type">New Element Type</label>
            <InputText id="new-element-type"
                       class="form-control"
                       @bind-Value="_newElementTypeName"
                       placeholder="spine-options" />
        </div>
        <div class="d-flex align-items-end">
            <button class="btn btn-primary" type="button" @onclick="CreateElementTypeAsync" disabled="@string.IsNullOrWhiteSpace(_newElementTypeName)">Create Type</button>
        </div>
        <div>
            <label class="form-label" for="element-type-picker">Manage Type</label>
            <InputSelect id="element-type-picker" class="form-select" @bind-Value="_selectedElementTypeKey">
                <option value="">Choose type</option>
                @foreach (var elementType in ElementTypeDirectories)
                {
                    <option value="@elementType.Key">@elementType.DisplayName (@elementType.FileCount file(s))</option>
                }
            </InputSelect>
        </div>
        <div class="d-flex align-items-end">
            <button class="btn btn-outline-danger" type="button" @onclick="DeleteSelectedElementTypeAsync" disabled="@string.IsNullOrWhiteSpace(_selectedElementTypeKey)">Delete Type</button>
        </div>
    </div>

    <div class="elements-form mt-3">
        <div>
            <label class="form-label" for="element-type-subfolder">Target Subfolder (optional)</label>
            <InputText id="element-type-subfolder"
                       class="form-control"
                       @bind-Value="_selectedElementTypeSubfolder"
                       placeholder="category-a/variation-1" />
        </div>
        <div>
            <label class="form-label" for="element-type-files">Files</label>
            <InputFile id="element-type-files" OnChange="HandleElementManagerFilesSelected" multiple class="form-control" />
        </div>
        <div class="d-flex align-items-end">
            <button class="btn btn-primary" type="button" @onclick="UploadElementManagerFilesAsync" disabled="@(!CanUploadElementManagerFiles)">Upload Files</button>
        </div>
    </div>

    <div class="elements-status">
        Uploading a file with the same name in the same folder replaces it, which is the quickest way to update element files.
    </div>

    @if (_pendingElementManagerFiles.Any())
    {
        <div class="elements-status">Selected @_pendingElementManagerFiles.Count file(s) for upload.</div>
    }

    @if (!string.IsNullOrWhiteSpace(_elementTypeManagerMessage))
    {
        <div class="elements-status">@_elementTypeManagerMessage</div>
    }

    @if (string.IsNullOrWhiteSpace(_selectedElementTypeKey))
    {
        <div class="elements-empty">Choose an element type to manage files.</div>
    }
    else if (!ManagedElementFiles.Any())
    {
        <div class="elements-empty">No files found for this type yet.</div>
    }
    else
    {
        <div class="elements-folder-list mt-2">
            @foreach (var fileEntry in ManagedElementFiles)
            {
                <article class="elements-folder-row">
                    <div>
                        <div class="elements-name">@fileEntry.RelativePath</div>
                        <div class="elements-meta">@FormatFileSize(fileEntry.SizeBytes) • Updated @fileEntry.LastModifiedLocal.ToString("g")</div>
                    </div>
                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick='() => DeleteManagedElementFileAsync(fileEntry.RelativePath)'>Delete</button>
                </article>
            }
        </div>
    }
</section>

<section class="elements-card mt-3">
    <div class="elements-card-header">
        <div>
            <h2>Manufacturing File Intake</h2>
            <span class="text-body-secondary">Upload a manufacturing file, define inputs/outputs, force-link in DB, and place it in the correct process-files folder.</span>
        </div>
        <InputFile OnChange="HandleManufacturingFileSelected" class="form-control elements-upload" />
    </div>

    <div class="elements-form">
        <div>
            <label class="form-label" for="manufacturing-group">Top-Level Category</label>
            <InputSelect id="manufacturing-group" class="form-select" @bind-Value="_manufacturingSourceGroupKey">
                <option value="">Choose category</option>
                @foreach (var group in ManufacturingTargetGroups)
                {
                    <option value="@group.Key">@group.DisplayName</option>
                }
            </InputSelect>
        </div>
        <div>
            <label class="form-label" for="manufacturing-element-name">Element Name</label>
            <InputText id="manufacturing-element-name" class="form-control" @bind-Value="_manufacturingElementName" placeholder="front-panel-deluxe-black" />
        </div>
        <div>
            <label class="form-label" for="manufacturing-inputs">Inputs Definition</label>
            <InputText id="manufacturing-inputs" class="form-control" @bind-Value="_manufacturingInputsDefinition" placeholder="material type, thickness, machine profile" />
        </div>
        <div>
            <label class="form-label" for="manufacturing-outputs">Outputs Definition</label>
            <InputText id="manufacturing-outputs" class="form-control" @bind-Value="_manufacturingOutputsDefinition" placeholder="gcode path, cut map, final part" />
        </div>
        <div class="elements-actions">
            <button class="btn btn-primary" type="button" @onclick="UploadAndForceLinkManufacturingFileAsync" disabled="@(!CanForceLinkManufacturingFile)">
                @(_isUploadingManufacturingFile ? "Uploading..." : "Upload + Force Link")
            </button>
        </div>
    </div>

    @if (_pendingManufacturingFile is not null)
    {
        <div class="elements-status">Selected file: @_pendingManufacturingFile.Name (@FormatFileSize(_pendingManufacturingFile.Size)).</div>
    }

    @if (!string.IsNullOrWhiteSpace(_manufacturingFileMessage))
    {
        <div class="elements-status">@_manufacturingFileMessage</div>
    }

    <div class="elements-card-header mt-3">
        <h2>Linked Manufacturing Files</h2>
        <span class="text-body-secondary">@ManufacturingFileLinks.Count link(s)</span>
    </div>

    @if (!ManufacturingFileLinks.Any())
    {
        <div class="elements-empty">No manufacturing files linked yet.</div>
    }
    else
    {
        <div class="elements-folder-list">
            @foreach (var link in ManufacturingFileLinks)
            {
                <article class="elements-folder-row">
                    <div>
                        <div class="elements-name">@link.ElementLabel</div>
                        <div class="elements-meta">@link.SourceGroupKey / @link.StoredFileName</div>
                        <div class="elements-meta">Inputs: @link.InputDefinition</div>
                        <div class="elements-meta">Outputs: @link.OutputDefinition</div>
                    </div>
                    <span class="elements-badge">@link.RelativeFilePath</span>
                </article>
            }
        </div>
    }
</section>

<section class="elements-card">
    <div class="elements-card-header">
        <div>
            <h2>Image Process Files</h2>
            <span class="text-body-secondary">Stored under process-files/front-faces/category with their original file names</span>
        </div>
        <InputFile OnChange="HandleFilesSelectedAsync" multiple class="form-control elements-upload" />
    </div>

    <div class="elements-form">
        <div>
            <label class="form-label" for="element-category">Category</label>
            <InputText id="element-category" class="form-control" @bind-Value="_categoryName" placeholder="Animals, Fantasy, IP" />
        </div>
        <div>
            <label class="form-label" for="image-element-cogs">COGS</label>
            <InputNumber id="image-element-cogs" class="form-control" @bind-Value="_imageElementCogs" />
        </div>
        </div>

    <div class="elements-status">
        Upload one or more files such as PDFs, images, or NC files. They will all stay in the same folder.
    </div>

    @if (!string.IsNullOrWhiteSpace(_uploadMessage))
    {
        <div class="elements-status">@_uploadMessage</div>
    }
</section>

<div class="elements-grid">
    <section class="elements-card">
        <div class="elements-card-header">
            <h2>Front-Faces Schema</h2>
            <span class="text-body-secondary">@FrontFacesSchema.Count schema row(s)</span>
        </div>

        <div class="elements-form mt-3">
            <div>
                <label class="form-label" for="elements-search">Search Elements</label>
                <InputText id="elements-search" class="form-control" @bind-Value="_elementsSearchTerm" placeholder="Search names, folders, details" />
            </div>
            <div class="d-flex align-items-end">
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearElementsSearch" disabled="@string.IsNullOrWhiteSpace(_elementsSearchTerm)">Clear</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_elementsSearchMessage))
        {
            <div class="elements-status">@_elementsSearchMessage</div>
        }

        @if (!FrontFacesSchema.Any())
        {
            <div class="elements-empty">
                No front-faces assets found yet.
            </div>
        }
        else if (!FilteredFrontFacesSchema.Any())
        {
            <div class="elements-empty">
                No front-faces rows match your search.
            </div>
        }
        else
        {
            <div class="elements-folder-list">
                @foreach (var entry in FilteredFrontFacesSchema)
                {
                    var pinKey = GetFrontFacePinKey(entry);
                    var manufacturingElementKey = GetFrontFaceManufacturingElementKey(entry);
                    var hasManufacturingFile = HasManufacturingFileLink(manufacturingElementKey);

                    <article class="elements-folder-row">
                        <div>
                            <div class="elements-name">@entry.SchemaPath</div>
                            <div class="elements-meta">front-faces / @entry.SchemaPath</div>
                            <div class="elements-meta">Square Reporting Category: @entry.ReportingCategory</div>
                            <div class="elements-meta">@entry.FilesLabel</div>
                            @if (hasManufacturingFile)
                            {
                                <div class="elements-meta"><span class="elements-badge">Manufacturing file linked</span></div>
                            }
                            else
                            {
                                <div class="elements-meta">Define stock/consumable inputs and output per run, then upload.</div>
                                <div class="elements-form mt-2">
                                    <div>
                                        <label class="form-label">Input Stock/Consumable</label>
                                        <select class="form-select form-select-sm" value="@GetRowSelectedStockId(manufacturingElementKey)" @onchange='eventArgs => SetRowSelectedStockId(manufacturingElementKey, eventArgs.Value?.ToString())'>
                                            <option value="">Choose stock/consumable</option>
                                            @foreach (var stockOption in StockConsumableOptions)
                                            {
                                                <option value="@stockOption.Key">@stockOption.Name (@stockOption.Type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label">Input Qty Per Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               value="@GetRowSelectedStockAmountText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowSelectedStockAmount(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick='() => AddRowInputDefinition(manufacturingElementKey)' disabled="@(!CanAddRowInputDefinition(manufacturingElementKey))">Add Input</button>
                                    </div>
                                    <div>
                                        <label class="form-label">Output Qty Per File Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="1"
                                               value="@GetRowOutputPerRunText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowOutputPerRun(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div>
                                        <label class="form-label">Manufacturing File</label>
                                        <InputFile OnChange='eventArgs => HandleRowManufacturingFileSelected(manufacturingElementKey, eventArgs)'
                                                   class="form-control form-control-sm" />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-primary" type="button" @onclick='() => UploadManufacturingFileForElementAsync("front-faces", entry.RelativePath, entry.SchemaPath, manufacturingElementKey)' disabled="@(!CanUploadRowManufacturingFile(manufacturingElementKey))">Upload + Link</button>
                                    </div>
                                </div>

                                @if (GetRowInputDefinitions(manufacturingElementKey).Any())
                                {
                                    <div class="elements-folder-list mt-2">
                                        @foreach (var inputDefinition in GetRowInputDefinitions(manufacturingElementKey))
                                        {
                                            <article class="elements-folder-row">
                                                <div>
                                                    <div class="elements-name">@inputDefinition.StockName</div>
                                                    <div class="elements-meta">@inputDefinition.QuantityPerRun.ToString("0.##") per run</div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick='() => RemoveRowInputDefinition(manufacturingElementKey, inputDefinition.StockKey)'>Remove</button>
                                            </article>
                                        }
                                    </div>
                                }

                                @if (TryGetRowPendingFileName(manufacturingElementKey, out var pendingFrontFaceFileName))
                                {
                                    <div class="elements-meta mt-2">Selected file: @pendingFrontFaceFileName</div>
                                }
                            }
                        </div>
                        <div class="elements-folder-badges">
                            <button class="btn btn-sm @(IsPinned(pinKey) ? "btn-primary" : "btn-outline-secondary")" type="button" @onclick='() => TogglePinnedElementAsync(pinKey, entry.SchemaPath, "Front Faces")' disabled="@_isSavingPin">
                                @(IsPinned(pinKey) ? "Pinned" : "Pin")
                            </button>
                            <span class="elements-badge">@entry.FileCount file(s)</span>
                            <span class="elements-badge">@FormatCogsValue(entry.CogsValue)</span>
                        </div>
                    </article>
                }
            </div>
        }

        <div class="elements-card-header mt-3">
            <h2>Back Elements</h2>
            <span class="text-body-secondary">@FilteredStandardBackOptions.Count option(s)</span>
        </div>

        @if (!BackOptions.Any())
        {
            <div class="elements-empty">
                No files found under back-options.
            </div>
        }
        else if (!FilteredStandardBackOptions.Any())
        {
            <div class="elements-empty">
                No back elements match your search.
            </div>
        }
        else
        {
            <div class="elements-folder-list">
                @foreach (var option in FilteredStandardBackOptions)
                {
                    var pinKey = GetBackOptionPinKey(option);
                    var manufacturingElementKey = GetBackOptionManufacturingElementKey(option);
                    var hasManufacturingFile = HasManufacturingFileLink(manufacturingElementKey);

                    <article class="elements-folder-row">
                        <div>
                            <div class="elements-name">@option.Name</div>
                            <div class="elements-meta">back-options / @option.Name</div>
                            <div class="elements-meta">@option.FilesLabel</div>
                            @if (hasManufacturingFile)
                            {
                                <div class="elements-meta"><span class="elements-badge">Manufacturing file linked</span></div>
                            }
                            else
                            {
                                <div class="elements-meta">Define stock/consumable inputs and output per run, then upload.</div>
                                <div class="elements-form mt-2">
                                    <div>
                                        <label class="form-label">Input Stock/Consumable</label>
                                        <select class="form-select form-select-sm" value="@GetRowSelectedStockId(manufacturingElementKey)" @onchange='eventArgs => SetRowSelectedStockId(manufacturingElementKey, eventArgs.Value?.ToString())'>
                                            <option value="">Choose stock/consumable</option>
                                            @foreach (var stockOption in StockConsumableOptions)
                                            {
                                                <option value="@stockOption.Key">@stockOption.Name (@stockOption.Type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label">Input Qty Per Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               value="@GetRowSelectedStockAmountText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowSelectedStockAmount(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick='() => AddRowInputDefinition(manufacturingElementKey)' disabled="@(!CanAddRowInputDefinition(manufacturingElementKey))">Add Input</button>
                                    </div>
                                    <div>
                                        <label class="form-label">Output Qty Per File Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="1"
                                               value="@GetRowOutputPerRunText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowOutputPerRun(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div>
                                        <label class="form-label">Manufacturing File</label>
                                        <InputFile OnChange='eventArgs => HandleRowManufacturingFileSelected(manufacturingElementKey, eventArgs)'
                                                   class="form-control form-control-sm" />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-primary" type="button" @onclick='() => UploadManufacturingFileForElementAsync("back-options", option.RelativePath, option.Name, manufacturingElementKey)' disabled="@(!CanUploadRowManufacturingFile(manufacturingElementKey))">Upload + Link</button>
                                    </div>
                                </div>

                                @if (GetRowInputDefinitions(manufacturingElementKey).Any())
                                {
                                    <div class="elements-folder-list mt-2">
                                        @foreach (var inputDefinition in GetRowInputDefinitions(manufacturingElementKey))
                                        {
                                            <article class="elements-folder-row">
                                                <div>
                                                    <div class="elements-name">@inputDefinition.StockName</div>
                                                    <div class="elements-meta">@inputDefinition.QuantityPerRun.ToString("0.##") per run</div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick='() => RemoveRowInputDefinition(manufacturingElementKey, inputDefinition.StockKey)'>Remove</button>
                                            </article>
                                        }
                                    </div>
                                }

                                @if (TryGetRowPendingFileName(manufacturingElementKey, out var pendingBackOptionFileName))
                                {
                                    <div class="elements-meta mt-2">Selected file: @pendingBackOptionFileName</div>
                                }
                            }
                        </div>
                        <div class="elements-folder-badges">
                            <button class="btn btn-sm @(IsPinned(pinKey) ? "btn-primary" : "btn-outline-secondary")" type="button" @onclick='() => TogglePinnedElementAsync(pinKey, option.Name, "Back Options")' disabled="@_isSavingPin">
                                @(IsPinned(pinKey) ? "Pinned" : "Pin")
                            </button>
                            <span class="elements-badge">@FormatCogsValue(option.CogsValue)</span>
                        </div>
                    </article>
                }
            </div>
        }

        <div class="elements-card-header mt-3">
            <h2>Premium Back Elements</h2>
            <span class="text-body-secondary">@FilteredPremiumBackOptions.Count option(s)</span>
        </div>

        @if (!BackOptions.Any())
        {
            <div class="elements-empty">
                No files found under back-options.
            </div>
        }
        else if (!FilteredPremiumBackOptions.Any())
        {
            <div class="elements-empty">
                No premium back elements match your search.
            </div>
        }
        else
        {
            <div class="elements-folder-list">
                @foreach (var option in FilteredPremiumBackOptions)
                {
                    var pinKey = GetBackOptionPinKey(option);
                    var manufacturingElementKey = GetBackOptionManufacturingElementKey(option);
                    var hasManufacturingFile = HasManufacturingFileLink(manufacturingElementKey);

                    <article class="elements-folder-row">
                        <div>
                            <div class="elements-name">@option.Name</div>
                            <div class="elements-meta">back-options / @option.Name</div>
                            <div class="elements-meta">@option.FilesLabel</div>
                            @if (hasManufacturingFile)
                            {
                                <div class="elements-meta"><span class="elements-badge">Manufacturing file linked</span></div>
                            }
                            else
                            {
                                <div class="elements-meta">Define stock/consumable inputs and output per run, then upload.</div>
                                <div class="elements-form mt-2">
                                    <div>
                                        <label class="form-label">Input Stock/Consumable</label>
                                        <select class="form-select form-select-sm" value="@GetRowSelectedStockId(manufacturingElementKey)" @onchange='eventArgs => SetRowSelectedStockId(manufacturingElementKey, eventArgs.Value?.ToString())'>
                                            <option value="">Choose stock/consumable</option>
                                            @foreach (var stockOption in StockConsumableOptions)
                                            {
                                                <option value="@stockOption.Key">@stockOption.Name (@stockOption.Type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label">Input Qty Per Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               value="@GetRowSelectedStockAmountText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowSelectedStockAmount(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick='() => AddRowInputDefinition(manufacturingElementKey)' disabled="@(!CanAddRowInputDefinition(manufacturingElementKey))">Add Input</button>
                                    </div>
                                    <div>
                                        <label class="form-label">Output Qty Per File Run</label>
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="0"
                                               step="1"
                                               value="@GetRowOutputPerRunText(manufacturingElementKey)"
                                               @oninput='eventArgs => SetRowOutputPerRun(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                    </div>
                                    <div>
                                        <label class="form-label">Manufacturing File</label>
                                        <InputFile OnChange='eventArgs => HandleRowManufacturingFileSelected(manufacturingElementKey, eventArgs)'
                                                   class="form-control form-control-sm" />
                                    </div>
                                    <div class="d-flex align-items-end">
                                        <button class="btn btn-sm btn-primary" type="button" @onclick='() => UploadManufacturingFileForElementAsync("back-options", option.RelativePath, option.Name, manufacturingElementKey)' disabled="@(!CanUploadRowManufacturingFile(manufacturingElementKey))">Upload + Link</button>
                                    </div>
                                </div>

                                @if (GetRowInputDefinitions(manufacturingElementKey).Any())
                                {
                                    <div class="elements-folder-list mt-2">
                                        @foreach (var inputDefinition in GetRowInputDefinitions(manufacturingElementKey))
                                        {
                                            <article class="elements-folder-row">
                                                <div>
                                                    <div class="elements-name">@inputDefinition.StockName</div>
                                                    <div class="elements-meta">@inputDefinition.QuantityPerRun.ToString("0.##") per run</div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick='() => RemoveRowInputDefinition(manufacturingElementKey, inputDefinition.StockKey)'>Remove</button>
                                            </article>
                                        }
                                    </div>
                                }

                                @if (TryGetRowPendingFileName(manufacturingElementKey, out var pendingBackOptionFileName))
                                {
                                    <div class="elements-meta mt-2">Selected file: @pendingBackOptionFileName</div>
                                }
                            }
                        </div>
                        <div class="elements-folder-badges">
                            <button class="btn btn-sm @(IsPinned(pinKey) ? "btn-primary" : "btn-outline-secondary")" type="button" @onclick='() => TogglePinnedElementAsync(pinKey, option.Name, "Back Options")' disabled="@_isSavingPin">
                                @(IsPinned(pinKey) ? "Pinned" : "Pin")
                            </button>
                            <span class="elements-badge">@FormatCogsValue(option.CogsValue)</span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<section class="elements-card mt-3">
    <div class="elements-card-header">
        <div>
            <h2>Non-Image Elements</h2>
            <span class="text-body-secondary">Leather, back, and back with middle design files</span>
        </div>
        <InputFile OnChange="HandleNonImageDesignSelected" class="form-control elements-upload" />
    </div>

    <div class="elements-form">
        <div>
            <label class="form-label" for="non-image-type">Element Type</label>
            <InputText id="non-image-type" class="form-control" @bind-Value="_nonImageElementType" placeholder="Leather, Back, Back with Middle" />
        </div>
        @if (string.Equals(_nonImageElementType, "Leather", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_nonImageElementType, "Leather Base", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_nonImageElementType, "Leather Premium", StringComparison.OrdinalIgnoreCase))
        {
            <div>
                <label class="form-label" for="non-image-leather-tier">Leather Tier</label>
                <InputSelect id="non-image-leather-tier" class="form-select" @bind-Value="_leatherTier">
                    <option value="Base">Base</option>
                    <option value="Premium">Premium</option>
                </InputSelect>
            </div>
        }
        <div>
            <label class="form-label" for="non-image-name">Name</label>
            <InputText id="non-image-name" class="form-control" @bind-Value="_nonImageName" placeholder="premium-grain" />
        </div>
        <div>
            <label class="form-label" for="non-image-cogs">COGS</label>
            <InputNumber id="non-image-cogs" class="form-control" @bind-Value="_nonImageCogs" />
        </div>
        <div>
            <label class="form-label" for="non-image-colors">Color Options</label>
            <InputText id="non-image-colors" class="form-control" @bind-Value="_nonImageColors" placeholder="black, brown, oxblood" disabled="@(!UsesColorOptions)" />
        </div>
    </div>

    <div class="elements-actions">
        <button class="btn btn-primary" type="button" @onclick="SaveNonImageElementAsync" disabled="@(!CanSaveNonImageElement)">Save Element</button>
        <button class="btn btn-outline-danger" type="button" @onclick="ClearNonImageElement" disabled="@(NonImageDesignFile is null && string.IsNullOrWhiteSpace(_nonImageName) && string.IsNullOrWhiteSpace(_nonImageColors) && _nonImageCogs is null)">Clear</button>
    </div>

    @if (NonImageDesignFile is not null)
    {
        <div class="elements-status">
            Selected @NonImageDesignFile.Name (@FormatFileSize(NonImageDesignFile.Size)).
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_nonImageMessage))
    {
        <div class="elements-status">@_nonImageMessage</div>
    }
</section>

<section class="elements-card mt-3">
    <div class="elements-card-header">
        <h2>Stored Non-Image Elements</h2>
        <span class="text-body-secondary">@StoredNonImageElements.Count folder(s)</span>
    </div>

    @if (!StoredNonImageElements.Any())
    {
        <div class="elements-empty">
            No non-image design files stored yet.
        </div>
    }
    else if (!FilteredStoredNonImageElements.Any())
    {
        <div class="elements-empty">
            No non-image elements match your search.
        </div>
    }
    else
    {
        <div class="elements-folder-list">
            @foreach (var element in FilteredStoredNonImageElements)
            {
                var pinKey = GetStoredElementPinKey(element);
                var manufacturingElementKey = GetStoredElementManufacturingElementKey(element);
                var hasManufacturingFile = HasManufacturingFileLink(manufacturingElementKey);

                <article class="elements-folder-row">
                    <div>
                        <div class="elements-name">@element.Name</div>
                        <div class="elements-meta">@element.ElementType / @element.DesignFileName</div>
                        <div class="elements-meta">@element.Details</div>
                        @if (hasManufacturingFile)
                        {
                            <div class="elements-meta"><span class="elements-badge">Manufacturing file linked</span></div>
                        }
                        else
                        {
                            <div class="elements-meta">Define stock/consumable inputs and output per run, then upload.</div>
                            <div class="elements-form mt-2">
                                <div>
                                    <label class="form-label">Input Stock/Consumable</label>
                                    <select class="form-select form-select-sm" value="@GetRowSelectedStockId(manufacturingElementKey)" @onchange='eventArgs => SetRowSelectedStockId(manufacturingElementKey, eventArgs.Value?.ToString())'>
                                        <option value="">Choose stock/consumable</option>
                                        @foreach (var stockOption in StockConsumableOptions)
                                        {
                                            <option value="@stockOption.Key">@stockOption.Name (@stockOption.Type)</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Input Qty Per Run</label>
                                    <input class="form-control form-control-sm"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           value="@GetRowSelectedStockAmountText(manufacturingElementKey)"
                                           @oninput='eventArgs => SetRowSelectedStockAmount(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                </div>
                                <div class="d-flex align-items-end">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick='() => AddRowInputDefinition(manufacturingElementKey)' disabled="@(!CanAddRowInputDefinition(manufacturingElementKey))">Add Input</button>
                                </div>
                                <div>
                                    <label class="form-label">Output Qty Per File Run</label>
                                    <input class="form-control form-control-sm"
                                           type="number"
                                           min="0"
                                           step="1"
                                           value="@GetRowOutputPerRunText(manufacturingElementKey)"
                                           @oninput='eventArgs => SetRowOutputPerRun(manufacturingElementKey, eventArgs.Value?.ToString())' />
                                </div>
                                <div>
                                    <label class="form-label">Manufacturing File</label>
                                    <InputFile OnChange='eventArgs => HandleRowManufacturingFileSelected(manufacturingElementKey, eventArgs)'
                                               class="form-control form-control-sm" />
                                </div>
                                <div class="d-flex align-items-end">
                                    <button class="btn btn-sm btn-primary" type="button" @onclick='() => UploadManufacturingFileForElementAsync(element.ElementType, element.RelativePath, element.Name, manufacturingElementKey)' disabled="@(!CanUploadRowManufacturingFile(manufacturingElementKey))">Upload + Link</button>
                                </div>
                            </div>

                            @if (GetRowInputDefinitions(manufacturingElementKey).Any())
                            {
                                <div class="elements-folder-list mt-2">
                                    @foreach (var inputDefinition in GetRowInputDefinitions(manufacturingElementKey))
                                    {
                                        <article class="elements-folder-row">
                                            <div>
                                                <div class="elements-name">@inputDefinition.StockName</div>
                                                <div class="elements-meta">@inputDefinition.QuantityPerRun.ToString("0.##") per run</div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick='() => RemoveRowInputDefinition(manufacturingElementKey, inputDefinition.StockKey)'>Remove</button>
                                        </article>
                                    }
                                </div>
                            }

                            @if (TryGetRowPendingFileName(manufacturingElementKey, out var pendingNonImageFileName))
                            {
                                <div class="elements-meta mt-2">Selected file: @pendingNonImageFileName</div>
                            }
                        }
                    </div>
                    <div class="elements-folder-badges">
                        <button class="btn btn-sm @(IsPinned(pinKey) ? "btn-primary" : "btn-outline-secondary")" type="button" @onclick="() => TogglePinnedElementAsync(pinKey, element.Name, element.ElementType)" disabled="@_isSavingPin">
                            @(IsPinned(pinKey) ? "Pinned" : "Pin")
                        </button>
                        <span class="elements-badge">@FormatCogsValue(element.CogsValue)</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private const long MaxUploadSize = 100 * 1024 * 1024;
    private string? _categoryName;
    private decimal? _imageElementCogs;
    private string? _uploadMessage;
    private string? _bulkCogsTargetKey;
    private decimal? _bulkCogsValue;
    private string? _bulkCogsMessage;
    private string? _nonImageElementType = "Leather";
    private string _leatherTier = "Base";
    private string? _nonImageName;
    private string? _nonImageColors;
    private decimal? _nonImageCogs;
    private string? _nonImageMessage;
    private string? _elementsSearchTerm;
    private string? _elementsSearchMessage;
    private string? _newElementTypeName;
    private string? _selectedElementTypeKey;
    private string? _selectedElementTypeSubfolder;
    private string? _elementTypeManagerMessage;
    private bool _isSavingPin;
    private bool _isUploadingManufacturingFile;
    private string? _manufacturingSourceGroupKey;
    private string? _manufacturingElementName;
    private string? _manufacturingInputsDefinition;
    private string? _manufacturingOutputsDefinition;
    private string? _manufacturingFileMessage;
    private UploadedElementFile? NonImageDesignFile;
    private UploadedElementFile? _pendingManufacturingFile;
    private IReadOnlyList<UploadedElementFile> _pendingElementManagerFiles = [];
    private IReadOnlyList<SectionCogsTarget> BulkCogsTargets = [];
    private IReadOnlyList<FrontFacesSchemaEntry> FrontFacesSchema = [];
    private IReadOnlyList<BackOptionAsset> BackOptions = [];
    private IReadOnlyList<StoredNonImageElementFolder> StoredNonImageElements = [];
    private IReadOnlyList<ElementTypeDirectory> ElementTypeDirectories = [];
    private IReadOnlyList<ElementTypeFileEntry> ManagedElementFiles = [];
    private IReadOnlyList<ManufacturingTargetGroup> ManufacturingTargetGroups = [];
    private IReadOnlyList<ManufacturingFileLinkRow> ManufacturingFileLinks = [];
    private IReadOnlyList<StockConsumableOption> StockConsumableOptions = [];
    private HashSet<string> _pinnedElementKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _rowSelectedStockIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, decimal?> _rowSelectedStockAmounts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<RowInputDefinition>> _rowInputDefinitions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, decimal?> _rowOutputPerRun = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, UploadedElementFile> _rowPendingManufacturingFiles = new(StringComparer.OrdinalIgnoreCase);

    private bool UsesColorOptions =>
        string.Equals(_nonImageElementType, "Leather", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_nonImageElementType, "Leather Base", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_nonImageElementType, "Leather Premium", StringComparison.OrdinalIgnoreCase);

    private int BulkCogsTargetFolderCount
    {
        get
        {
            var target = BulkCogsTargets.FirstOrDefault(item =>
                string.Equals(item.Key, _bulkCogsTargetKey, StringComparison.Ordinal));

            if (target is null || !Directory.Exists(target.DirectoryPath))
            {
                return 0;
            }

            return ResolveBulkCogsDirectories(target).Count;
        }
    }

    private bool CanApplyBulkCogs =>
        !string.IsNullOrWhiteSpace(_bulkCogsTargetKey) &&
        _bulkCogsValue is not null &&
        BulkCogsTargetFolderCount > 0;

    private bool CanSaveNonImageElement =>
        NonImageDesignFile is not null &&
        !string.IsNullOrWhiteSpace(_nonImageElementType) &&
        !string.IsNullOrWhiteSpace(_nonImageName) &&
        _nonImageCogs is not null &&
        (!UsesColorOptions || !string.IsNullOrWhiteSpace(_nonImageColors));

    private bool CanForceLinkManufacturingFile =>
        !_isUploadingManufacturingFile &&
        _pendingManufacturingFile is not null &&
        !string.IsNullOrWhiteSpace(_manufacturingSourceGroupKey) &&
        !string.IsNullOrWhiteSpace(_manufacturingElementName);

    private bool CanUploadElementManagerFiles =>
        _pendingElementManagerFiles.Count > 0 &&
        !string.IsNullOrWhiteSpace(_selectedElementTypeKey);

    private IReadOnlyList<FrontFacesSchemaEntry> FilteredFrontFacesSchema =>
        FrontFacesSchema
            .Where(entry => MatchesSearch(entry.SchemaPath, entry.ReportingCategory, entry.FilesLabel, entry.CogsLabel))
            .OrderByDescending(entry => IsPinned(GetFrontFacePinKey(entry)))
            .ThenBy(entry => entry.SchemaPath, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<BackOptionAsset> FilteredBackOptions =>
        BackOptions
            .Where(option => MatchesSearch(option.Name, option.FilesLabel, option.CogsLabel))
            .OrderByDescending(option => IsPinned(GetBackOptionPinKey(option)))
            .ThenBy(option => option.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<BackOptionAsset> FilteredStandardBackOptions =>
        FilteredBackOptions
            .Where(option => string.Equals(option.OptionFamily, "Back", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<BackOptionAsset> FilteredPremiumBackOptions =>
        FilteredBackOptions
            .Where(option => string.Equals(option.OptionFamily, "Premium Back", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<StoredNonImageElementFolder> FilteredStoredNonImageElements =>
        StoredNonImageElements
            .Where(element => MatchesSearch(element.ElementType, element.Name, element.DesignFileName, element.Details, element.CogsLabel))
            .OrderByDescending(element => IsPinned(GetStoredElementPinKey(element)))
            .ThenBy(element => element.ElementType, StringComparer.OrdinalIgnoreCase)
            .ThenBy(element => element.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private HashSet<string> ManufacturingFileElementKeys =>
        ManufacturingFileLinks
            .Select(link => link.ElementKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LoadBulkCogsTargets();
            LoadFrontFacesSchema();
            LoadBackOptions();
            LoadStoredNonImageElements();
            LoadManufacturingTargetGroups();
            LoadElementTypeDirectories();
            LoadManagedElementFiles();

            await LoadStockConsumableOptionsAsync();
            await LoadManufacturingFileLinksAsync();
            await LoadPinnedElementsAsync();
        }
        catch (Exception exception)
        {
            _elementsSearchMessage = $"Elements could not be loaded right now. {exception.Message}";
        }
    }

    private void HandleElementManagerFilesSelected(InputFileChangeEventArgs args)
    {
        _pendingElementManagerFiles = args.GetMultipleFiles()
            .Select(file => new UploadedElementFile(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "Unknown" : file.ContentType,
                file.Size,
                DateTimeOffset.UtcNow,
                file))
            .ToList();

        _elementTypeManagerMessage = null;
    }

    private async Task CreateElementTypeAsync()
    {
        _elementTypeManagerMessage = null;

        if (string.IsNullOrWhiteSpace(_newElementTypeName))
        {
            _elementTypeManagerMessage = "Enter an element type name first.";
            return;
        }

        var processRoot = GetProcessFilesRoot();
        Directory.CreateDirectory(processRoot);

        var typeSlug = Slugify(_newElementTypeName);
        var typePath = Path.Combine(processRoot, typeSlug);

        if (Directory.Exists(typePath))
        {
            _elementTypeManagerMessage = $"Element type {typeSlug} already exists.";
            _selectedElementTypeKey = typeSlug;
            LoadElementTypeDirectories();
            LoadManagedElementFiles();
            return;
        }

        Directory.CreateDirectory(typePath);
        _selectedElementTypeKey = typeSlug;
        _newElementTypeName = null;
        _elementTypeManagerMessage = $"Created process-files/{typeSlug}.";
        RefreshElementViews();

        await Task.CompletedTask;
    }

    private async Task DeleteSelectedElementTypeAsync()
    {
        _elementTypeManagerMessage = null;

        if (string.IsNullOrWhiteSpace(_selectedElementTypeKey))
        {
            _elementTypeManagerMessage = "Choose an element type first.";
            return;
        }

        var typeKey = _selectedElementTypeKey.Trim();
        var processRoot = GetProcessFilesRoot();
        var typePath = Path.Combine(processRoot, typeKey);

        if (!Directory.Exists(typePath))
        {
            _elementTypeManagerMessage = "That element type folder no longer exists.";
            RefreshElementViews();
            return;
        }

        var shouldDelete = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete process-files/{typeKey} and all files inside it? This cannot be undone.");

        if (!shouldDelete)
        {
            _elementTypeManagerMessage = "Delete canceled.";
            return;
        }

        Directory.Delete(typePath, true);

        var linkedFiles = await DbContext.FinishedGoodsManufacturingFiles
            .Where(item => item.SourceGroupKey == typeKey
                || EF.Functions.ILike(item.ElementKey, $"{typeKey}/%"))
            .ToListAsync();

        if (linkedFiles.Count > 0)
        {
            DbContext.FinishedGoodsManufacturingFiles.RemoveRange(linkedFiles);
            await DbContext.SaveChangesAsync();
            await LoadManufacturingFileLinksAsync();
        }

        _selectedElementTypeKey = null;
        _selectedElementTypeSubfolder = null;
        _pendingElementManagerFiles = [];
        _elementTypeManagerMessage = $"Deleted process-files/{typeKey}.";
        RefreshElementViews();
    }

    private async Task UploadElementManagerFilesAsync()
    {
        _elementTypeManagerMessage = null;

        if (!CanUploadElementManagerFiles || string.IsNullOrWhiteSpace(_selectedElementTypeKey))
        {
            _elementTypeManagerMessage = "Choose a type and one or more files first.";
            return;
        }

        var selectedTypeDirectory = GetSelectedElementTypeDirectory();
        if (selectedTypeDirectory is null)
        {
            _elementTypeManagerMessage = "Selected element type is no longer available.";
            RefreshElementViews();
            return;
        }

        var targetDirectory = selectedTypeDirectory.DirectoryPath;
        var normalizedSubfolder = NormalizeRelativePath(_selectedElementTypeSubfolder ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(normalizedSubfolder))
        {
            targetDirectory = Path.Combine(targetDirectory, normalizedSubfolder.Replace('/', Path.DirectorySeparatorChar));
        }

        Directory.CreateDirectory(targetDirectory);

        foreach (var file in _pendingElementManagerFiles)
        {
            var safeFileName = GetSafeFileName(file.Name);
            var targetPath = Path.Combine(targetDirectory, safeFileName);

            await using var readStream = file.BrowserFile.OpenReadStream(MaxUploadSize);
            await using var writeStream = File.Create(targetPath);
            await readStream.CopyToAsync(writeStream);
        }

        _elementTypeManagerMessage = $"Uploaded {_pendingElementManagerFiles.Count} file(s) to process-files/{_selectedElementTypeKey}/{normalizedSubfolder}.".TrimEnd('/');
        _pendingElementManagerFiles = [];
        RefreshElementViews();
    }

    private async Task DeleteManagedElementFileAsync(string relativePath)
    {
        _elementTypeManagerMessage = null;

        var selectedTypeDirectory = GetSelectedElementTypeDirectory();
        if (selectedTypeDirectory is null)
        {
            _elementTypeManagerMessage = "Choose a valid element type first.";
            return;
        }

        var normalizedRelativePath = NormalizeRelativePath(relativePath);
        var absolutePath = Path.GetFullPath(Path.Combine(selectedTypeDirectory.DirectoryPath, normalizedRelativePath.Replace('/', Path.DirectorySeparatorChar)));
        var expectedRoot = Path.GetFullPath(selectedTypeDirectory.DirectoryPath) + Path.DirectorySeparatorChar;

        if (!absolutePath.StartsWith(expectedRoot, StringComparison.OrdinalIgnoreCase) || !File.Exists(absolutePath))
        {
            _elementTypeManagerMessage = "That file could not be found.";
            LoadManagedElementFiles();
            return;
        }

        File.Delete(absolutePath);
        RemoveEmptyParentDirectories(absolutePath, selectedTypeDirectory.DirectoryPath);
        _elementTypeManagerMessage = $"Deleted {normalizedRelativePath}.";
        RefreshElementViews();
        await Task.CompletedTask;
    }

    private void LoadElementTypeDirectories()
    {
        var processRoot = GetProcessFilesRoot();
        if (!Directory.Exists(processRoot))
        {
            ElementTypeDirectories = [];
            ManagedElementFiles = [];
            _selectedElementTypeKey = null;
            return;
        }

        ElementTypeDirectories = Directory.GetDirectories(processRoot)
            .Select(path => new ElementTypeDirectory(
                Path.GetFileName(path),
                ToDisplaySegment(Path.GetFileName(path)),
                path,
                Directory.GetFiles(path, "*", SearchOption.AllDirectories).Length))
            .OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (string.IsNullOrWhiteSpace(_selectedElementTypeKey))
        {
            _selectedElementTypeKey = ElementTypeDirectories.FirstOrDefault()?.Key;
        }
        else if (!ElementTypeDirectories.Any(item => string.Equals(item.Key, _selectedElementTypeKey, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedElementTypeKey = ElementTypeDirectories.FirstOrDefault()?.Key;
        }
    }

    private void LoadManagedElementFiles()
    {
        var selectedTypeDirectory = GetSelectedElementTypeDirectory();
        if (selectedTypeDirectory is null || !Directory.Exists(selectedTypeDirectory.DirectoryPath))
        {
            ManagedElementFiles = [];
            return;
        }

        ManagedElementFiles = Directory.GetFiles(selectedTypeDirectory.DirectoryPath, "*", SearchOption.AllDirectories)
            .Select(path =>
            {
                var fileInfo = new FileInfo(path);
                return new ElementTypeFileEntry(
                    Path.GetRelativePath(selectedTypeDirectory.DirectoryPath, path).Replace(Path.DirectorySeparatorChar, '/'),
                    fileInfo.Length,
                    fileInfo.LastWriteTime);
            })
            .OrderBy(item => item.RelativePath, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private ElementTypeDirectory? GetSelectedElementTypeDirectory() =>
        ElementTypeDirectories.FirstOrDefault(item => string.Equals(item.Key, _selectedElementTypeKey, StringComparison.OrdinalIgnoreCase));

    private void RefreshElementViews()
    {
        LoadBulkCogsTargets();
        LoadFrontFacesSchema();
        LoadBackOptions();
        LoadStoredNonImageElements();
        LoadManufacturingTargetGroups();
        LoadElementTypeDirectories();
        LoadManagedElementFiles();
    }

    private static void RemoveEmptyParentDirectories(string filePath, string stopAtDirectory)
    {
        var current = new FileInfo(filePath).Directory;
        var stopAt = Path.GetFullPath(stopAtDirectory).TrimEnd(Path.DirectorySeparatorChar);

        while (current is not null)
        {
            var currentPath = current.FullName.TrimEnd(Path.DirectorySeparatorChar);
            if (string.Equals(currentPath, stopAt, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (current.EnumerateFileSystemInfos().Any())
            {
                return;
            }

            current.Delete();
            current = current.Parent;
        }
    }

    private async Task LoadStockConsumableOptionsAsync()
    {
        StockConsumableOptions = await DbContext.StockConsumables
            .AsNoTracking()
            .OrderBy(item => item.Name)
            .Select(item => new StockConsumableOption(
                item.Id.ToString("N"),
                item.Name,
                item.Type))
            .ToListAsync();
    }

    private void HandleManufacturingFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _pendingManufacturingFile = new UploadedElementFile(
            file.Name,
            string.IsNullOrWhiteSpace(file.ContentType) ? "Unknown" : file.ContentType,
            file.Size,
            DateTimeOffset.UtcNow,
            file);

        _manufacturingFileMessage = null;
    }

    private async Task UploadAndForceLinkManufacturingFileAsync()
    {
        _manufacturingFileMessage = null;

        if (!CanForceLinkManufacturingFile || _pendingManufacturingFile is null)
        {
            _manufacturingFileMessage = "Choose a category, element name, and manufacturing file first.";
            return;
        }

        _isUploadingManufacturingFile = true;

        try
        {
            var processRoot = GetProcessFilesRoot();
            var sourceGroupKey = _manufacturingSourceGroupKey!.Trim();
            var elementSlug = Slugify(_manufacturingElementName!);
            var targetDirectory = Path.Combine(processRoot, sourceGroupKey, elementSlug);
            Directory.CreateDirectory(targetDirectory);

            var safeFileName = GetSafeFileName(_pendingManufacturingFile.Name);
            var targetPath = Path.Combine(targetDirectory, safeFileName);

            await using (var readStream = _pendingManufacturingFile.BrowserFile.OpenReadStream(MaxUploadSize))
            await using (var writeStream = File.Create(targetPath))
            {
                await readStream.CopyToAsync(writeStream);
            }

            var elementKey = $"{sourceGroupKey}/{elementSlug}".ToLowerInvariant();
            var existing = await DbContext.FinishedGoodsManufacturingFiles
                .FirstOrDefaultAsync(item => item.ElementKey == elementKey);

            if (existing is null)
            {
                existing = new FinishedGoodsManufacturingFileEntity
                {
                    ElementKey = elementKey,
                    SourceGroupKey = sourceGroupKey,
                    ElementLabel = _manufacturingElementName!.Trim(),
                    StoredFileName = safeFileName,
                    RelativeFilePath = Path.GetRelativePath(Environment.WebRootPath, targetPath).Replace(Path.DirectorySeparatorChar, '/'),
                    InputDefinition = NormalizeInput(_manufacturingInputsDefinition),
                    OutputDefinition = NormalizeInput(_manufacturingOutputsDefinition),
                    UploadedAt = DateTimeOffset.UtcNow,
                    UpdatedAt = DateTimeOffset.UtcNow,
                };

                DbContext.FinishedGoodsManufacturingFiles.Add(existing);
            }
            else
            {
                existing.SourceGroupKey = sourceGroupKey;
                existing.ElementLabel = _manufacturingElementName!.Trim();
                existing.StoredFileName = safeFileName;
                existing.RelativeFilePath = Path.GetRelativePath(Environment.WebRootPath, targetPath).Replace(Path.DirectorySeparatorChar, '/');
                existing.InputDefinition = NormalizeInput(_manufacturingInputsDefinition);
                existing.OutputDefinition = NormalizeInput(_manufacturingOutputsDefinition);
                existing.UpdatedAt = DateTimeOffset.UtcNow;
            }

            await DbContext.SaveChangesAsync();
            await LoadManufacturingFileLinksAsync();

            _manufacturingFileMessage = $"Uploaded and linked manufacturing file for {_manufacturingElementName} in process-files/{sourceGroupKey}/{elementSlug}.";
            _pendingManufacturingFile = null;
            _manufacturingInputsDefinition = null;
            _manufacturingOutputsDefinition = null;
        }
        catch (Exception exception)
        {
            _manufacturingFileMessage = $"Manufacturing file could not be linked. {exception.Message}";
        }
        finally
        {
            _isUploadingManufacturingFile = false;
        }
    }

