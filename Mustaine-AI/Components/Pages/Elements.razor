    private async Task SaveImageFilesAsync(IReadOnlyList<UploadedElementFile> selectedFiles)
    {
        if (selectedFiles.Count == 0)
        {
            _uploadMessage = "Choose one or more files to save.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_categoryName))
        {
            _uploadMessage = "Enter a category before choosing files.";
            return;
        }

        if (_imageElementCogs is null)
        {
            _uploadMessage = "Enter COGS before saving the files.";
            return;
        }

        var categorySlug = Slugify(_categoryName!);
        var cogs = _imageElementCogs.GetValueOrDefault();
        var targetDirectory = Path.Combine(GetProcessFilesRoot(), "front-faces", categorySlug);

        Directory.CreateDirectory(targetDirectory);

        foreach (var file in selectedFiles)
        {
            var safeFileName = GetSafeFileName(file.Name);
            var targetPath = Path.Combine(targetDirectory, safeFileName);

            await using var readStream = file.BrowserFile.OpenReadStream(MaxUploadSize);
            await using var writeStream = File.Create(targetPath);
            await readStream.CopyToAsync(writeStream);
        }

        await File.WriteAllTextAsync(Path.Combine(targetDirectory, "cogs.txt"), cogs.ToString("0.##"));

        _uploadMessage = $"Saved {selectedFiles.Count} file(s) to process-files/front-faces/{categorySlug}.";
        _imageElementCogs = null;
        RefreshElementViews();
    }

    private async Task ApplySectionCogsAsync()
    {
        if (string.IsNullOrWhiteSpace(_bulkCogsTargetKey))
        {
            _bulkCogsMessage = "Select a section before applying COGS.";
            return;
        }

        if (_bulkCogsValue is null)
        {
            _bulkCogsMessage = "Enter a COGS value before applying.";
            return;
        }

        var target = BulkCogsTargets.FirstOrDefault(item =>
            string.Equals(item.Key, _bulkCogsTargetKey, StringComparison.Ordinal));
        if (target is null || !Directory.Exists(target.DirectoryPath))
        {
            _bulkCogsMessage = "The selected section no longer exists. Refresh and try again.";
            LoadBulkCogsTargets();
            return;
        }

        var assetDirectories = ResolveBulkCogsDirectories(target);
        if (assetDirectories.Count == 0)
        {
            _bulkCogsMessage = "No element folders were found under the selected section.";
            return;
        }

        var cogsText = _bulkCogsValue.Value.ToString("0.##");

        var shouldApply = await JS.InvokeAsync<bool>(
            "confirm",
            $"Apply COGS {cogsText} to {assetDirectories.Count} folder(s) in {target.DisplayName}?\n\nThis will overwrite existing cogs.txt values in those folders.");

        if (!shouldApply)
        {
            _bulkCogsMessage = "Bulk COGS update canceled.";
            return;
        }

        foreach (var assetDirectory in assetDirectories)
        {
            await File.WriteAllTextAsync(Path.Combine(assetDirectory, "cogs.txt"), cogsText);
        }

        _bulkCogsMessage = $"Applied COGS {cogsText} to {assetDirectories.Count} folder(s) in {target.DisplayName}.";
        RefreshElementViews();
    }

    private List<string> ResolveBulkCogsDirectories(SectionCogsTarget target)
    {
        var directories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        if (string.Equals(target.Key, "front-faces/__all", StringComparison.Ordinal))
        {
            foreach (var categoryDirectory in Directory.GetDirectories(target.DirectoryPath))
            {
                AddBulkCogsDirectoriesForSection(categoryDirectory, directories);
            }

            // Include any assets/cogs directly under front-faces as well.
            AddBulkCogsDirectoriesForSection(target.DirectoryPath, directories);
        }
        else
        {
            AddBulkCogsDirectoriesForSection(target.DirectoryPath, directories);
        }

        return directories
            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static void AddBulkCogsDirectoriesForSection(string sectionDirectory, HashSet<string> directories)
    {
        if (!Directory.Exists(sectionDirectory))
        {
            return;
        }

        foreach (var assetDirectory in EnumerateAssetDirectories(sectionDirectory))
        {
            directories.Add(assetDirectory);
        }

        foreach (var cogsDirectory in EnumerateCandidateElementDirectories(sectionDirectory))
        {
            directories.Add(cogsDirectory);
        }

        if (File.Exists(Path.Combine(sectionDirectory, "cogs.txt"))
            || Directory.GetFiles(sectionDirectory).Any(IsSupportedAssetFile))
        {
            directories.Add(sectionDirectory);
        }
    }

    private async Task SaveNonImageElementAsync()
    {
        if (!CanSaveNonImageElement || NonImageDesignFile is null)
        {
            _nonImageMessage = "Choose an element type, name, COGS, and one design file before saving.";
            return;
        }

        var resolvedTypeName = ResolveNonImageTypeName();
        var typeSlug = Slugify(resolvedTypeName);
        var elementSlug = Slugify(_nonImageName!);
        var cogs = _nonImageCogs.GetValueOrDefault();
        var targetDirectory = Path.Combine(GetProcessFilesRoot(), typeSlug, elementSlug);

        Directory.CreateDirectory(targetDirectory);

        foreach (var existingFile in Directory.GetFiles(targetDirectory).Where(file => !IsMetadataFile(file)))
        {
            File.Delete(existingFile);
        }

        var targetPath = Path.Combine(targetDirectory, GetSafeFileName(NonImageDesignFile.Name));

        await using var readStream = NonImageDesignFile.BrowserFile.OpenReadStream(MaxUploadSize);
        await using var writeStream = File.Create(targetPath);
        await readStream.CopyToAsync(writeStream);

        await File.WriteAllTextAsync(Path.Combine(targetDirectory, "cogs.txt"), cogs.ToString("0.##"));

        if (UsesColorOptions)
        {
            await File.WriteAllLinesAsync(
                Path.Combine(targetDirectory, "colors.txt"),
                ParseColors(_nonImageColors!));
        }
        else
        {
            var colorsPath = Path.Combine(targetDirectory, "colors.txt");
            if (File.Exists(colorsPath))
            {
                File.Delete(colorsPath);
            }
        }

        _nonImageMessage = $"Saved {resolvedTypeName} design to process-files/{typeSlug}/{elementSlug}.";
        NonImageDesignFile = null;
        RefreshElementViews();
    }

    private string ResolveNonImageTypeName()
    {
        var rawType = NormalizeInput(_nonImageElementType) ?? "element";

        if (string.Equals(rawType, "Leather", StringComparison.OrdinalIgnoreCase)
            || string.Equals(rawType, "Leather Base", StringComparison.OrdinalIgnoreCase)
            || string.Equals(rawType, "Leather Premium", StringComparison.OrdinalIgnoreCase))
        {
            return string.Equals(_leatherTier, "Premium", StringComparison.OrdinalIgnoreCase)
                ? "Leather Premium"
                : "Leather Base";
        }

        return rawType;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024m / 1024m:F1} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024m:F1} KB";
        }

        return $"{bytes} B";
    }

    private void LoadFrontFacesSchema()
    {
        var frontFacesRoot = FindDirectoryIgnoreCase(GetProcessFilesRoot(), "front-faces");
        if (string.IsNullOrWhiteSpace(frontFacesRoot) || !Directory.Exists(frontFacesRoot))
        {
            FrontFacesSchema = [];
            return;
        }

        FrontFacesSchema = EnumerateAssetDirectories(frontFacesRoot)
            .Select(assetDirectory =>
            {
                var relativePath = Path.GetRelativePath(frontFacesRoot, assetDirectory);
                var segments = relativePath
                    .Split([Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar], StringSplitOptions.RemoveEmptyEntries);
                var reportingCategory = segments.Length == 0
                    ? "Uncategorized"
                    : ToDisplaySegment(segments[0]);
                var schemaPath = string.Join(" / ", segments.Select(ToDisplaySegment));
                var files = Directory.GetFiles(assetDirectory)
                    .Where(IsSupportedAssetFile)
                    .OrderBy(file => file, StringComparer.OrdinalIgnoreCase)
                    .Select(Path.GetFileName)
                    .ToList();
                var (cogsLabel, cogsValue) = GetCogsMetadata(assetDirectory);

                return new FrontFacesSchemaEntry(
                    schemaPath,
                    reportingCategory,
                    relativePath.Replace(Path.DirectorySeparatorChar, '/'),
                    files.Count,
                    string.Join(", ", files),
                    cogsLabel,
                    cogsValue);
            })
            .OrderBy(entry => entry.SchemaPath, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void LoadBackOptions()
    {
        var processFilesRoot = GetProcessFilesRoot();
        var backOptionsDirectory = FindDirectoryIgnoreCase(processFilesRoot, "back-options");

        if (string.IsNullOrWhiteSpace(backOptionsDirectory) || !Directory.Exists(backOptionsDirectory))
        {
            BackOptions = [];
