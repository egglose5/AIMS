    }

    private void LoadBulkCogsTargets()
    {
        var processFilesRoot = GetProcessFilesRoot();
        if (!Directory.Exists(processFilesRoot))
        {
            BulkCogsTargets = [];
            return;
        }

        var targets = new List<SectionCogsTarget>();
        var frontFacesRoot = FindDirectoryIgnoreCase(processFilesRoot, "front-faces");

        if (!string.IsNullOrWhiteSpace(frontFacesRoot) && Directory.Exists(frontFacesRoot))
        {
            targets.Add(new SectionCogsTarget(
                "front-faces/__all",
                "Front Faces / All",
                frontFacesRoot));

            foreach (var categoryDirectory in Directory.GetDirectories(frontFacesRoot)
                         .OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
            {
                var categoryName = ToDisplaySegment(Path.GetFileName(categoryDirectory));
                targets.Add(new SectionCogsTarget(
                    $"front-faces/{Path.GetFileName(categoryDirectory)}",
                    $"Front Faces / {categoryName}",
                    categoryDirectory));
            }
        }

        foreach (var topLevelDirectory in Directory.GetDirectories(processFilesRoot)
                     .Where(path => !string.Equals(Path.GetFileName(path), "front-faces", StringComparison.OrdinalIgnoreCase))
                     .OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
        {
            var displayName = ToDisplaySegment(Path.GetFileName(topLevelDirectory));
            targets.Add(new SectionCogsTarget(
                Path.GetFileName(topLevelDirectory),
                displayName,
                topLevelDirectory));
        }

        BulkCogsTargets = targets;

        if (!string.IsNullOrWhiteSpace(_bulkCogsTargetKey) &&
            !BulkCogsTargets.Any(target => string.Equals(target.Key, _bulkCogsTargetKey, StringComparison.Ordinal)))
        {
            _bulkCogsTargetKey = null;
        }
    }

