            {
                var relativePath = Path.GetRelativePath(backOptionsDirectory, assetDirectory);
                var segments = relativePath
                    .Split([Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar], StringSplitOptions.RemoveEmptyEntries);
                var name = string.Join(" / ", segments.Select(ToDisplaySegment));
                var files = Directory.GetFiles(assetDirectory)
                    .Where(IsSupportedAssetFile)
                    .OrderBy(file => file, StringComparer.OrdinalIgnoreCase)
                    .Select(Path.GetFileName)
                    .ToList();
                var (cogsLabel, cogsValue) = GetCogsMetadata(assetDirectory);

                return new BackOptionAsset(
