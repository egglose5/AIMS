    private static bool IsVendorAcceptedAssignment(ShowAssignmentEntity assignment)
        => assignment.Status is "VENDOR_YES" or "APPROVED" or "BOOKED" or "COMMITTED";

    private string ApplicationStage(ShowAssignmentEntity assignment)
    {
        if (assignment.Status == "COMMITTED") return "COMMITTED";
        var edition = assignment.ShowEdition;
        var app = ApplicationFor(edition.Id, assignment.ShowVendorProfileId);
        var status = (app?.Status ?? "").Trim().ToUpperInvariant();
        if (status is "ACCEPTED" or "WAITLISTED" or "REJECTED" or "APPLIED") return status;
        if (app?.AppliedAt is not null) return "APPLIED";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (edition.ApplicationOpenDate is not null && edition.ApplicationOpenDate.Value > today) return "WAITING";
        if (!string.IsNullOrWhiteSpace(app?.ApplicationUrl) || edition.ApplicationOpenDate is not null || !string.IsNullOrWhiteSpace(edition.LeadUrl)) return "READY";
        return "WAITING";
    }

    private static int ApplicationStageOrder(string stage) => stage switch
    {
        "READY" => 0, "WAITING" => 1, "APPLIED" => 2, "WAITLISTED" => 3,
        "ACCEPTED" => 4, "COMMITTED" => 5, "REJECTED" => 6, _ => 9
    };

