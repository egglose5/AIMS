            {
                edition = new ShowEditionEntity
                {
                    ShowEventId = ev.Id,
                    Year = 2027,
                    StartDate = seed.StartDate,
                    EndDate = seed.EndDate,
                    Status = "CANDIDATE",
                    LeadSource = seed.Source,
                    ResearchStatus = seed.Source == "INTELLIGENCE_DATABASE" ? "HISTORICAL_RESEARCH" : "VERIFY_2027",
