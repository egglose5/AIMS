                    Notes = seed.Notes,
                    CreatedAt = DateTimeOffset.UtcNow,
                    UpdatedAt = DateTimeOffset.UtcNow
                };
                DbContext.ShowEditions.Add(edition);
                await DbContext.SaveChangesAsync();
                added++;
            }
            else
            {
                // Never overwrite Jaime's explicit owner decision.
                if (edition.Recommendation is not ("OWNER_APPROVE" or "OWNER_MAYBE" or "OWNER_DISMISS" or "OWNER_NO"))
                    edition.Recommendation = seed.Decision;
                if (edition.StartDate is null && seed.StartDate is not null) edition.StartDate = seed.StartDate;
                if (edition.EndDate is null && seed.EndDate is not null) edition.EndDate = seed.EndDate;
                if (string.IsNullOrWhiteSpace(edition.LeadUrl) && !string.IsNullOrWhiteSpace(seed.Url)) edition.LeadUrl = seed.Url;
                if (string.IsNullOrWhiteSpace(edition.Notes) && !string.IsNullOrWhiteSpace(seed.Notes)) edition.Notes = seed.Notes;
            }

            foreach (var vendor in vendors)
            {
                var exists = await DbContext.ShowOpportunities.AnyAsync(x => x.ShowEditionId == edition.Id && x.ShowVendorProfileId == vendor.Id);
                if (!exists)
                {
                    DbContext.ShowOpportunities.Add(new ShowOpportunityEntity
                    {
                        ShowEditionId = edition.Id,
                        ShowVendorProfileId = vendor.Id,
                        Priority = seed.Priority ?? "B",
                        Status = "CANDIDATE",
                        FitRationale = seed.Score is int score
