    private async Task EnsureScoutWatchAsync(long editionId)
    {
        await ScoutIntegration.EnsureWatchLinkAsync(editionId);
        var edition = await DbContext.ShowEditions.Include(x => x.ShowEvent).FirstOrDefaultAsync(x => x.Id == editionId);
        if (edition is null || edition.Recommendation != "OWNER_APPROVE") return;
        var watch = await DbContext.ShowApplications.FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == null && x.Platform == "SCOUT_WATCH");
        if (watch is null)
        {
            watch = new ShowApplicationEntity
            {
                ShowEditionId = editionId,
                Platform = "SCOUT_WATCH",
                ExternalApplicationId = ScoutControlKey(edition),
                Status = "WATCHING",
                ExternalStatus = "WATCHING",
                ApplicationUrl = edition.LeadUrl ?? edition.ShowEvent.WebsiteUrl,
                NextAction = ScoutNextWatchAction(edition)
            };
            DbContext.ShowApplications.Add(watch);
        }
        else
        {
            watch.Status = "WATCHING";
            watch.ExternalStatus = watch.ExternalStatus == "DISABLED" ? "WATCHING" : (watch.ExternalStatus ?? "WATCHING");
            watch.ExternalApplicationId = ScoutControlKey(edition);
            watch.ApplicationUrl ??= edition.LeadUrl ?? edition.ShowEvent.WebsiteUrl;
            watch.NextAction = ScoutNextWatchAction(edition);
        }
        await DbContext.SaveChangesAsync();
    }

    private async Task DisableScoutWatchAsync(long editionId)
    {
        await ScoutIntegration.SetWatchEnabledAsync(editionId, false);
        var watch = await DbContext.ShowApplications.FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == null && x.Platform == "SCOUT_WATCH");
        if (watch is null) return;
        watch.Status = "DISABLED";
        watch.ExternalStatus = "DISABLED";
        watch.NextAction = "Owner decision is no longer APPROVE; do not actively watch unless re-approved.";
        await DbContext.SaveChangesAsync();
    }

    private async Task RefreshScoutWatchAsync(long editionId)
    {
        await ScoutIntegration.SetWatchEnabledAsync(editionId, true);
        await ScoutIntegration.EnsureWatchLinkAsync(editionId);
        var watch = await DbContext.ShowApplications.FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == null && x.Platform == "SCOUT_WATCH");
        if (watch is not null)
        {
            watch.ExternalStatus = "WATCHING";
            watch.LastCheckedAt = null;
        }
        await DbContext.SaveChangesAsync();
        await EnsureScoutWatchAsync(editionId);
        _message = "Scout watch reset. The show remains queued for updated dates, application information and documents.";
        await ReloadAsync();
    }

    private static string ScoutNextWatchAction(ShowEditionEntity edition)
    {
        var missing = new List<string>();
        if (edition.StartDate is null || (edition.LeadNote?.Contains("planning placeholder", StringComparison.OrdinalIgnoreCase) ?? false)) missing.Add("verify 2027 dates");
        if (edition.ApplicationOpenDate is null) missing.Add("find application opening");
        if (edition.ApplicationDeadline is null) missing.Add("find application deadline");
        if (string.IsNullOrWhiteSpace(edition.LeadUrl) && string.IsNullOrWhiteSpace(edition.ShowEvent?.WebsiteUrl)) missing.Add("locate official/application source");
        if (edition.BoothFee is null) missing.Add("verify booth fee");
        return missing.Count == 0
            ? "Monitor official/application sources for changes, vendor packets, maps, PDFs and organizer updates."
            : "Watch for: " + string.Join(", ", missing) + ". Also capture PDFs, packets, maps and material changes.";
    }

    private async Task CommitShowAsync(ShowAssignmentEntity assignment)
    {
        var tracked = await DbContext.ShowAssignments.FirstOrDefaultAsync(x => x.Id == assignment.Id);
        if (tracked is null) return;
        tracked.Status = "COMMITTED";
        tracked.CommittedAt = DateTimeOffset.UtcNow;
        var app = await DbContext.ShowApplications.FirstOrDefaultAsync(x => x.ShowEditionId == tracked.ShowEditionId && x.ShowVendorProfileId == tracked.ShowVendorProfileId && x.Platform != "SCOUT_WATCH");
        if (app is not null)
        {
            app.Status = "ACCEPTED";
            app.NextAction = "Show committed. Continue watching organizer instructions, packets, maps, setup and payment requirements.";
            app.LastCheckedAt = DateTimeOffset.UtcNow;
        }
        await EnsureScoutWatchAsync(tracked.ShowEditionId);
        await DbContext.SaveChangesAsync();
        _message = $"{assignment.ShowEdition.ShowEvent.Name} is COMMITTED for {assignment.ShowVendorProfile.VendorName}. Scout watch remains active.";
        await ReloadAsync();
    }

    // Backer lifecycle is post-promoter-acceptance operational data. BACKER_OFFERED means the primary vendor (or an admin override) requested the person; BACKER_ACCEPTED means that person confirmed.
    // BACKER_ASSIGNED is a legacy pre-9.36 state retained only so older historical rows can still be read.
    private static bool IsBackerStatus(string? status) => status is "BACKER_OFFERED" or "BACKER_ACCEPTED" or "BACKER_DECLINED" or "BACKER_CANCELLED" or "BACKER_ASSIGNED";

    private ShowAssignmentEntity? BackerAssignment(long editionId)
