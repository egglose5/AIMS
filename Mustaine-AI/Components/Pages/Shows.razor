                            : "Seeded from Ancient Innovations historical show records. Owner classification controls whether this surfaces."
                    });
                }
            }
        }
        await DbContext.SaveChangesAsync();
        if (added > 0) _message = $"Loaded {added} known 2027 show records into the operational pool. Review/classify them in Show Records.";
