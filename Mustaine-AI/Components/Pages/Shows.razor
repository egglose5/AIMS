    private async Task StartResearchQueueAsync()
    {
        var ready = await DbContext.ShowDiscoveryLeads
            .Where(x => x.TargetYear == 2027
                     && x.TargetMonth == _discoveryMonth
                     && x.ShowVendorProfileId == _discoveryVendorId
                     && (x.SearchQuery == null || !x.SearchQuery.StartsWith(OperationalBoundaryRules.ScoutLeadPrefix))
                     && x.Status == "RESEARCH_READY")
            .ToListAsync();

        foreach (var lead in ready) lead.Status = "RESEARCH_QUEUED";
        await DbContext.SaveChangesAsync();
        _message = ready.Count == 0
            ? "Nothing is waiting to start in this vendor/month Research Queue."
            : $"Research Queue started for {ready.Count} show(s). The Brain works one at a time; you can leave this page.";
        await ReloadAsync();
    }

