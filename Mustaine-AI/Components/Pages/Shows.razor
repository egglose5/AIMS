    private IEnumerable<ShowEditionEntity> FilteredRecordEditions()
    {
        IEnumerable<ShowEditionEntity> query = _editions;
        if (_recordsMonth is >= 1 and <= 12)
            query = query.Where(x => x.StartDate?.Month == _recordsMonth);
        else if (_recordsMonth == 13)
            query = query.Where(x => x.StartDate is null);

        if (!string.IsNullOrWhiteSpace(_recordSearch))
        {
            var term = _recordSearch.Trim();
            query = query.Where(x =>
                x.ShowEvent.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (x.ShowEvent.City?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ShowEvent.State?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return query;
    }

    private async Task UnapproveAsync(long editionId)
    {
        var edition = await DbContext.ShowEditions.Include(x => x.ShowEvent).FirstOrDefaultAsync(x => x.Id == editionId);
        if (edition is null) return;
        edition.Recommendation = "OWNER_UNCLASSIFIED";
        edition.UpdatedAt = DateTimeOffset.UtcNow;
        await DbContext.SaveChangesAsync();
        await DisableScoutWatchAsync(editionId);
        _message = $"{edition.ShowEvent?.Name ?? "Show"} removed from APPROVE and returned to UNCLASSIFIED. Scout watch disabled.";
        await ReloadAsync();
    }

    private async Task ResetApprovedTestingAsync()
    {
        var rows = await DbContext.ShowEditions
            .Where(x => x.Year == 2027 && (x.Recommendation == "OWNER_APPROVE" || x.Recommendation == "OWNER_MAYBE"))
            .ToListAsync();
        foreach (var row in rows)
        {
            row.Recommendation = "OWNER_UNCLASSIFIED";
            row.UpdatedAt = DateTimeOffset.UtcNow;
        }
        await DbContext.SaveChangesAsync();
        _confirmResetApproved = false;
        _calendarSelectedEditionIds.Clear();
        _message = $"Reset {rows.Count} APPROVE/MAYBE testing decision(s) to UNCLASSIFIED. DISMISS and NO were left untouched.";
        await ReloadAsync();
    }

    private IEnumerable<ShowOpportunityEntity> SelectionResults()
    {
        if (_loadedSelectionVendorId != _discoveryVendorId || _loadedSelectionWeekStart != SelectionWeekStart)
            return Enumerable.Empty<ShowOpportunityEntity>();

        var approved = _finderResults
            .Where(x => x.ShowEdition.Recommendation == "OWNER_APPROVE")
            .OrderBy(x => x.ShowEdition.StartDate)
            .ThenByDescending(x => x.ForecastHigh ?? x.ForecastLow ?? 0)
            .ToList();

        if (approved.Count > 0) return approved;

        return _finderResults
            .Where(x => x.ShowEdition.Recommendation == "OWNER_MAYBE")
            .OrderBy(x => x.ShowEdition.StartDate)
            .ThenByDescending(x => x.ForecastHigh ?? x.ForecastLow ?? 0)
            .ToList();
    }

    private void ToggleSelectionResult(ShowOpportunityEntity result)
    {
        if (_calendarSelectedEditionIds.Contains(result.ShowEditionId))
        {
            _calendarSelectedEditionIds.Remove(result.ShowEditionId);
            return;
        }

        _calendarSelectedEditionIds.Clear();
        _calendarSelectedEditionIds.Add(result.ShowEditionId);
    }

