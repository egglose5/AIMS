    private static string FormatCalibrationSales(ShowCalibrationRecordEntity row)
    {
        if (row.ActualGross is not null) return row.ActualGross.Value.ToString("C0");
        if (row.GrossLow is not null && row.GrossHigh is not null) return $"{row.GrossLow:C0}–{row.GrossHigh:C0}";
        if (row.GrossHigh is not null) return $"< {row.GrossHigh:C0}";
        if (row.GrossLow is not null) return $"≥ {row.GrossLow:C0}";
        return "No exact gross";
    }

