        "WAITING" => "Waiting for Application",
        "APPLIED" => "Applied",
        "WAITLISTED" => "Waitlisted",
        "ACCEPTED" => "Accepted",
        "COMMITTED" => "Committed",
        "REJECTED" => "Rejected",
        _ => stage
    };

    private static string ApplicationStageBadge(string stage) => stage switch
    {
        "READY" => "text-bg-primary", "WAITING" => "text-bg-secondary", "APPLIED" => "text-bg-info",
        "WAITLISTED" => "text-bg-warning", "ACCEPTED" => "text-bg-success", "COMMITTED" => "text-bg-dark",
        "REJECTED" => "text-bg-danger", _ => "text-bg-light"
    };

    private async Task SetApplicationStageAsync(ShowAssignmentEntity assignment, string stage)
    {
        var editionId = assignment.ShowEditionId;
        var vendorId = assignment.ShowVendorProfileId;
        var app = await DbContext.ShowApplications.FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == vendorId);
        if (app is null)
        {
            var edition = await DbContext.ShowEditions.AsNoTracking().FirstAsync(x => x.Id == editionId);
            app = new ShowApplicationEntity
            {
                ShowEditionId = editionId,
                ShowVendorProfileId = vendorId,
                Status = stage,
                ApplicationUrl = edition.LeadUrl
            };
            DbContext.ShowApplications.Add(app);
        }
        app.Status = stage;
        app.LastCheckedAt = DateTimeOffset.UtcNow;
        if (stage == "APPLIED")
        {
            app.AppliedAt ??= DateTimeOffset.UtcNow;
            app.NextAction = "Watch for organizer decision.";
        }
        else if (stage is "ACCEPTED" or "WAITLISTED" or "REJECTED")
        {
            app.DecisionAt = DateTimeOffset.UtcNow;
            app.NextAction = stage switch
            {
                "ACCEPTED" => "Confirm booth/payment requirements, then commit the show.",
                "WAITLISTED" => "Watch waitlist and preserve alternate show options.",
                "REJECTED" => "Keep the owner APPROVE decision for future years; this annual application was rejected.",
                _ => app.NextAction
            };
        }
        await DbContext.SaveChangesAsync();
        _message = $"{assignment.ShowEdition.ShowEvent.Name} / {assignment.ShowVendorProfile.VendorName}: application moved to {ApplicationStageLabel(stage)}.";
        await ReloadAsync();
        if (_selectedEditionId == editionId) await SelectEditionAsync(editionId);
    }

