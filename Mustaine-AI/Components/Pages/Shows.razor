    private IEnumerable<List<DateOnly>> CalendarWeeks()
    {
        var first = new DateOnly(2027, _discoveryMonth, 1);
        var last = first.AddMonths(1).AddDays(-1);
        var mondayOffset = ((int)first.DayOfWeek + 6) % 7;
        var start = first.AddDays(-mondayOffset);
        var sundayOffset = (7 - ((int)last.DayOfWeek == 0 ? 7 : (int)last.DayOfWeek)) % 7;
        var end = last.AddDays(sundayOffset);

        for (var cursor = start; cursor <= end; cursor = cursor.AddDays(7))
            yield return Enumerable.Range(0, 7).Select(i => cursor.AddDays(i)).ToList();
    }

    private IEnumerable<ShowOpportunityEntity> CalendarShowsForDay(DateOnly day)
        => _finderResults
            .Where(x => x.ShowEdition.StartDate == day)
            .OrderBy(x => CalendarRank(x.Priority))
            .ThenByDescending(x => x.ForecastHigh ?? x.ForecastLow ?? 0);

    private static int CalendarRank(string? priority) => priority switch
    {
        "A+" => 0,
        "A" => 1,
        "B" => 2,
        "C" => 3,
        "PASS" => 9,
        _ => 5
    };

    private static DateOnly CalendarWeekKey(DateOnly date)
    {
        var mondayOffset = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-mondayOffset);
    }

    private void ToggleCalendarSelection(ShowOpportunityEntity result)
    {
        if (result.ShowEdition.StartDate is null) return;

        if (_calendarSelectedEditionIds.Contains(result.ShowEditionId))
        {
            _calendarSelectedEditionIds.Remove(result.ShowEditionId);
            return;
        }

        // One placement per calendar week for this vendor. Selecting a stronger choice
        // automatically replaces another selected show on the same weekend/week.
        var week = CalendarWeekKey(result.ShowEdition.StartDate.Value);
        var sameWeekIds = _finderResults
            .Where(x => x.ShowEdition.StartDate is not null
                     && CalendarWeekKey(x.ShowEdition.StartDate.Value) == week)
            .Select(x => x.ShowEditionId)
            .ToHashSet();

        _calendarSelectedEditionIds.RemoveWhere(id => sameWeekIds.Contains(id));
        _calendarSelectedEditionIds.Add(result.ShowEditionId);
    }

    private async Task OfferCalendarSelectionsAsync()
    {
        if (_discoveryVendorId is not long vendorId || _calendarSelectedEditionIds.Count == 0) return;

        var offered = 0;
        var failed = new List<string>();

        foreach (var editionId in _calendarSelectedEditionIds.ToList())
        {
            try
            {
                await Placement.OfferToVendorAsync(editionId, vendorId);
                offered++;
            }
            catch (Exception ex)
            {
                var name = _finderResults.FirstOrDefault(x => x.ShowEditionId == editionId)?.ShowEdition.ShowEvent.Name ?? $"Show {editionId}";
                failed.Add($"{name}: {ex.Message}");
            }
        }

        _calendarSelectedEditionIds.Clear();
        _message = failed.Count == 0
            ? $"{offered} show(s) offered to {DiscoveryVendorLabel()}. They now appear on that vendor's Vendor Shows page for YES / NO / NOT THIS WEEKEND."
            : $"{offered} offered. {failed.Count} could not be offered: {string.Join(" | ", failed)}";

        await ReloadAsync();
    }

