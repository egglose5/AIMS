    private async Task FindEligibleVendorsAsync(long editionId)
    {
        var edition = _editions.FirstOrDefault(x => x.Id == editionId);
        if (edition is null) return;
        _assignmentEditionId = editionId;
        _eligibleVendors.Clear();

        var opportunities = await DbContext.ShowOpportunities.AsNoTracking()
            .Where(x => x.ShowEditionId == editionId)
            .ToListAsync();

        foreach (var vendor in _vendors.Where(x => x.IsActive))
        {
            var existingForShow = _assignmentRows
                .Where(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == vendor.Id)
                .OrderByDescending(x => x.OfferedAt)
                .FirstOrDefault();
            if (existingForShow is not null)
                continue;

            if (edition.StartDate is not null)
            {
                var start = edition.StartDate.Value;
                var end = edition.EndDate ?? start;
                var conflict = _assignmentRows.Any(x => x.ShowVendorProfileId == vendor.Id
                    && x.ShowEditionId != editionId
                    && (x.Status is "OFFERED" or "VENDOR_YES" or "APPROVED" or "BOOKED" or "COMMITTED" or "BACKER_ASSIGNED")
                    && x.ShowEdition.StartDate != null
                    && x.ShowEdition.StartDate.Value <= end
                    && (x.ShowEdition.EndDate ?? x.ShowEdition.StartDate.Value) >= start);
                if (conflict) continue;
            }

            var opp = opportunities.FirstOrDefault(x => x.ShowVendorProfileId == vendor.Id);
            if (opp?.Status is "PASS" or "VENDOR_UNAVAILABLE") continue;

            var eligibility = EvaluateVendorEligibility(vendor, edition);
            if (eligibility.State == "INELIGIBLE") continue;

            var score = VendorPlacementScore(vendor, edition, opp);
            var fit = eligibility.State == "CONDITIONAL"
                ? "Conditional — schedule details needed"
                : score >= 85 ? "Excellent placement" : score >= 70 ? "Strong placement" : score >= 55 ? "Viable placement" : "Eligible — review fit";
            var rationale = opp?.FitRationale;
            if (string.IsNullOrWhiteSpace(rationale))
            {
                var bits = new List<string>();
                if (!string.IsNullOrWhiteSpace(vendor.HomeState) && vendor.HomeState.Equals(edition.ShowEvent.State, StringComparison.OrdinalIgnoreCase)) bits.Add("home-state fit");
                if (vendor.IsFullTimeVendor) bits.Add("full-time vendor");
                if (vendor.TargetGrossSales is not null) bits.Add($"target {vendor.TargetGrossSales:C0}+");
                rationale = bits.Count == 0 ? "No vendor-specific history loaded yet; availability is clear." : string.Join(" · ", bits);
            }
            if (!string.IsNullOrWhiteSpace(eligibility.Reason))
                rationale = string.IsNullOrWhiteSpace(rationale) ? eligibility.Reason : $"{eligibility.Reason} · {rationale}";
            _eligibleVendors.Add(new EligibleVendorRow(vendor, score, fit, rationale, false, eligibility.State));
        }

        _eligibleVendors = _eligibleVendors
            .OrderBy(x => x.EligibilityState == "ELIGIBLE" ? 0 : 1)
            .ThenByDescending(x => x.Score)
            .ThenBy(x => x.Vendor.VendorName)
            .ToList();
        var recommendedIndex = _eligibleVendors.FindIndex(x => x.EligibilityState == "ELIGIBLE");
        if (recommendedIndex >= 0)
            _eligibleVendors[recommendedIndex] = _eligibleVendors[recommendedIndex] with { IsRecommended = true };
    }

    private VendorEligibilityResult EvaluateVendorEligibility(ShowVendorProfileEntity vendor, ShowEditionEntity edition)
    {
        var vendorText = $"{vendor.SchedulingRequirements} {vendor.SeasonalRequirements} {vendor.Notes}".ToLowerInvariant();
        var showText = $"{edition.ShowEvent.Name} {edition.ShowHours} {edition.SetupDetails} {edition.LeadNote} {edition.Notes}".ToLowerInvariant();
        var vendorName = vendor.VendorName?.Trim() ?? string.Empty;

        // Sonya's standing deployment rule: full-time job; Friday evening setup or Saturday-morning setup; Saturday-Sunday operation only.
        // The text parser also supports the same rule when it is stored in any vendor profile instead of relying on a name.
        var weekendOnlyOperation = vendorName.Equals("Sonya", StringComparison.OrdinalIgnoreCase)
            || vendorText.Contains("sat-sun") || vendorText.Contains("sat/sun") || vendorText.Contains("saturday-sunday")
            || vendorText.Contains("saturday and sunday") || vendorText.Contains("weekends only");

        var knownFridayOperation = edition.ShowEvent.Name.Contains("Dayton", StringComparison.OrdinalIgnoreCase)
            && edition.ShowEvent.Name.Contains("Celtic", StringComparison.OrdinalIgnoreCase);
        var dateStartsFriday = edition.StartDate is not null && edition.StartDate.Value.DayOfWeek == DayOfWeek.Friday;
        var textSaysFridayOperation = showText.Contains("friday operation") || showText.Contains("runs friday")
            || showText.Contains("open friday") || showText.Contains("friday show hours") || showText.Contains("vendors friday");

        if (weekendOnlyOperation && (knownFridayOperation || dateStartsFriday || textSaysFridayOperation))
            return new VendorEligibilityResult("INELIGIBLE", "Requires Friday operation; this vendor is limited to Saturday-Sunday operation.");

        var scheduleKnown = !string.IsNullOrWhiteSpace(edition.ShowHours) || !string.IsNullOrWhiteSpace(edition.SetupDetails);
        if (weekendOnlyOperation && !scheduleKnown)
            return new VendorEligibilityResult("CONDITIONAL", "Vendor has weekend-only operating constraints, but this show's setup/hours are not fully verified yet.");

        return new VendorEligibilityResult("ELIGIBLE", string.Empty);
    }

    private int VendorPlacementScore(ShowVendorProfileEntity vendor, ShowEditionEntity edition, ShowOpportunityEntity? opp)
    {
        var score = opp?.Priority switch { "A+" => 92, "A" => 84, "B" => 70, "C" => 55, "PASS" => 20, _ => 60 };
        if (!string.IsNullOrWhiteSpace(vendor.HomeState) && !string.IsNullOrWhiteSpace(edition.ShowEvent.State)
            && vendor.HomeState.Equals(edition.ShowEvent.State, StringComparison.OrdinalIgnoreCase)) score += 8;
        if (vendor.IsFullTimeVendor) score += 3;
        if (vendor.IsShowAdmin) score += 1;
        return Math.Clamp(score, 0, 100);
    }

    private async Task SendForVendorApprovalAsync(long editionId, long vendorId)
    {
        var edition = _editions.FirstOrDefault(x => x.Id == editionId);
        var vendor = _vendors.FirstOrDefault(x => x.Id == vendorId);
        if (edition is null || vendor is null) return;
        try
        {
            await Placement.OfferToVendorAsync(editionId, vendorId);
            _message = $"{edition.ShowEvent.Name} sent to {vendor.VendorName} for approval. It will not enter Applications until the vendor says YES.";
            _assignmentEditionId = null;
            _eligibleVendors.Clear();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = $"Could not send {edition.ShowEvent.Name} to {vendor.VendorName}: {ex.Message}";
        }
    }

    private void CloseEligibleVendors()
    {
        _assignmentEditionId = null;
        _eligibleVendors.Clear();
    }

    private async Task ResetAssignmentTestingAsync()
    {
        var editionIds = _editions.Select(x => x.Id).ToList();
        var assignments = await DbContext.ShowAssignments.Where(x => editionIds.Contains(x.ShowEditionId)).ToListAsync();
        var applications = await DbContext.ShowApplications.Where(x => editionIds.Contains(x.ShowEditionId) && (x.Platform == null || x.Platform != "SCOUT_WATCH")).ToListAsync();
        DbContext.ShowApplications.RemoveRange(applications);
        DbContext.ShowAssignments.RemoveRange(assignments);
        await DbContext.SaveChangesAsync();
        _confirmResetAssignments = false;
        _assignmentEditionId = null;
        _eligibleVendors.Clear();
        _message = $"Testing workflow reset: removed {assignments.Count} assignment(s) and {applications.Count} annual application workflow record(s). Owner APPROVE/MAYBE/DISMISS/NO decisions were preserved.";
        await ReloadAsync();
    }

