    private async Task CreateShowAsync()
    {
        if (string.IsNullOrWhiteSpace(_newShow.Name)){ _message = "Show name is required."; return; }
        var name = _newShow.Name.Trim();
        var ev = await DbContext.ShowEvents.FirstOrDefaultAsync(x => x.Name.ToLower() == name.ToLower());
        if (ev is null)
        {
            ev = new ShowEventEntity { Name=name, City=Clean(_newShow.City), State=Clean(_newShow.State), WebsiteUrl=Clean(_newShow.WebsiteUrl), Notes=Clean(_newShow.Notes) };
            DbContext.ShowEvents.Add(ev);
            await DbContext.SaveChangesAsync();
        }
        else
        {
            ev.City ??= Clean(_newShow.City); ev.State ??= Clean(_newShow.State); ev.WebsiteUrl ??= Clean(_newShow.WebsiteUrl); ev.UpdatedAt = DateTimeOffset.UtcNow;
        }
        var edition = await DbContext.ShowEditions.FirstOrDefaultAsync(x => x.ShowEventId == ev.Id && x.Year == 2027);
        if (edition is null)
        {
            edition = new ShowEditionEntity { ShowEventId=ev.Id, Year=2027, Status="ACTIVE", LeadSource="MANUAL", ResearchStatus="NOT_REQUIRED", Recommendation="OWNER_UNCLASSIFIED", ResearchPriority="NORMAL", LeadUrl=Clean(_newShow.WebsiteUrl), LeadNote=Clean(_newShow.Notes) };
            DbContext.ShowEditions.Add(edition);
        }
        await DbContext.SaveChangesAsync();
        _creatingShow=false; _message="Show record added. Historical intelligence remains linked when available."; await ReloadAsync(); await SelectEditionAsync(edition.Id);
    }

