    private async Task PollResearchQueueAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_tab != "research") continue;
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        _queuePollCts?.Cancel();
        _queuePollCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _vendors = await DbContext.ShowVendorProfiles.AsNoTracking().Where(x => x.IsActive).OrderByDescending(x => x.IsShowAdmin).ThenBy(x => x.VendorName).ToListAsync();
        _editions = await DbContext.ShowEditions.Include(x => x.ShowEvent)
            .Where(x => x.Year == 2027 && x.Status != "QUARANTINED")
            .OrderBy(x => x.StartDate).ThenBy(x => x.ShowEvent.Name).ToListAsync();
        _showCount = await DbContext.ShowEvents.CountAsync();
        var activeEditionCandidates = await DbContext.ShowEditions.CountAsync(x => x.Year == 2027 && x.Status != "CLOSED");
        var stagedCandidates = await DbContext.ShowDiscoveryLeads.CountAsync(x => x.TargetYear == 2027 && x.Status == "NEW" && (x.SearchQuery == null || !x.SearchQuery.StartsWith(OperationalBoundaryRules.ScoutLeadPrefix)));
        var queuedCandidates = await DbContext.ShowDiscoveryLeads.CountAsync(x => x.TargetYear == 2027 && (x.Status == "RESEARCH_READY" || x.Status == "RESEARCH_QUEUED" || x.Status == "RESEARCHING") && (x.SearchQuery == null || !x.SearchQuery.StartsWith(OperationalBoundaryRules.ScoutLeadPrefix)));
        _candidateCount = activeEditionCandidates + stagedCandidates + queuedCandidates;
        _committedCount = await DbContext.ShowAssignments.CountAsync(x => x.Status == "COMMITTED");
        _needsResearchCount = _editions.Count(x => x.ResearchStatus == "NEEDS_RESEARCH" || x.ResearchStatus == "NEEDS_MORE_RESEARCH");
        _researchingCount = _editions.Count(x => x.ResearchStatus == "RESEARCHING");
        _strongApplyCount = _editions.Count(x => x.Recommendation == "STRONG_APPLY");
        _rejectCount = _editions.Count(x => x.Recommendation == "REJECT");
        _approvedCount = _editions.Count(x => x.Recommendation == "OWNER_APPROVE");
        _maybeCount = _editions.Count(x => x.Recommendation == "OWNER_MAYBE");
        var editionIds = _editions.Select(x => x.Id).ToList();
        foreach (var approvedEdition in _editions.Where(x => x.Recommendation == "OWNER_APPROVE"))
            await EnsureScoutWatchAsync(approvedEdition.Id);
        _applicationRows = await DbContext.ShowApplications.AsNoTracking()
            .Where(x => editionIds.Contains(x.ShowEditionId))
            .ToListAsync();
        _assignmentRows = await DbContext.ShowAssignments.AsNoTracking()
            .Include(x => x.ShowEdition).ThenInclude(x => x.ShowEvent)
            .Include(x => x.ShowVendorProfile)
            .Where(x => editionIds.Contains(x.ShowEditionId))
            .OrderByDescending(x => x.OfferedAt)
            .ToListAsync();
        _committedEditionIds = _assignmentRows.Where(x => x.Status == "COMMITTED").Select(x => x.ShowEditionId).ToHashSet();
        _calibrations = await DbContext.ShowCalibrationRecords.AsNoTracking().Include(x => x.ShowEvent).OrderBy(x => x.ShowEvent.Name).ThenBy(x => x.Year).ThenBy(x => x.PeriodLabel).ToListAsync();
        _discoveryLeads = await DbContext.ShowDiscoveryLeads.AsNoTracking()
            .Where(x => x.TargetYear == 2027 && x.TargetMonth == _discoveryMonth && x.Status == "NEW" && x.ShowVendorProfileId == _discoveryVendorId && (x.SearchQuery == null || !x.SearchQuery.StartsWith(OperationalBoundaryRules.ScoutLeadPrefix)))
            .OrderByDescending(x => x.DiscoveredAt).Take(50).ToListAsync();
        _discoveryLeads = _discoveryLeads.Where(IsUsefulDiscoveryLead).Take(12).ToList();
        _databaseLeadCount = _discoveryLeads.Count(x => IsDatabaseLead(x));
        _webLeadCount = _discoveryLeads.Count - _databaseLeadCount;
        _researchQueueLeads = await DbContext.ShowDiscoveryLeads.AsNoTracking()
            .Where(x => x.TargetYear == 2027
                     && x.TargetMonth == _discoveryMonth
                     && x.ShowVendorProfileId == _discoveryVendorId
                     && (x.SearchQuery == null || !x.SearchQuery.StartsWith(OperationalBoundaryRules.ScoutLeadPrefix))
                     && (x.Status == "RESEARCH_READY"
                      || x.Status == "RESEARCH_QUEUED"
                      || x.Status == "RESEARCHING"
                      || x.Status == "RESEARCH_COMPLETE"
                      || x.Status == "RESEARCH_REJECTED"
                      || x.Status == "RESEARCH_ERROR"))
            .OrderBy(x => x.DiscoveredAt)
            .Take(100)
            .ToListAsync();
        var selectionWeekStart = SelectionWeekStart;
        var selectionWeekEnd = SelectionWeekEnd;
        if (_discoveryVendorId is long selectedVendorId)
            await EnsureSelectionOpportunitiesAsync(selectedVendorId, selectionWeekStart, selectionWeekEnd);

        _finderResults = _discoveryVendorId is long finderVendorId
            ? await DbContext.ShowOpportunities.AsNoTracking()
                .Include(x => x.ShowEdition).ThenInclude(x => x.ShowEvent)
                .Where(x => x.ShowVendorProfileId == finderVendorId
                         && x.ShowEdition.Year == 2027
                         && x.ShowEdition.StartDate != null
                         && x.ShowEdition.StartDate.Value <= selectionWeekEnd
                         && (x.ShowEdition.EndDate ?? x.ShowEdition.StartDate.Value) >= selectionWeekStart
                         && (x.ShowEdition.Recommendation == "OWNER_APPROVE" || x.ShowEdition.Recommendation == "OWNER_MAYBE"))
                .OrderBy(x => x.ShowEdition.Recommendation == "OWNER_APPROVE" ? 0 : 1)
                .ThenBy(x => x.ShowEdition.StartDate)
                .Take(100).ToListAsync()
            : [];

        var validCalendarIds = _finderResults.Select(x => x.ShowEditionId).ToHashSet();
        _calendarSelectedEditionIds.RemoveWhere(id => !validCalendarIds.Contains(id));

        var prospective = await DbContext.ShowEditions.AsNoTracking().Include(x => x.ShowEvent)
            .Where(x => x.Year <= 2027 && x.ShowEvent.Name == "Frankfort Fall Festival")
            .OrderByDescending(x => x.Year).ToListAsync();
        _prospectiveEditions = [];
        foreach (var pe in prospective)
        {
            var pf = await DbContext.ShowForecasts.AsNoTracking().Where(x => x.ShowEditionId == pe.Id).OrderBy(x => x.FrozenAt).FirstOrDefaultAsync();
            _prospectiveEditions.Add(new ProspectiveEditionRow(pe.ShowEvent, pe.Year, pe.LeadNote, pf));
        }
    }

