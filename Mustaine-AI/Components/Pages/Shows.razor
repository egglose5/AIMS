        var vendors = await DbContext.ShowVendorProfiles.Where(x => x.IsActive).ToListAsync();
        var added = 0;
        foreach (var seed in seeds)
        {
            var ev = await DbContext.ShowEvents.FirstOrDefaultAsync(x => x.Name.ToLower() == seed.Name.ToLower());
            if (ev is null)
            {
                ev = new ShowEventEntity
                {
                    Name = seed.Name,
                    City = seed.City,
                    State = seed.State,
                    EventType = seed.EventType,
                    WebsiteUrl = seed.Url,
                    Notes = seed.Notes,
                    CreatedAt = DateTimeOffset.UtcNow,
                    UpdatedAt = DateTimeOffset.UtcNow
                };
                DbContext.ShowEvents.Add(ev);
                await DbContext.SaveChangesAsync();
            }
            else
            {
                if (string.IsNullOrWhiteSpace(ev.City) && !string.IsNullOrWhiteSpace(seed.City)) ev.City = seed.City;
                if (string.IsNullOrWhiteSpace(ev.State) && !string.IsNullOrWhiteSpace(seed.State)) ev.State = seed.State;
                if (string.IsNullOrWhiteSpace(ev.EventType) && !string.IsNullOrWhiteSpace(seed.EventType)) ev.EventType = seed.EventType;
                if (string.IsNullOrWhiteSpace(ev.WebsiteUrl) && !string.IsNullOrWhiteSpace(seed.Url)) ev.WebsiteUrl = seed.Url;
