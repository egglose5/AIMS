    private static bool IsUsefulDiscoveryLead(ShowDiscoveryLeadEntity lead)
    {
        if (IsDatabaseLead(lead)) return true;
        var title = (lead.Title ?? "").ToLowerInvariant();
        var url = (lead.Url ?? "").ToLowerInvariant();
        string[] generic = ["best festivals", "festivals for", "craft shows and craft fairs", "art shows and craft fairs", "find a ", "events near", "event calendar", "festival guide", "things to do"];
        if (generic.Any(title.Contains)) return false;
        if (url.Contains("/craft-shows") || url.Contains("/festivals/") && title.Contains("best")) return false;
        return true;
    }

