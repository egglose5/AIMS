    {
        _backerEditionId = null;
        _backerVendorId = null;
        _backerRate = null;
    }

    private IEnumerable<ShowVendorProfileEntity> EligibleBackers(ShowEditionEntity edition, long primaryVendorId)
    {
        var existingBacker = BackerAssignment(edition.Id);
        var start = edition.StartDate;
        var end = edition.EndDate ?? start;
        return _vendors.Where(v => v.IsActive && v.Id != primaryVendorId && (existingBacker is null || v.Id != existingBacker.ShowVendorProfileId))
            .Where(v => start is null || !_assignmentRows.Any(a => a.ShowVendorProfileId == v.Id && a.ShowEditionId != edition.Id
                && (a.Status is "OFFERED" or "VENDOR_YES" or "APPROVED" or "BOOKED" or "COMMITTED" or "BACKER_OFFERED" or "BACKER_ACCEPTED" or "BACKER_ASSIGNED")
                && a.ShowEdition.StartDate != null && a.ShowEdition.StartDate.Value <= end && (a.ShowEdition.EndDate ?? a.ShowEdition.StartDate.Value) >= start))
            .OrderBy(v => v.VendorName);
    }

    private static string BackerPolicyHint(ShowVendorProfileEntity primary) => primary.VendorName.ToLowerInvariant() switch
    {
        "jaime" => "Jaime policy: backer defaults to 20% commission paid as a show/business expense.",
        "blake" => "Blake policy: Blake receives his 30% vendor commission and pays his backer from Blake's portion. Set the backer's agreed rate for this show.",
        _ => "Set the backer rate and specify whether Ancient Innovations pays it or it comes from the primary vendor's share."
    };

    private static string EncodeBackerTerms(decimal rate, string paidFrom, long primaryVendorId)
        => $"BACKER_TERMS|RATE={rate:0.##}|PAID_FROM={paidFrom}|PRIMARY_VENDOR_ID={primaryVendorId}";

    private static string BackerTermsLabel(ShowAssignmentEntity backer)
    {
        var raw = backer.DeclineReason ?? "";
        decimal? rate = null;
        string paidFrom = "UNKNOWN";
        foreach (var piece in raw.Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            if (piece.StartsWith("RATE=", StringComparison.OrdinalIgnoreCase) && decimal.TryParse(piece[5..], out var parsed)) rate = parsed;
            if (piece.StartsWith("PAID_FROM=", StringComparison.OrdinalIgnoreCase)) paidFrom = piece[10..];
        }
        var payer = paidFrom == "BUSINESS" ? "paid by Ancient Innovations" : paidFrom == "PRIMARY_VENDOR_SHARE" ? "paid from primary vendor share" : "payer not set";
        var state = backer.Status switch { "BACKER_OFFERED" => "approval pending", "BACKER_ACCEPTED" => "confirmed", "BACKER_DECLINED" => "declined", "BACKER_ASSIGNED" => "legacy assignment", _ => FormatEnum(backer.Status) };
        return rate is null ? $"{state} · {payer}" : $"{state} · {rate:0.##}% · {payer}";
    }

    private async Task AssignBackerAsync(long editionId, long primaryVendorId)
    {
        if (_backerVendorId is not long backerId || _backerRate is null) return;
        // Normal backer selection belongs to the primary vendor's portal after promoter acceptance.
        // This admin path is an override/request path only, and it must obey the same timing rule.
        var app = await DbContext.ShowApplications.AsNoTracking().FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == primaryVendorId && x.Platform != "SCOUT_WATCH");
        var primary = await DbContext.ShowAssignments.AsNoTracking().FirstOrDefaultAsync(x => x.ShowEditionId == editionId && x.ShowVendorProfileId == primaryVendorId && !IsBackerStatus(x.Status));
        var acceptedByPromoter = primary?.Status == "COMMITTED" || (app?.Status ?? "").Equals("ACCEPTED", StringComparison.OrdinalIgnoreCase);
        if (!acceptedByPromoter)
        {
            _message = "Backers are chosen only after the promoter accepts Ancient Innovations into the show.";
            return;
        }
        var existing = await DbContext.ShowAssignments.FirstOrDefaultAsync(x => x.ShowEditionId == editionId && (x.Status == "BACKER_OFFERED" || x.Status == "BACKER_ACCEPTED" || x.Status == "BACKER_ASSIGNED"));
        if (existing is not null) DbContext.ShowAssignments.Remove(existing);
        var row = new ShowAssignmentEntity
        {
            ShowEditionId = editionId,
            ShowVendorProfileId = backerId,
            Status = "BACKER_OFFERED",
            OfferedAt = DateTimeOffset.UtcNow,
            RespondedAt = null,
            DeclineReason = EncodeBackerTerms(_backerRate.Value, _backerPaidFrom, primaryVendorId)
        };
        DbContext.ShowAssignments.Add(row);
        await DbContext.SaveChangesAsync();
        var backerName = _vendors.FirstOrDefault(x => x.Id == backerId)?.VendorName ?? "Backer";
        _message = $"Backer approval request sent to {backerName}. They are not confirmed until they accept in Vendor Shows.";
        CloseBackerPanel();
        await ReloadAsync();
    }

    private async Task RemoveBackerAsync(long assignmentId)
    {
        var row = await DbContext.ShowAssignments.FirstOrDefaultAsync(x => x.Id == assignmentId && (x.Status == "BACKER_OFFERED" || x.Status == "BACKER_ACCEPTED" || x.Status == "BACKER_ASSIGNED"));
        if (row is null) return;
        row.Status = "BACKER_CANCELLED";
        row.RespondedAt = DateTimeOffset.UtcNow;
        await DbContext.SaveChangesAsync();
        _message = "Backer relationship cancelled. The primary vendor assignment and audit history were preserved.";
        await ReloadAsync();
    }

    private static string RecommendationBadge(string? s) => s switch { "OWNER_APPROVE" => "text-bg-success", "OWNER_MAYBE" => "text-bg-warning", "OWNER_DISMISS" => "text-bg-secondary", "OWNER_NO" => "text-bg-danger", "STRONG_APPLY" => "text-bg-success", "APPLY" => "text-bg-primary", "BACKUP" => "text-bg-warning", "REJECT" => "text-bg-danger", _ => "text-bg-secondary" };
    private static string FormatEnum(string? s) => string.IsNullOrWhiteSpace(s) ? "Unknown" : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s.Replace("_", " ").ToLowerInvariant());
    private DateOnly SelectionWeekStart => CalendarWeekKey(_selectionDate);
    private DateOnly SelectionWeekEnd => SelectionWeekStart.AddDays(6);

    private async Task LoadShowSelectionAsync()
    {
        var adjustedFromPriorYear = false;
        if (_selectionDate.Year != 2027)
        {
            var safeDay = Math.Min(_selectionDate.Day, DateTime.DaysInMonth(2027, _selectionDate.Month));
            _selectionDate = new DateOnly(2027, _selectionDate.Month, safeDay);
            adjustedFromPriorYear = true;
        }
        _discoveryMonth = _selectionDate.Month;
        _calendarSelectedEditionIds.Clear();
        await ReloadAsync();
        _loadedSelectionVendorId = _discoveryVendorId;
        _loadedSelectionWeekStart = SelectionWeekStart;
        var count = SelectionResults().Count();
        _message = count == 0
            ? $"{(adjustedFromPriorYear ? "Selection moved to 2027. " : "")}No APPROVE or MAYBE show is available for {DiscoveryVendorLabel()} in the {_selectionDate:MMM d} date block."
            : $"{(adjustedFromPriorYear ? $"Selection moved to {_selectionDate:MMM d, yyyy}. " : "")}{count} vetted show match(es) ready for {DiscoveryVendorLabel()}.";
    }

    private async Task EnsureSelectionOpportunitiesAsync(long vendorId, DateOnly weekStart, DateOnly weekEnd)
    {
        var eligibleEditionIds = await DbContext.ShowEditions.AsNoTracking()
            .Where(x => x.Year == 2027
                     && x.Status != "QUARANTINED"
                     && x.StartDate != null
                     && x.StartDate.Value <= weekEnd
                     && (x.EndDate ?? x.StartDate.Value) >= weekStart
                     && (x.Recommendation == "OWNER_APPROVE" || x.Recommendation == "OWNER_MAYBE"))
            .Select(x => x.Id)
            .ToListAsync();

        if (eligibleEditionIds.Count == 0) return;

        var existingIds = (await DbContext.ShowOpportunities.AsNoTracking()
            .Where(x => x.ShowVendorProfileId == vendorId && eligibleEditionIds.Contains(x.ShowEditionId))
            .Select(x => x.ShowEditionId)
            .ToListAsync()).ToHashSet();

        foreach (var editionId in eligibleEditionIds.Where(id => !existingIds.Contains(id)))
        {
            DbContext.ShowOpportunities.Add(new ShowOpportunityEntity
            {
                ShowEditionId = editionId,
                ShowVendorProfileId = vendorId,
                Priority = "B",
                Status = "CANDIDATE",
                FitRationale = "Owner-vetted show available for this vendor/date block. Vendor-specific fit has not yet been scored."
            });
        }

        if (DbContext.ChangeTracker.HasChanges()) await DbContext.SaveChangesAsync();
    }

