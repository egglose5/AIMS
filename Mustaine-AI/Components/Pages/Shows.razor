@page "/shows"
@implements IAsyncDisposable
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using MustaineAI.Data
@using MustaineAI.Services
@inject ShowArmDbContext DbContext
@inject IShowWebResearchService WebResearch
@inject IShowPlacementService Placement
@inject IShowDatabaseImportService ShowDatabase
@inject IScoutIntegrationService ScoutIntegration
@inject IWebHostEnvironment Environment
@inject IShowFileStorageService ShowFiles

<PageTitle>Lynks</PageTitle>

<div class="shows-hero">
    <p class="shows-eyebrow">Lynks · Show Operations</p>
    <h1>Lynks</h1>
    <p>Select the right show, place the right person, manage the commitment, and preserve what Ancient Innovations learns.</p>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-success">@_message</div>
}

<div class="shows-metrics">
    <div class="shows-card"><span>Vendors</span><strong>@_vendors.Count</strong></div>
    <div class="shows-card"><span>2027 Records</span><strong>@_editions.Count</strong></div>
    <div class="shows-card"><span>Approved</span><strong>@_approvedCount</strong></div>
    <div class="shows-card"><span>Maybe</span><strong>@_maybeCount</strong></div>
    <div class="shows-card"><span>Committed</span><strong>@_committedCount</strong></div>
</div>

<div class="showarm-tabs mt-3">
    <button class="@TabClass("approved")" @onclick='() => _tab = "approved"'>Approved Shows</button>
    <button class="@TabClass("applications")" @onclick='() => _tab = "applications"'>Applications</button>
    <button class="@TabClass("watch")" @onclick='() => _tab = "watch"'>Scout Watch</button>
    <button class="@TabClass("selection")" @onclick='() => _tab = "selection"'>Vendor Calendar</button>
    <button class="@TabClass("records")" @onclick='() => _tab = "records"'>Show Records</button>
    <button class="@TabClass("history")" @onclick='() => _tab = "history"'>Historical Intelligence</button>
    <button class="@TabClass("vendors")" @onclick='() => _tab = "vendors"'>Vendor Profiles</button>
</div>

@if (_tab == "history")
{
    <section class="shows-card mt-3">
        <div class="shows-card-head"><div><h2>Historical Intelligence</h2><p>Owner-known outcomes and calibration lessons. These are preserved without inventing exact years when the year is unknown.</p></div></div>
        @if (_calibrations.Count == 0)
        {
            <p class="text-body-secondary mb-0">No historical intelligence loaded yet.</p>
        }
        else
        {
            @foreach (var group in _calibrations.GroupBy(x => x.ShowEvent.Name).OrderBy(x => x.Key))
            {
                <div class="showarm-history-group">
                    <h3>@group.Key</h3>
                    @foreach (var row in group.OrderBy(x => x.Year ?? 9999).ThenBy(x => x.PeriodLabel))
                    {
                        <div class="showarm-history-row">
                            <div>
                                <strong>@row.PeriodLabel</strong>
                                <span>@(row.VendorName ?? "Vendor not recorded") @if(!string.IsNullOrWhiteSpace(row.Placement)){<text> · @row.Placement</text>}</span>
                            </div>
                            <div class="showarm-history-sales">@FormatCalibrationSales(row)</div>
                            <div class="showarm-history-lesson">@row.Lesson @if(row.IsDoNotReturn){<span class="badge text-bg-danger ms-2">Do not return</span>}</div>
                        </div>
                    }
                </div>
            }
        }
    </section>

    @if (_prospectiveEditions.Count > 0)
    {
        <section class="shows-card mt-3">
            <div class="shows-card-head"><div><h2>Prospective forecast tests</h2><p>Predictions frozen before Ancient Innovations attends. These are the cleanest tests of forecast accuracy.</p></div></div>
            @foreach (var item in _prospectiveEditions)
            {
                <div class="showarm-history-row">
                    <div><strong>@item.ShowEvent.Name</strong><span>@item.Year · @item.ShowEvent.City, @item.ShowEvent.State</span></div>
                    <div class="showarm-history-sales">@(item.Forecast is null ? "No frozen forecast" : $"{(item.Forecast.ExpectedGross ?? ((item.Forecast.ForecastLow + item.Forecast.ForecastHigh)/2)).ToString("C0")} expected · {item.Forecast.ForecastLow.ToString("C0")}–{item.Forecast.ForecastHigh.ToString("C0")}")</div>
                    <div class="showarm-history-lesson">@(item.Forecast?.EvidenceSummary ?? item.LeadNote)</div>
                </div>
            }
        </section>
    }
}
else if (_tab == "vendors")
{
    <section class="shows-card mt-3">
        <div class="shows-card-head"><div><h2>Vendor Deployment Profiles</h2><p>Permanent matching rules. Structured values drive matching; notes preserve the nuance.</p></div></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Vendor</th><th>Base</th><th>Travel</th><th>Target</th><th>Key requirements</th></tr></thead>
                <tbody>
                @foreach (var vendor in _vendors)
                {
                    <tr>
                        <td><strong>@vendor.VendorName</strong>@if(vendor.IsShowAdmin){<span class="badge text-bg-dark ms-2">Full access</span>}</td>
                        <td>@FormatBase(vendor)</td><td>@FormatTravel(vendor)</td><td>@FormatTarget(vendor)</td><td>@vendor.SchedulingRequirements</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
else if (_tab == "approved")
{
    var approvedPool = _editions
        .Where(x => x.Recommendation == "OWNER_APPROVE")
        .OrderBy(x => x.StartDate ?? new DateOnly(2099,12,31))
        .ThenBy(x => x.ShowEvent.Name)
        .ToList();

    <section class="shows-card mt-3">
        <div class="shows-card-head">
            <div>
                <h2>Approved Shows</h2>
                <p><strong>Show first, then people.</strong> Pick a show Ancient Innovations wants, find the eligible vendors, and send the best placement to that vendor for approval.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge text-bg-success">@approvedPool.Count APPROVED</span>
                @if (!_confirmResetAssignments)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmResetAssignments = true" disabled="@(_assignmentRows.Count == 0)">Reset assignment testing</button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" @onclick="ResetAssignmentTestingAsync">Confirm workflow reset</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmResetAssignments = false">Cancel</button>
                }
                @if (!_confirmResetApproved)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmResetApproved = true" disabled="@(approvedPool.Count == 0 && _maybeCount == 0)">Reset approval testing</button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" @onclick="ResetApprovedTestingAsync">Confirm approval reset</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmResetApproved = false">Cancel</button>
                }
            </div>
        </div>

        @if (approvedPool.Count == 0)
        {
            <p class="text-body-secondary mb-0">No approved shows yet. Approve a record in Show Records and it appears here immediately.</p>
        }
        else
        {
            @foreach (var monthGroup in approvedPool.GroupBy(x => x.StartDate?.Month ?? 99).OrderBy(x => x.Key))
            {
                <div class="showarm-history-group">
                    <h3>@(monthGroup.Key is >= 1 and <= 12 ? new DateTime(2027, monthGroup.Key, 1).ToString("MMMM") : "Dates TBD")</h3>
                    @foreach (var weekGroup in monthGroup.GroupBy(x => x.StartDate is null ? (DateOnly?)null : CalendarWeekKey(x.StartDate.Value)).OrderBy(x => x.Key ?? new DateOnly(2099,12,31)))
                    {
                        <div class="mb-3">
                            <div class="fw-bold mb-2">@(weekGroup.Key is DateOnly wk ? $"Weekend block {wk:MMM d}–{wk.AddDays(6):MMM d}" : "Date not yet known")</div>
                            <div class="showarm-evidence-list">
                                @foreach (var edition in weekGroup)
                                {
                                    var assignment = CurrentAssignment(edition.Id);
                                    <div class="showarm-evidence-item">
                                        <div class="d-flex justify-content-between gap-2 align-items-start">
                                            <div>
                                                <strong>@edition.ShowEvent.Name</strong>
                                                <span>@edition.ShowEvent.City, @edition.ShowEvent.State · @FormatDates(edition)</span>
                                            </div>
                                            <span class="badge @AssignmentBadge(assignment?.Status)">@AssignmentLabel(assignment)</span>
                                        </div>
                                        @if (assignment is not null)
                                        {
                                            <small><strong>Primary:</strong> @assignment.ShowVendorProfile.VendorName · @AssignmentDetail(assignment)</small>
                                            var backer = BackerAssignment(edition.Id);
                                            @if (backer is not null)
                                            {
                                                <small><strong>Backer:</strong> @backer.ShowVendorProfile.VendorName · @BackerTermsLabel(backer)</small>
                                            }
                                        }
                                        <div class="settings-actions mt-2">
                                            <button class="btn btn-sm btn-primary" @onclick="() => FindEligibleVendorsAsync(edition.Id)">Find eligible vendors</button>
                                            @if (assignment is not null && IsVendorAcceptedAssignment(assignment))
                                            {
                                                <button class="btn btn-sm btn-outline-dark" @onclick="() => OpenBackerPanel(edition.Id)">Manage backer</button>
                                            }
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRecordAsync(edition.Id)">Open record</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UnapproveAsync(edition.Id)">Remove approval</button>
                                        </div>

                                        @if (_assignmentEditionId == edition.Id)
                                        {
                                            <div class="border rounded p-3 mt-3">
                                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                    <div>
                                                        <strong>Eligible vendors</strong>
                                                        <div class="text-body-secondary small">Available people are ranked using current Show Arm fit/history. Melissa can send one placement for vendor approval.</div>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseEligibleVendors">Close</button>
                                                </div>
                                                @if (_eligibleVendors.Count == 0)
                                                {
                                                    <div class="alert alert-warning mb-0">No currently eligible vendor was found. Check existing assignments, vendor availability, or the vendor profile.</div>
                                                }
                                                else
                                                {
                                                    <div class="showarm-evidence-list">
                                                        @foreach (var candidate in _eligibleVendors)
                                                        {
                                                            <div class="showarm-evidence-item">
                                                                <div class="d-flex justify-content-between gap-2 align-items-start">
                                                                    <div>
                                                                        <strong>@candidate.Vendor.VendorName</strong>
                                                                        <span>@candidate.FitLabel</span>
                                                                        @if (!string.IsNullOrWhiteSpace(candidate.Rationale)) { <small>@candidate.Rationale</small> }
                                                                    </div>
                                                                    <span class="badge @(candidate.IsRecommended ? "text-bg-success" : candidate.EligibilityState == "CONDITIONAL" ? "text-bg-warning" : "text-bg-light")">@(candidate.IsRecommended ? "RECOMMENDED" : candidate.EligibilityState)</span>
                                                                </div>
                                                                <div class="settings-actions mt-2">
                                                                    <button class="btn btn-sm btn-primary" disabled="@(candidate.EligibilityState != "ELIGIBLE")" @onclick="() => SendForVendorApprovalAsync(edition.Id, candidate.Vendor.Id)">@(candidate.EligibilityState == "ELIGIBLE" ? "Send for vendor approval" : "Needs schedule review")</button>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    @if (_backerEditionId == edition.Id)
                                    {
                                        var primaryForBacker = CurrentAssignment(edition.Id);
                                        var existingBacker = BackerAssignment(edition.Id);
                                        <div class="border rounded p-3 mt-3">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                <div>
                                                    <strong>Backer assignment</strong>
                                                    <div class="text-body-secondary small">Backers are optional and belong to the primary vendor's show plan. Their compensation does not change Ancient Innovations' vendor commission unless the business is explicitly paying the backer.</div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseBackerPanel">Close</button>
                                            </div>
                                            @if (existingBacker is not null)
                                            {
                                                <div class="alert alert-light py-2">
                                                    <strong>@existingBacker.ShowVendorProfile.VendorName</strong> is the current backer · @BackerTermsLabel(existingBacker)
                                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RemoveBackerAsync(existingBacker.Id)">Remove backer</button>
                                                </div>
                                            }
                                            @if (primaryForBacker is null)
                                            {
                                                <p class="text-body-secondary mb-0">A primary vendor must accept the show before a backer can be assigned.</p>
                                            }
                                            else
                                            {
                                                <div class="showarm-form-grid">
                                                    <label>Backer
                                                        <select class="form-select" @bind="_backerVendorId">
                                                            <option value="">Choose backer</option>
                                                            @foreach (var v in EligibleBackers(edition, primaryForBacker.ShowVendorProfileId))
                                                            {
                                                                <option value="@v.Id">@v.VendorName</option>
                                                            }
                                                        </select>
                                                    </label>
                                                    <label>Backer commission %
                                                        <input type="number" step="0.5" min="0" max="100" class="form-control" @bind="_backerRate" />
                                                    </label>
                                                    <label>Paid from
                                                        <select class="form-select" @bind="_backerPaidFrom">
                                                            <option value="BUSINESS">Ancient Innovations / show expense</option>
                                                            <option value="PRIMARY_VENDOR_SHARE">Primary vendor's commission/share</option>
                                                        </select>
                                                    </label>
                                                </div>
                                                <small class="text-body-secondary d-block mt-2">@BackerPolicyHint(primaryForBacker.ShowVendorProfile)</small>
                                                <button class="btn btn-sm btn-dark mt-2" disabled="@(_backerVendorId is null || _backerRate is null)" @onclick="() => AssignBackerAsync(edition.Id, primaryForBacker.ShowVendorProfileId)">Assign backer</button>
                                            }
                                        </div>
                                    }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </section>
}
else if (_tab == "applications")
{
    var applicationAssignments = _assignmentRows
        .Where(IsVendorAcceptedAssignment)
        .OrderBy(x => x.ShowEdition.StartDate ?? new DateOnly(2099,12,31))
        .ThenBy(x => x.ShowEdition.ShowEvent.Name)
        .ToList();

    <section class="shows-card mt-3">
        <div class="shows-card-head">
            <div>
                <h2>Vendor-Approved Shows → Applications</h2>
                <p>A show enters Melissa's application workload only after the assigned vendor says YES. Owner approval alone does not start an application.</p>
            </div>
            <span class="badge text-bg-primary">@applicationAssignments.Count READY FOR APPLICATION FLOW</span>
        </div>

        @if (applicationAssignments.Count == 0)
        {
            <p class="text-body-secondary mb-0">No vendor-approved assignments yet. Start in Approved Shows, send a placement for vendor approval, and it will move here after the vendor accepts.</p>
        }
        else
        {
            <div class="showarm-application-board">
                @foreach (var group in applicationAssignments.GroupBy(ApplicationStage).OrderBy(g => ApplicationStageOrder(g.Key)))
                {
                    <div class="showarm-application-group">
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                            <h3 class="h5 mb-0">@ApplicationStageLabel(group.Key)</h3>
                            <span class="badge @ApplicationStageBadge(group.Key)">@group.Count()</span>
                        </div>
                        <div class="showarm-evidence-list">
                            @foreach (var assignment in group)
                            {
                                var edition = assignment.ShowEdition;
                                var app = ApplicationFor(edition.Id, assignment.ShowVendorProfileId);
                                var stage = ApplicationStage(assignment);
                                <div class="showarm-evidence-item">
                                    <div class="d-flex justify-content-between gap-2 align-items-start">
                                        <div>
                                            <strong>@edition.ShowEvent.Name</strong>
                                            <span>@edition.ShowEvent.City, @edition.ShowEvent.State · @FormatDates(edition)</span>
                                            <small><strong>Assigned:</strong> @assignment.ShowVendorProfile.VendorName</small>
                                        </div>
                                        <span class="badge @ApplicationStageBadge(stage)">@ApplicationStageLabel(stage)</span>
                                    </div>
                                    <small>
                                        @if (edition.ApplicationOpenDate is not null) { <text>Opens @edition.ApplicationOpenDate.Value.ToString("MMM d, yyyy") · </text> }
                                        @if (edition.ApplicationDeadline is not null) { <text>Deadline @edition.ApplicationDeadline.Value.ToString("MMM d, yyyy")</text> }
                                        else { <text>Deadline not loaded</text> }
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(app?.NextAction))
                                    {
                                        <span><strong>Next:</strong> @app.NextAction</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(app?.ApplicationUrl))
                                    {
                                        <small>@(app.Platform ?? "Direct application") · application link saved</small>
                                    }
                                    <div class="settings-actions mt-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRecordAsync(edition.Id)">Open record</button>
                                        @if (!string.IsNullOrWhiteSpace(app?.ApplicationUrl))
                                        {
                                            <a class="btn btn-sm btn-outline-dark" href="@app.ApplicationUrl" target="_blank" rel="noopener">Open application</a>
                                        }
                                        @if (stage is "WAITING" or "READY")
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick='() => SetApplicationStageAsync(assignment, "APPLIED")'>Mark applied</button>
                                        }
                                        else if (stage == "APPLIED")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick='() => SetApplicationStageAsync(assignment, "ACCEPTED")'>Accepted</button>
                                            <button class="btn btn-sm btn-warning" @onclick='() => SetApplicationStageAsync(assignment, "WAITLISTED")'>Waitlisted</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => SetApplicationStageAsync(assignment, "REJECTED")'>Rejected</button>
                                        }
                                        else if (stage == "WAITLISTED")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick='() => SetApplicationStageAsync(assignment, "ACCEPTED")'>Accepted</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => SetApplicationStageAsync(assignment, "REJECTED")'>Rejected</button>
                                        }
                                        else if (stage == "ACCEPTED")
                                        {
                                            <button class="btn btn-sm btn-dark" @onclick='() => CommitShowAsync(assignment)'>Mark committed</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
else if (_tab == "watch")
{
    var watchedShows = _editions
        .Where(x => x.Recommendation == "OWNER_APPROVE")
        .OrderBy(x => x.StartDate ?? new DateOnly(2099,12,31))
        .ThenBy(x => x.ShowEvent.Name)
        .ToList();

    <section class="shows-card mt-3">
        <div class="shows-card-head">
            <div>
                <h2>Scout Watch Queue</h2>
                <p>Approved shows stay operationally owned by Control App. Scout will watch these records for current dates, applications, deadlines, fees, PDFs, packets, maps and organizer changes.</p>
            </div>
            <span class="badge text-bg-dark">@watchedShows.Count WATCHED</span>
        </div>
        <div class="alert alert-light mb-3">
            <strong>Scout may update facts, not decisions.</strong> The API enforces an allowlist, logs source + previous/new value, ignores duplicate updates, and deduplicates documents by file hash. APPROVE/MAYBE/DISMISS/NO, vendor/backer assignment, application submission, spending and commitment remain protected here.
        </div>
        @if (watchedShows.Count == 0)
        {
            <p class="text-body-secondary mb-0">No approved shows are currently on the watch queue.</p>
        }
        else
        {
            <div class="showarm-evidence-list">
                @foreach (var edition in watchedShows)
                {
                    var watchRow = ScoutWatchFor(edition.Id);
                    <div class="showarm-evidence-item">
                        <div class="d-flex justify-content-between gap-2 align-items-start">
                            <div>
                                <strong>@edition.ShowEvent.Name</strong>
                                <span>@edition.ShowEvent.City, @edition.ShowEvent.State · @FormatDates(edition)</span>
                            </div>
                            <span class="badge @ScoutWatchBadge(watchRow)">@ScoutWatchLabel(watchRow)</span>
                        </div>
                        <small><strong>Control key:</strong> @ScoutControlKey(edition)</small>
                        <small>
                            @if (edition.ApplicationOpenDate is not null) { <text>Application opens @edition.ApplicationOpenDate.Value.ToString("MMM d, yyyy") · </text> }
                            @if (edition.ApplicationDeadline is not null) { <text>Deadline @edition.ApplicationDeadline.Value.ToString("MMM d, yyyy")</text> }
                            else { <text>Application deadline not yet verified</text> }
                        </small>
                        @if (!string.IsNullOrWhiteSpace(watchRow?.NextAction))
                        {
                            <span><strong>Watcher task:</strong> @watchRow.NextAction</span>
                        }
                        <div class="settings-actions mt-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRecordAsync(edition.Id)">Open record</button>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => RefreshScoutWatchAsync(edition.Id)">Reset / refresh watch</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
else if (_tab == "selection")
{
    <section class="shows-card mt-3">
        <div class="shows-card-head">
            <div>
                <h2>Vendor Calendar / Coverage Gaps</h2>
                <p><strong>Secondary planning view.</strong> Use this when you want to see what an individual vendor has on a weekend or identify an uncovered date. Actual assignments start from Approved Shows.</p>
            </div>
        </div>

        <div class="showarm-form-grid">
            <label>Vendor
                <select class="form-select" @bind="_discoveryVendorId">
                    <option value="">Choose vendor</option>
                    @foreach (var v in _vendors){<option value="@v.Id">@v.VendorName</option>}
                </select>
            </label>
            <label>Date / weekend block
                <input type="date" class="form-control" min="2027-01-01" max="2027-12-31" @bind="_selectionDate" />
            </label>
        </div>

        <div class="d-flex gap-2 flex-wrap mt-3">
            <button class="btn btn-dark" disabled="@(_discoveryVendorId is null)" @onclick="LoadShowSelectionAsync">Show matches</button>
            <span class="text-body-secondary align-self-center">@SelectionWeekStart.ToString("MMM d")–@SelectionWeekEnd.ToString("MMM d, yyyy")</span>
        </div>
    </section>

    @if (_discoveryVendorId is null)
    {
        <section class="shows-card mt-3">
            <p class="text-body-secondary mb-0">Choose the person who needs a placement, then choose the weekend.</p>
        </section>
    }
    else
    {
        var selectionResults = SelectionResults().ToList();
        var showingMaybe = selectionResults.Count > 0 && selectionResults.All(x => x.ShowEdition.Recommendation == "OWNER_MAYBE");

        <section class="shows-card mt-3">
            <div class="shows-card-head">
                <div>
                    <h2>@DiscoveryVendorLabel() · @SelectionWeekStart.ToString("MMM d")–@SelectionWeekEnd.ToString("MMM d")</h2>
                    <p>@(showingMaybe ? "No APPROVE show is available in this block, so MAYBE shows are being surfaced." : "Approved shows for this date block.")</p>
                </div>
                <span class="badge @(showingMaybe ? "text-bg-warning" : "text-bg-success")">@(showingMaybe ? "MAYBE FALLBACK" : "APPROVE")</span>
            </div>

            @if (selectionResults.Count == 0)
            {
                <div class="alert alert-light mb-0">
                    <strong>No vetted show is available for this vendor/date block.</strong>
                    DISMISS and NO records stay suppressed. Once Scout is connected, this becomes a coverage gap for Scout to investigate.
                </div>
            }
            else
            {
                <div class="showarm-discovery-list">
                    @foreach (var result in selectionResults)
                    {
                        var selected = _calendarSelectedEditionIds.Contains(result.ShowEditionId);
                        <div class="showarm-evidence-item">
                            <div class="d-flex justify-content-between gap-2 align-items-start">
                                <div>
                                    <strong>@result.ShowEdition.ShowEvent.Name</strong>
                                    <span>@result.ShowEdition.ShowEvent.City, @result.ShowEdition.ShowEvent.State · @FormatDates(result.ShowEdition)</span>
                                </div>
                                <span class="badge @RecommendationBadge(result.ShowEdition.Recommendation)">@OwnerDecisionLabel(result.ShowEdition.Recommendation)</span>
                            </div>

                            @if (result.ForecastLow is not null || result.ForecastHigh is not null)
                            {
                                <span><strong>@((result.ForecastLow ?? 0).ToString("C0"))–@((result.ForecastHigh ?? 0).ToString("C0"))</strong> forecast</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(result.FitRationale))
                            {
                                <small>@ShortFit(result.FitRationale)</small>
                            }

                            <div class="settings-actions mt-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRecordAsync(result.ShowEditionId)">Open record</button>
                                <button class="btn btn-sm @(selected ? "btn-success" : "btn-outline-success")" @onclick="() => ToggleSelectionResult(result)">
                                    @(selected ? "Selected" : "Select show")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn btn-success mt-3"
                        disabled="@(_calendarSelectedEditionIds.Count == 0)"
                        @onclick="OfferCalendarSelectionsAsync">
                    Offer selected to @DiscoveryVendorLabel()
                </button>
            }
        </section>
    }
}
else
{
    <div class="showarm-workspace mt-3">
        <aside class="shows-card showarm-sidebar">
            <div class="shows-card-head"><div><h2>Show Records</h2><p>@_editions.Count permanent 2027 records · every owner decision stays in memory</p></div><button class="btn btn-primary btn-sm" @onclick="StartNewShow">+ Add show</button></div>
            <div class="mb-3">
                <label class="form-label mb-1">Month</label>
                <select class="form-select form-select-sm" @bind="_recordsMonth">
                    <option value="0">All months</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2027,m,1).ToString("MMMM"))</option>
                    }
                    <option value="13">Dates TBD</option>
                </select>
                <label class="form-label mt-2 mb-1">Search</label>
                <input class="form-control form-control-sm" @bind="_recordSearch" @bind:event="oninput" placeholder="Show, city, or state" />
                <small class="text-body-secondary">@FilteredRecordEditions().Count() records shown</small>
            </div>
            @if (!_editions.Any())
            {
                <p class="text-body-secondary">No shows yet. Add the first 2027 candidate.</p>
            }
            else
            {
                @foreach (var edition in FilteredRecordEditions())
                {
                    <button class="showarm-show-row @(edition.Id == _selectedEditionId ? "active" : "")" @onclick="() => SelectEditionAsync(edition.Id)">
                        <strong>@edition.ShowEvent.Name</strong>
                        <span>@edition.ShowEvent.City, @edition.ShowEvent.State</span>
                        <small>@FormatDates(edition) · @OwnerDecisionLabel(edition.Recommendation)</small>
                    </button>
                }
            }
        </aside>

        <main class="showarm-main">
            @if (_creatingShow)
            {
                <section class="shows-card">
                    <div class="shows-card-head"><div><h2>Add show record</h2><p>Add a known show directly to the Control App. Scout will eventually own discovery and research.</p></div><button class="btn btn-outline-secondary btn-sm" @onclick="CancelNewShow">Cancel</button></div>
                    <div class="showarm-form-grid">
                        <label>Show name<input class="form-control" @bind="_newShow.Name" placeholder="Required" /></label>
                        <label>City<input class="form-control" @bind="_newShow.City" placeholder="If known" /></label>
                        <label>State<input class="form-control" @bind="_newShow.State" placeholder="If known" /></label>
                        <label>Website / application / post<input class="form-control" @bind="_newShow.WebsiteUrl" placeholder="Optional lead URL" /></label>
                    </div>
                    <label class="mt-3">Notes<textarea class="form-control" rows="3" @bind="_newShow.Notes" placeholder="Vendor recommendation, known history, why this record matters…"></textarea></label>
                    <button class="btn btn-primary mt-3" @onclick="CreateShowAsync">Add show record</button>
                </section>
            }
            else if (_selected is null)
            {
                <section class="shows-card"><h2>Select a show record</h2><p class="text-body-secondary mb-0">Choose a show at left to view its operational history, files, application information, and owner decision.</p></section>
            }
            else
            {
                <section class="shows-card showarm-title-card">
                    <div>
                        <p class="shows-eyebrow">2027 show record</p>
                        <h2>@_selected.ShowEvent.Name</h2>
                        <p>@_selected.ShowEvent.City, @_selected.ShowEvent.State · @FormatDates(_selected)</p>
                    </div>
                    <div class="showarm-title-actions">
                        <span class="badge @RecommendationBadge(_selected.Recommendation)">@OwnerDecisionLabel(_selected.Recommendation)</span>
                        <span class="badge text-bg-light">Evidence @_evidence.Count</span>
                    </div>
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head">
                        <div>
                            <h2>Show pool decision</h2>
                            <p>This is Jaime's operational decision. It controls whether this show appears when selecting placements. It is not a research score.</p>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveEditionAsync">Save decision</button>
                    </div>
                    <div class="showarm-form-grid">
                        <label>Decision
                            <select class="form-select" @bind="_selected.Recommendation">
                                <option value="OWNER_UNCLASSIFIED">UNCLASSIFIED</option>
                                <option value="OWNER_APPROVE">APPROVE — actively show it</option>
                                <option value="OWNER_MAYBE">MAYBE — show only when no approved choice fits</option>
                                <option value="OWNER_DISMISS">DISMISS — retain, normally suppress</option>
                                <option value="OWNER_NO">NO — permanent memory, never recommend</option>
                            </select>
                        </label>
                    </div>
                    <div class="alert alert-light mt-3 mb-0">
                        <strong>@OwnerDecisionLabel(_selected.Recommendation):</strong> @OwnerDecisionExplanation(_selected.Recommendation)
                    </div>
                </section>

                <section class="shows-card mt-3">
                    @{
                        var showPrimary = CurrentAssignment(_selected.Id);
                        var showBacker = BackerAssignment(_selected.Id);
                    }
                    <div class="shows-card-head">
                        <div>
                            <h2>Show staffing</h2>
                            <p>The primary vendor and backer belong to this show occurrence. Open the show and you can always see who is responsible for it.</p>
                        </div>
                        @if (showPrimary is not null && IsVendorAcceptedAssignment(showPrimary))
                        {
                            <button class="btn btn-sm btn-dark" @onclick="() => OpenBackerPanel(_selected.Id)">@(showBacker is null ? "Assign backer" : "Manage backer")</button>
                        }
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">PRIMARY VENDOR</small>
                                @if (showPrimary is null)
                                {
                                    <strong>Not assigned</strong>
                                    <div class="text-body-secondary small">Assign the primary vendor from Approved Shows.</div>
                                }
                                else
                                {
                                    <strong>@showPrimary.ShowVendorProfile.VendorName</strong>
                                    <div><span class="badge @AssignmentBadge(showPrimary.Status)">@AssignmentLabel(showPrimary)</span></div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">BACKER</small>
                                @if (showBacker is null)
                                {
                                    <strong>None assigned</strong>
                                    @if (showPrimary is not null && IsVendorAcceptedAssignment(showPrimary))
                                    {
                                        <div class="text-body-secondary small">Optional. Assign one here when this show needs support.</div>
                                    }
                                }
                                else
                                {
                                    <strong>@showBacker.ShowVendorProfile.VendorName</strong>
                                    <div class="text-body-secondary small">@BackerTermsLabel(showBacker)</div>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_backerEditionId == _selected.Id)
                    {
                        <div class="border rounded p-3 mt-3">
                            <div class="d-flex justify-content-between gap-2 align-items-start">
                                <div>
                                    <strong>Backer assignment for @_selected.ShowEvent.Name</strong>
                                    <div class="text-body-secondary small">This assignment stays with this show, so the primary vendor and backer are visible together everywhere the show is managed.</div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseBackerPanel">Close</button>
                            </div>
                            @if (showBacker is not null)
                            {
                                <div class="alert alert-light mt-3 mb-0">
                                    <strong>@showBacker.ShowVendorProfile.VendorName</strong> · @BackerTermsLabel(showBacker)
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RemoveBackerAsync(showBacker.Id)">Remove backer</button>
                                </div>
                            }
                            @if (showPrimary is null || !IsVendorAcceptedAssignment(showPrimary))
                            {
                                <div class="alert alert-warning mt-3 mb-0">The primary vendor must accept the show before a backer is assigned.</div>
                            }
                            else
                            {
                                <div class="showarm-form-grid mt-3">
                                    <label>Backer
                                        <select class="form-select" @bind="_backerVendorId">
                                            <option value="">Choose eligible backer</option>
                                            @foreach (var v in EligibleBackers(_selected, showPrimary.ShowVendorProfileId))
                                            {
                                                <option value="@v.Id">@v.VendorName</option>
                                            }
                                        </select>
                                    </label>
                                    <label>Backer commission %
                                        <input type="number" min="0" max="100" step="0.5" class="form-control" @bind="_backerRate" />
                                    </label>
                                    <label>Paid from
                                        <select class="form-select" @bind="_backerPaidFrom">
                                            <option value="BUSINESS">Ancient Innovations / show expense</option>
                                            <option value="PRIMARY_VENDOR_SHARE">Primary vendor's share</option>
                                        </select>
                                    </label>
                                </div>
                                <small class="text-body-secondary d-block mt-2">@BackerPolicyHint(showPrimary.ShowVendorProfile)</small>
                                <button class="btn btn-sm btn-dark mt-2" disabled="@(_backerVendorId is null || _backerRate is null)" @onclick="() => AssignBackerAsync(_selected.Id, showPrimary.ShowVendorProfileId)">Save backer to show</button>
                            }
                        </div>
                    }
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head">
                        <div>
                            <h2>Brain show intelligence</h2>
                            <p>Email Hub is the intake pipe. This is where the show record uses what the Brain collected — emails, attachments, maps, packets, instructions and deadlines across every known year of this show.</p>
                        </div>
                        <span class="badge text-bg-light">Show Intelligence Hub v9.11</span>
                    </div>

                    <div class="shows-metrics showarm-queue-metrics mt-2">
                        <div class="shows-card"><span>Related emails</span><strong>@_brainEmails.Count</strong></div>
                        <div class="shows-card"><span>Saved documents</span><strong>@_brainDocuments.Count</strong></div>
                        <div class="shows-card"><span>Maps / layouts</span><strong>@BrainMapCount</strong></div>
                        <div class="shows-card"><span>Needs attention</span><strong>@BrainAttentionCount</strong></div>
                    </div>

                    @if (BrainAttentionCount > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>@BrainAttentionCount show email@(BrainAttentionCount == 1 ? "" : "s") still need a decision or review.</strong>
                            They are shown first below; informational mail stays out of your way.
                        </div>
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h3 class="h5">Key dates + operations</h3>
                                <div class="d-grid gap-2">
                                    <div><small class="text-muted d-block">APPLICATION DEADLINE</small><strong>@FormatDate(_selected.ApplicationDeadline)</strong></div>
                                    <div><small class="text-muted d-block">ACCEPTANCE</small><strong>@FormatDate(_selected.AcceptanceDate)</strong></div>
                                    <div><small class="text-muted d-block">BOOTH PAYMENT DEADLINE</small><strong>@FormatDate(_selected.BoothPaymentDeadline)</strong></div>
                                    @if(!string.IsNullOrWhiteSpace(_selected.SetupDetails)){<div><small class="text-muted d-block">SETUP / LOAD-IN</small><span>@_selected.SetupDetails</span></div>}
                                    @if(!string.IsNullOrWhiteSpace(_selected.ParkingDetails)){<div><small class="text-muted d-block">PARKING / CART-IN</small><span>@_selected.ParkingDetails</span></div>}
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h3 class="h5">Organizer / sender trail</h3>
                                @if (BrainSenders.Count == 0)
                                {
                                    <p class="text-body-secondary mb-0">No show-email contacts captured yet.</p>
                                }
                                else
                                {
                                    @foreach(var sender in BrainSenders)
                                    {
                                        <div class="border-top py-2"><span>@sender</span></div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-xl-6">
                            <h3 class="h5 mt-3">Documents + attachments</h3>
                            @if (_brainDocuments.Count == 0)
                            {
                                <p class="text-body-secondary">No saved show documents yet. Email attachments routed to this show will appear here automatically.</p>
                            }
                            else
                            {
                                <div class="showarm-evidence-list">
                                    @foreach(var doc in _brainDocuments.Take(16))
                                    {
                                        <div class="showarm-evidence-item">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>@doc.Title</strong>
                                                <span class="badge text-bg-light">@FormatEnum(doc.DocumentType)</span>
                                            </div>
                                            <small>@(doc.AppliesToYear?.ToString() ?? "Year unknown") @if(!string.IsNullOrWhiteSpace(doc.Notes)){<text> · @doc.Notes</text>}</small>
                                            <div class="settings-actions mt-2">
                                                @if(!string.IsNullOrWhiteSpace(doc.StoredPath)){<a class="btn btn-sm btn-outline-primary" href="@doc.StoredPath" target="_blank">@(doc.DocumentType == "MAP" ? "Open map" : "Open document")</a>}
                                                @if(!string.IsNullOrWhiteSpace(doc.SourceUrl)){<a class="btn btn-sm btn-outline-secondary" href="@doc.SourceUrl" target="_blank">Source</a>}
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-xl-6">
                            <h3 class="h5 mt-3">Show email trail</h3>
                            @if (_brainEmails.Count == 0)
                            {
                                <p class="text-body-secondary">No routed show emails yet.</p>
                            }
                            else
                            {
                                <div class="showarm-evidence-list">
                                    @foreach(var mail in BrainEmailDisplay)
                                    {
                                        <div class="showarm-evidence-item">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>@(mail.Subject ?? "(no subject)")</strong>
                                                <span class="badge @(mail.Status == "NEEDS_YOU" ? "text-bg-danger" : mail.Status == "NEEDS_REVIEW" ? "text-bg-warning" : "text-bg-light")">@FormatEnum(mail.Status)</span>
                                            </div>
                                            <small>@FormatEmailDate(mail) · @mail.FromAddress</small>
                                            @if(!string.IsNullOrWhiteSpace(mail.BrainSummary)){<span>@mail.BrainSummary</span>}
                                            @if(!string.IsNullOrWhiteSpace(mail.AttachmentSummary)){<small><strong>Attachments:</strong> @mail.AttachmentSummary</small>}
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head">
                        <div><h2>Shared show notes</h2><p>Vendor, owner and Brain observations live with the show. Notes flagged Marketing useful are ready for the Marketing Arm to consume later.</p></div>
                        <span class="badge text-bg-light">@_showNotes.Count note@(_showNotes.Count == 1 ? "" : "s")</span>
                    </div>
                    @if (_showNotes.Count == 0)
                    {
                        <p class="text-body-secondary mb-3">No shared show notes yet. Vendor notes added from Vendor Shows will appear here automatically.</p>
                    }
                    else
                    {
                        <div class="showarm-evidence-list mb-3">
                            @foreach (var note in _showNotes.OrderByDescending(x => x.CreatedAt).Take(20))
                            {
                                <div class="showarm-evidence-item">
                                    <div class="d-flex justify-content-between gap-2"><strong>@(note.CreatedBy ?? FormatEnum(note.NoteType))</strong><div><span class="badge text-bg-light">@note.ShowEdition.Year</span>@if (note.UseForMarketing) { <span class="badge text-bg-info ms-1">Marketing useful</span> }</div></div>
                                    <span>@note.NoteText</span><small>@note.CreatedAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</small>
                                </div>
                            }
                        </div>
                    }
                    <div class="border rounded p-3">
                        <textarea class="form-control" rows="3" @bind="_newShowNote" placeholder="Add owner/show intelligence: placement, buyer behavior, best sellers, organizer insight, setup, weather, what to repeat next year…"></textarea>
                        <div class="d-flex gap-3 align-items-center flex-wrap mt-2">
                            <label class="form-check mb-0"><input class="form-check-input" type="checkbox" @bind="_newShowNoteMarketing" /> Marketing useful</label>
                            <button class="btn btn-outline-primary btn-sm" @onclick="AddShowNoteAsync" disabled="@string.IsNullOrWhiteSpace(_newShowNote)">Add shared show note</button>
                        </div>
                    </div>
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Application</h2><p>The Brain finds where the application lives and tracks it here. Submission and spending stay human-controlled.</p></div><button class="btn btn-primary btn-sm" @onclick="SaveApplicationAsync">Save application</button></div>
                    <div class="showarm-form-grid">
                        <label>Platform<select class="form-select" @bind="_application.Platform"><option value="">Unknown / direct</option><option>ZAPPlication</option><option>Eventeny</option><option>CaFE</option><option>EntryThingy</option><option>ArtCall</option><option>ShowSubmit</option><option>Direct</option></select></label>
                        <label>Application status<input class="form-control" @bind="_application.ExternalStatus" placeholder="Not open / ready / submitted / invited…" /></label>
                        <label>Application URL<input class="form-control" @bind="_application.ApplicationUrl" placeholder="Direct application link" /></label>
                        <label>External application ID<input class="form-control" @bind="_application.ExternalApplicationId" /></label>
                    </div>
                    <label class="mt-3">Next action<input class="form-control" @bind="_application.NextAction" placeholder="Apply, wait for opening, verify fee, watch for decision…" /></label>
                    <div class="d-flex gap-2 flex-wrap align-items-center mt-3">
                        @if (!string.IsNullOrWhiteSpace(_application.ApplicationUrl)) { <a class="btn btn-outline-dark btn-sm" href="@_application.ApplicationUrl" target="_blank" rel="noopener">Open @_application.Platform application</a> }
                        <span class="text-body-secondary small">Last checked: @(_application.LastCheckedAt?.LocalDateTime.ToString("g") ?? "not checked yet")</span>
                    </div>
                </section>

                

                

                

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Core show facts</h2><p>Facts stay separate from conclusions.</p></div><button class="btn btn-primary btn-sm" @onclick="SaveEditionAsync">Save facts</button></div>
                    <div class="showarm-form-grid">
                        <label>Jury fee<input type="number" step="0.01" class="form-control" @bind="_selected.JuryFee" /></label>
                        <label>Booth fee<input type="number" step="0.01" class="form-control" @bind="_selected.BoothFee" /></label>
                        <label>Claimed attendance<input type="number" class="form-control" @bind="_selected.ClaimedAttendance" /></label>
                        <label>Verified/current attendance<input type="number" class="form-control" @bind="_selected.VerifiedAttendance" /></label>
                        <label>Total vendors<input type="number" class="form-control" @bind="_selected.VendorCount" /></label>
                        <label>Handmade vendors<input type="number" class="form-control" @bind="_selected.HandmadeVendorCount" /></label>
                        <label>Application opens<input type="date" class="form-control" @bind="_selected.ApplicationOpenDate" /></label>
                        <label>Application deadline<input type="date" class="form-control" @bind="_selected.ApplicationDeadline" /></label>
                    </div>
                    @if (AttendanceVendorAnomaly)
                    {
                        <div class="alert alert-warning mt-3 mb-0"><strong>Research flag:</strong> attendance and vendor count do not make sense together. Verify before recommending this show.</div>
                    }
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Market + buyer fit</h2><p>Qualified buyers matter more than raw attendance.</p></div><button class="btn btn-primary btn-sm" @onclick="SaveEditionAsync">Save market</button></div>
                    <div class="showarm-form-grid">
                        <label>Audience origin<select class="form-select" @bind="_selected.AudienceOrigin"><option>UNKNOWN</option><option>LOCAL</option><option>REGIONAL</option><option>DESTINATION</option><option>TOURIST</option><option>MIXED</option></select></label>
                        <label>Local spending power<select class="form-select" @bind="_selected.LocalSpendingPower"><option>UNKNOWN</option><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>VERY HIGH</option></select></label>
                        <label>Destination tourism<select class="form-select" @bind="_selected.DestinationTourism"><option>UNKNOWN</option><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>VERY HIGH</option></select></label>
                        <label>Shopping intent<select class="form-select" @bind="_selected.ShoppingIntent"><option>UNKNOWN</option><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>VERY HIGH</option><option>EXCEPTIONAL</option></select></label>
                        <label>Marketplace quality<select class="form-select" @bind="_selected.MarketplaceQuality"><option>UNKNOWN</option><option>POOR</option><option>MIXED</option><option>GOOD</option><option>EXCELLENT</option></select></label>
                        <label>Vendor saturation<select class="form-select" @bind="_selected.VendorSaturation"><option>UNKNOWN</option><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>EXTREME</option></select></label>
                        <label>Event health<select class="form-select" @bind="_selected.EventHealth"><option>UNKNOWN</option><option>GROWING</option><option>STABLE</option><option>DECLINING</option><option>RECOVERING</option></select></label>
                        <label>Market overlap<select class="form-select" @bind="_selected.CannibalizationRisk"><option>UNKNOWN</option><option>NONE</option><option>LOW</option><option>MODERATE</option><option>HIGH</option></select></label>
                    </div>
                    <div class="showarm-form-grid two-col mt-3">
                        <label>Current disruptions<textarea class="form-control" rows="3" @bind="_selected.CurrentDisruptions" placeholder="Construction, venue move, promoter change, bad publicity…"></textarea></label>
                        <label>Future location request<textarea class="form-control" rows="3" @bind="_selected.FutureLocationRequest" placeholder="What should Melissa request on the application?"></textarea></label>
                    </div>
                    @if (ShopperDensityWarning) { <div class="alert alert-warning mt-3 mb-0"><strong>Shopper-density flag:</strong> vendor count is high relative to verified attendance. Check shopper fatigue, route completion and wallet depletion.</div> }
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Show intelligence</h2><p>Marketing, maps, traffic flow, weather, security and operational reality.</p></div><button class="btn btn-primary btn-sm" @onclick="SaveEditionAsync">Save intelligence</button></div>
                    <div class="showarm-form-grid two-col">
                        <label>Show hours<textarea class="form-control" rows="3" @bind="_selected.ShowHours"></textarea></label>
                        <label>Setup / load-in<textarea class="form-control" rows="3" @bind="_selected.SetupDetails"></textarea></label>
                        <label>Marketing intelligence<textarea class="form-control" rows="4" @bind="_selected.MarketingIntel" placeholder="How much promotion? How early? Social, radio, TV, tourism, sponsors…"></textarea></label>
                        <label>Map / placement intelligence<textarea class="form-control" rows="4" @bind="_selected.LocationIntel" placeholder="Main flow, entrances, food/stage, dead zones, preferred booth area…"></textarea></label>
                        <label>Weather risk<textarea class="form-control" rows="3" @bind="_selected.WeatherIntel" placeholder="Heat, rain, wind, historical event-weekend risk…"></textarea></label>
                        <label>Overnight security<textarea class="form-control" rows="3" @bind="_selected.SecurityDetails"></textarea></label>
                        <label>Previous-year map URL<input class="form-control" @bind="_selected.MapUrl" /></label>
                        <label>Parking / cart-in<textarea class="form-control" rows="2" @bind="_selected.ParkingDetails"></textarea></label>
                    </div>
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Map library</h2><p>Keep every year's map. Old maps are placement intelligence, not disposable files.</p></div></div>
                    <div class="showarm-form-grid">
                        <label>Map title<input class="form-control" @bind="_newMap.Title" placeholder="2027 vendor map" /></label>
                        <label>Map type<select class="form-select" @bind="_newMap.MapType"><option>VENDOR_MAP</option><option>BOOTH_MAP</option><option>PARKING_SETUP</option><option>TRAFFIC_LAYOUT</option><option>OTHER</option></select></label>
                        <label>Location<input class="form-control" @bind="_newMap.LocationName" placeholder="Rockville / Bridgeton" /></label>
                        <label>Zone<input class="form-control" @bind="_newMap.ZoneName" placeholder="Courthouse / Mill handmade area" /></label>
                        <label>Our booth<input class="form-control" @bind="_newMap.BoothNumber" /></label>
                        <label>Placement grade<input class="form-control" @bind="_newMap.PlacementGrade" placeholder="A-, B+…" /></label>
                        <label>Qualified traffic<select class="form-select" @bind="_newMap.QualifiedTraffic"><option>UNKNOWN</option><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>VERY HIGH</option></select></label>
                        <label>Wallet position<select class="form-select" @bind="_newMap.WalletPosition"><option>UNKNOWN</option><option>EARLY</option><option>MIDDLE</option><option>LATE</option></select></label>
                    </div>
                    <div class="showarm-form-grid two-col mt-3">
                        <label>Primary shopper route<textarea class="form-control" rows="2" @bind="_newMap.PrimaryRoute"></textarea></label>
                        <label>Obstructions / dead zones<textarea class="form-control" rows="2" @bind="_newMap.Obstructions"></textarea></label>
                        <label>Preferred areas<textarea class="form-control" rows="2" @bind="_newMap.PreferredAreas"></textarea></label>
                        <label>Avoid areas<textarea class="form-control" rows="2" @bind="_newMap.AvoidAreas"></textarea></label>
                    </div>
                    <div class="mt-3"><InputFile OnChange="HandleMapFileAsync" accept=".pdf,.png,.jpg,.jpeg" /></div>
                    <button class="btn btn-outline-primary mt-3" @onclick="SaveMapAsync">Save map record</button>
                    @if (_maps.Count > 0) {
                        <div class="showarm-map-grid mt-3">
                        @foreach (var map in _maps) {
                            <div class="showarm-evidence-item"><strong>@map.Year · @map.Title</strong><span>@map.LocationName @if(!string.IsNullOrWhiteSpace(map.ZoneName)){<text> / @map.ZoneName</text>} · Booth @map.BoothNumber · @map.PlacementGrade</span><small>@map.QualifiedTraffic traffic · @map.WalletPosition wallet position</small>@if(!string.IsNullOrWhiteSpace(map.StoredFileName)){<a href="@(ShowFiles.MapUrl(map.StoredFileName!))" target="_blank">Open saved map</a>}</div>
                        }
                        </div>
                    }
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Evidence locker</h2><p>Preserve the facts and source history attached to this show. Scout will add to this record later.</p></div></div>
                    <div class="showarm-evidence-entry">
                        <select class="form-select" @bind="_newEvidence.EvidenceType">
                            <option>ATTENDANCE</option><option>VENDOR_REPORT</option><option>VENDOR_QUALITY</option><option>MARKETING</option><option>MAP_PLACEMENT</option><option>WEATHER</option><option>PROMOTER</option><option>MEDIA</option><option>GENERAL</option>
                        </select>
                        <input class="form-control" placeholder="Source name" @bind="_newEvidence.SourceName" />
                        <input class="form-control" placeholder="Source URL" @bind="_newEvidence.SourceUrl" />
                        <select class="form-select" @bind="_newEvidence.Reliability"><option>HIGH</option><option>MEDIUM</option><option>LOW</option><option>UNRATED</option></select>
                        <select class="form-select" @bind="_newEvidence.Sentiment"><option>POSITIVE</option><option>NEUTRAL</option><option>NEGATIVE</option></select>
                        <textarea class="form-control evidence-finding" rows="2" placeholder="What did we actually learn? Use numbers/facts when possible." @bind="_newEvidence.Finding"></textarea>
                        <button class="btn btn-outline-primary" @onclick="AddEvidenceAsync">Add evidence</button>
                    </div>
                    @if (_evidence.Count == 0)
                    {
                        <p class="text-body-secondary mt-3 mb-0">No evidence recorded yet.</p>
                    }
                    else
                    {
                        <div class="showarm-evidence-list mt-3">
                            @foreach (var ev in _evidence)
                            {
                                <div class="showarm-evidence-item">
                                    <div><span class="badge text-bg-light">@ev.EvidenceType</span> <span class="badge @SentimentBadge(ev.Sentiment)">@ev.Sentiment</span> <small>@ev.Reliability confidence</small></div>
                                    <strong>@ev.Finding</strong>
                                    <span>@ev.SourceName @if(!string.IsNullOrWhiteSpace(ev.SourceUrl)){<text> · @ev.SourceUrl</text>}</span>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="shows-card mt-3">
                    <div class="shows-card-head"><div><h2>Pre-show forecast</h2><p>Freeze the prediction before the event. It is never rewritten after actual sales are known.</p></div></div>
                    <div class="showarm-form-grid forecast-grid">
                        <label>Plausible low<input type="number" step="100" class="form-control" @bind="_forecastLow" /></label>
                        <label>Expected gross<input type="number" step="100" class="form-control" @bind="_forecastExpected" /></label>
                        <label>Plausible high<input type="number" step="100" class="form-control" @bind="_forecastHigh" /></label>
                        <label>Production target<input type="number" step="100" class="form-control" @bind="_productionTarget" /></label>
                        <label>Confidence<select class="form-select" @bind="_forecastConfidence"><option>LOW</option><option>MEDIUM</option><option>HIGH</option></select></label>
                        <label>$10K+ potential<select class="form-select" @bind="_tenKPotential"><option>NO</option><option>POSSIBLE</option><option>SUPPORTED</option><option>STRONGLY SUPPORTED</option></select></label>
                        <label>Stockout risk<select class="form-select" @bind="_stockoutRisk"><option>LOW</option><option>MODERATE</option><option>HIGH</option><option>EXTREME</option></select></label>
                    </div>
                    <label class="mt-3">Evidence summary<textarea class="form-control" rows="3" @bind="_forecastSummary" placeholder="Why does the evidence support this range?"></textarea></label>
                    <div class="showarm-form-grid two-col mt-3">
                        <label>Top positive factors<textarea class="form-control" rows="2" @bind="_positiveFactors"></textarea></label>
                        <label>Top negative factors<textarea class="form-control" rows="2" @bind="_negativeFactors"></textarea></label>
                        <label>Unknowns<textarea class="form-control" rows="2" @bind="_forecastUnknowns"></textarea></label>
                        <label>Assumptions<textarea class="form-control" rows="2" @bind="_forecastAssumptions"></textarea></label>
                    </div>
                    <button class="btn btn-dark mt-3" @onclick="FreezeForecastAsync">Freeze forecast</button>
                    @if (_forecasts.Count > 0)
                    {
                        <div class="showarm-forecast-history mt-3">
                            @foreach (var f in _forecasts)
                            {
                                <div><strong>@((f.ExpectedGross ?? ((f.ForecastLow + f.ForecastHigh) / 2)).ToString("C0")) expected · @f.ForecastLow.ToString("C0")–@f.ForecastHigh.ToString("C0")</strong><span>Production @((f.ProductionTarget ?? f.ForecastHigh).ToString("C0")) · @f.Confidence · frozen @f.FrozenAt.LocalDateTime.ToString("g")</span><small>@f.EvidenceSummary</small></div>
                            }
                        </div>
                    }
                </section>
            }
        </main>
    </div>
}

