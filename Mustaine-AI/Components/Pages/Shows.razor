    private int DecisionReadiness
    {
        get
        {
            if (_selected is null) return 0;
            var checks = new[]
            {
                _selected.StartDate is not null,
                _selected.ApplicationDeadline is not null,
                _selected.BoothFee is not null,
                _selected.VerifiedAttendance is not null || HasEvidence("ATTENDANCE"),
                !string.IsNullOrWhiteSpace(_selected.ShowHours) || HasEvidence("OPERATIONS"),
                HasEvidence("PROMOTER") || !string.IsNullOrWhiteSpace(_selected.ShowEvent?.PromoterName),
                HasEvidence("RESTRICTIONS"),
                HasEvidence("TRAVEL") || HasEvidence("LODGING"),
                _brainDocuments.Count > 0 || _evidence.Count > 0,
                !string.Equals(_selected.ShoppingIntent,"UNKNOWN",StringComparison.OrdinalIgnoreCase)
            };
            return (int)Math.Round(checks.Count(x=>x) * 100d / checks.Length);
        }
    }
    private bool HasEvidence(string type) => _evidence.Any(x => string.Equals(x.EvidenceType,type,StringComparison.OrdinalIgnoreCase));
    private int FitScore
    {
        get
        {
            if (_selected is null) return 0;
            var score = 45;
            score += _selected.ShoppingIntent switch { "EXCEPTIONAL"=>20, "VERY HIGH"=>16, "HIGH"=>12, "MODERATE"=>5, "LOW"=>-12, _=>0 };
            score += _selected.MarketplaceQuality switch { "EXCELLENT"=>15, "GOOD"=>10, "MIXED"=>0, "POOR"=>-15, _=>0 };
            score += _selected.LocalSpendingPower switch { "VERY HIGH"=>10, "HIGH"=>7, "MODERATE"=>3, "LOW"=>-7, _=>0 };
            score += _selected.VendorSaturation switch { "LOW"=>8, "MODERATE"=>2, "HIGH"=>-6, "EXTREME"=>-12, _=>0 };
            score += _selected.EventHealth switch { "GROWING"=>7, "STABLE"=>4, "DECLINING"=>-10, "RECOVERING"=>1, _=>0 };
            if (_selected.ShowEvent?.IsHardExcluded == true) score -= 50;
            var ownNeg = _evidence.Count(x=>x.EvidenceType=="OWN_HISTORY" && x.Reliability=="HIGH" && x.Sentiment=="NEGATIVE");
            var ownPos = _evidence.Count(x=>x.EvidenceType=="OWN_HISTORY" && x.Reliability=="HIGH" && x.Sentiment=="POSITIVE");
            score -= Math.Min(45, ownNeg * 20); score += Math.Min(20, ownPos * 8);
            return Math.Clamp(score,0,100);
        }
    }
    private string FinancialProof => _selected is null ? "None" : (_selected.BoothFee is not null && (_selected.VerifiedAttendance is not null || HasEvidence("ATTENDANCE"))) ? "Building" : _selected.BoothFee is not null ? "Fee only" : "Missing";
    private string RiskLabel => _selected is null ? "Unknown" : _selected.ShowEvent?.IsHardExcluded == true ? "BLOCKED" : (_evidence.Count(x=>x.Sentiment=="NEGATIVE" && x.Reliability=="HIGH")>=2 || _selected.EventHealth=="DECLINING") ? "HIGH" : (_selected.VendorSaturation is "HIGH" or "EXTREME" || !string.IsNullOrWhiteSpace(_selected.CurrentDisruptions)) ? "WATCH" : "NORMAL";
    private string DecisionLabel => _selected is null ? "UNPROVEN" : _selected.ShowEvent?.IsHardExcluded == true ? "REJECT" : DecisionReadiness >= 80 && FitScore >= 70 && RiskLabel != "HIGH" ? "APPLY READY" : DecisionReadiness >= 55 ? "RESEARCH MORE" : "NOT READY";
    private string DecisionBadge => DecisionLabel switch { "APPLY READY"=>"text-bg-success", "REJECT"=>"text-bg-danger", "RESEARCH MORE"=>"text-bg-warning", _=>"text-bg-secondary" };
    private string DecisionStrengths
    {
        get
        {
            if (_selected is null) return "No show selected.";
            var x = new List<string>();
            if (_selected.StartDate is not null) x.Add("dates"); if (_selected.ApplicationDeadline is not null) x.Add("deadline"); if (_selected.BoothFee is not null) x.Add("booth fee"); if (_selected.VerifiedAttendance is not null || HasEvidence("ATTENDANCE")) x.Add("attendance evidence"); if (HasEvidence("PROMOTER")) x.Add("organizer source"); if (HasEvidence("RESTRICTIONS")) x.Add("vendor rules"); if (HasEvidence("TRAVEL") || HasEvidence("LODGING")) x.Add("travel/lodging evidence"); if (_brainDocuments.Count>0) x.Add("saved packet/map");
            return x.Count == 0 ? "No decision facts verified yet." : string.Join(", ",x) + ".";
        }
    }
    private string DecisionGaps
    {
        get
        {
            if (_selected is null) return "No show selected.";
            var x = new List<string>();
            if (_selected.StartDate is null) x.Add("2027 dates"); if (_selected.ApplicationDeadline is null) x.Add("application deadline"); if (_selected.BoothFee is null) x.Add("booth fee"); if (_selected.VerifiedAttendance is null && !HasEvidence("ATTENDANCE")) x.Add("attendance proof"); if (!HasEvidence("RESTRICTIONS")) x.Add("vendor restrictions"); if (!HasEvidence("TRAVEL") && !HasEvidence("LODGING")) x.Add("travel/hotel burden"); if (string.IsNullOrWhiteSpace(_selected.ShowHours) && !HasEvidence("OPERATIONS")) x.Add("show hours/operations");
            return x.Count == 0 ? "No major decision gaps detected." : string.Join(", ",x) + ".";
        }
    }
    private string DecisionExplanation => _selected is null ? "Select a show." : _selected.ShowEvent?.IsHardExcluded == true ? $"Hard exclusion: {_selected.ShowEvent.ExclusionReason}" : HasNegativeOwnHistory ? $"{DecisionLabel}. Ancient Innovations' own history contains negative high-confidence evidence; that evidence is weighted above generic web claims. Readiness {DecisionReadiness}%, fit {FitScore}/100, risk {RiskLabel}." : $"{DecisionLabel}. Readiness {DecisionReadiness}%, fit {FitScore}/100, risk {RiskLabel}. The Brain will not call a show apply-ready until the core operational and financial evidence is present.";
    private bool HasNegativeOwnHistory => _evidence.Any(x=>x.EvidenceType=="OWN_HISTORY" && x.Reliability=="HIGH" && x.Sentiment=="NEGATIVE");

    private string ResearchVerdict => _evidence.Count == 0 ? "UNPROVEN" : _evidence.Count(x=>x.Sentiment=="NEGATIVE" && x.Reliability=="HIGH") >= 2 ? "HIGH RISK" : _evidence.Count(x=>x.Sentiment=="POSITIVE" && x.Reliability=="HIGH") >= 3 ? "BUILDING CASE" : "RESEARCHING";
    private string VerdictBadge => ResearchVerdict switch { "HIGH RISK" => "text-bg-danger", "BUILDING CASE" => "text-bg-success", "RESEARCHING" => "text-bg-warning", _ => "text-bg-secondary" };
    private static string SentimentBadge(string s) => s == "POSITIVE" ? "text-bg-success" : s == "NEGATIVE" ? "text-bg-danger" : "text-bg-secondary";
    private ShowApplicationEntity? ApplicationFor(long editionId, long vendorId)
