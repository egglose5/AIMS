@page "/email-hub"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MustaineAI.Data
@using MustaineAI.Services
@inject ShowArmDbContext Db
@inject IBrainEmailIntakeService BrainEmail
@inject IConfiguration Config
@inject ApplicationDbContext BrainDb
<PageTitle>Email Hub</PageTitle>

<div class="shows-hero">
    <p class="shows-eyebrow">Mercury · Ancient Innovations Brain</p>
    <h1>Email Hub</h1>
    <p>If Jaime doesn't need to make a decision, the Brain should not create work. Gmail remains the source record; Gmail remains untouched as the source record; B7 lets you resolve the Brain's internal routing/review queue.</p>
    <small class="text-muted">Current Email Brain triage v9.10.1 — informational mail is handled quietly; stored current mail can be reprocessed whenever routing improves.</small>
</div>
@if(_tab=="history")
{
    <small class="text-muted d-block mt-2">Historical consolidation v9.8.6 — review one show identity at a time; duplicate emails and years are grouped into one decision.</small>
}

<details class="shows-card mt-3" data-b10="EMAIL_SYSTEM_TOOLS">
    <summary><strong>Email system & imports</strong> <span class="text-body-secondary">Direct intake, inbox scan, historical archives</span></summary>
    <div class="mt-3">
<section class="shows-card mt-3">
    <div class="shows-card-head">
        <div>
            <h2>AI Brain direct intake</h2>
            <p><strong>@IntakeAddress</strong> is the deliberate system/vendor address. This check imports only messages actually delivered to that address.</p>
        </div>
        <button class="btn btn-primary" @onclick="ImportDirectAsync" disabled="@_busy">@(_busyScope=="direct"?"Checking AI Brain…":"Check AI Brain Address")</button>
    </div>
</section>

<section class="shows-card mt-3">
    <div class="shows-card-head">
        <div>
            <h2>Business inbox feed</h2>
            <p>Scans your configured business inboxes, routes useful information, and leaves Gmail untouched. Use this when you want the Brain to process your normal business email.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap justify-content-end">
            <button class="btn btn-outline-dark" @onclick="BackfillAttachmentsAsync" disabled="@_busy">@(_busyScope=="attachments"?"Backfilling attachments…":"Backfill Attachments")</button>
            <button class="btn btn-outline-dark" @onclick="ReprocessCurrentAsync" disabled="@_busy">@(_busyScope=="reprocess"?"Reprocessing…":"Reprocess Current Mail")</button>
            <button class="btn btn-dark" @onclick="ImportBusinessAsync" disabled="@_busy">@(_busyScope=="business"?"Reading inboxes…":"Check Business Inboxes")</button>
        </div>
    </div>
    @if(!string.IsNullOrWhiteSpace(_message)){<div class="alert alert-secondary mt-2">@_message</div>}
</section>

<section class="shows-card mt-3">
    <div class="shows-card-head">
        <div>
            <h2>Historical email intelligence</h2>
            <p>The TS Artisans archive and pre-Gmail Ancient Innovations archive are bundled with this pass. Preview first; historical mail becomes business memory and show evidence, not thousands of new daily tasks.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark" @onclick="PreviewHistoryAsync" disabled="@_busy">@(_busyScope=="history-preview"?"Analyzing history…":"Preview Historical Archives")</button>
            <button class="btn btn-dark" @onclick="ImportHistoryAsync" disabled="@(_busy || _historyPreview is null)">@(_busyScope=="history-import"?"Importing intelligence…":"Import Historical Intelligence")</button>
        </div>
    </div>
    @if(_historyPreview is not null)
    {
        <div class="row g-2 mt-2">
            <div class="col"><div class="shows-card"><strong>@_historyPreview.Total</strong><span>Historical emails</span></div></div>
            <div class="col"><div class="shows-card"><strong>@_historyPreview.ShowRelated</strong><span>Show-related</span></div></div>
            <div class="col"><div class="shows-card"><strong>@_historyPreview.ShowMatched</strong><span>Show/year matched</span></div></div>
            <div class="col"><div class="shows-card"><strong>@_historyPreview.Uncertain</strong><span>Historical match review</span></div></div>
            <div class="col"><div class="shows-card"><strong>@_historyPreview.Financial</strong><span>Financial</span></div></div>
            <div class="col"><div class="shows-card"><strong>@_historyPreview.Junk</strong><span>Low-value/junk</span></div></div>
        </div>
        <div class="alert alert-secondary mt-2 mb-0">@_historyPreview.Message</div>
    }
</section>


    </div>
</details>

<div class="row g-3 mt-1">
    <div class="col"><div class="shows-card"><strong>@DirectCount</strong><span>Direct AI Brain</span></div></div>
    <div class="col"><div class="shows-card"><strong>@Count("NEEDS_YOU")</strong><span>Need You</span></div></div>
    <div class="col"><div class="shows-card"><strong>@Count("NEEDS_REVIEW")</strong><span>Needs Review</span></div></div>
    <div class="col"><div class="shows-card"><strong>@Count("BRAIN_HANDLED")</strong><span>Brain Handled</span></div></div>
    <div class="col"><div class="shows-card"><strong>@Count("IGNORED")</strong><span>Ignored</span></div></div>
    <div class="col"><div class="shows-card"><strong>@_items.Count(x=>x.UnsubscribeRecommended)</strong><span>Unsubscribe Suggestions</span></div></div>
</div>

<div class="shows-tabs mt-3">
    <button class="@Tab("direct")" @onclick='()=>_tab="direct"'>AI Brain Direct</button>
    <button class="@Tab("needs")" @onclick='()=>_tab="needs"'>Needs You</button>
    <button class="@Tab("review")" @onclick='()=>_tab="review"'>Needs Review</button>
    <button class="@Tab("handled")" @onclick='()=>_tab="handled"'>Brain Handled</button>
    <button class="@Tab("junk")" @onclick='()=>_tab="junk"'>Ignored</button>
    <button data-b92="UNSUBSCRIBE_TAB" class="@Tab("unsubscribe")" @onclick='()=>_tab="unsubscribe"'>Unsubscribe Suggestions</button>
    <button class="@Tab("history")" @onclick='()=>_tab="history"'>Historical Match Review</button>
    <button class="@Tab("all")" @onclick='()=>_tab="all"'>All</button>
</div>

<section class="shows-card mt-3">
    @if(_tab=="history")
    {
        @if(HistoricalGroups.Count==0)
        {
            <div class="showarm-empty"><strong>Nothing in Historical Match Review.</strong><span>The Brain has no unresolved historical show identities waiting for a decision.</span></div>
        }
        else
        {
            <div class="alert alert-info mb-3">
                <strong>@HistoricalReviewCount historical emails consolidated into @HistoricalGroups.Count proposed shows.</strong>
                Review one show identity once; the Brain will attach all matching historical emails to the correct year editions together.
            </div>
            @foreach(var g in HistoricalGroups)
            {
                <div class="showarm-evidence-item mb-4">
                    <div class="d-flex justify-content-between gap-3 align-items-start">
                        <div>
                            <strong class="d-block">@g.ProposedName</strong>
                            <small>@g.Items.Count email@(g.Items.Count==1?"":"s") · years @string.Join(", ",g.Years) · @g.Mailboxes.Count source mailbox@(g.Mailboxes.Count==1?"":"es")</small>
                        </div>
                        <span class="badge text-bg-light">HISTORICAL SHOW GROUP</span>
                    </div>

                    @if(!string.IsNullOrWhiteSpace(g.ExistingShowName))
                    {
                        <div class="alert alert-secondary py-2 mt-2 mb-1"><strong>Possible existing show:</strong> @g.ExistingShowName</div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 mt-2 mb-1"><strong>Proposed historical show:</strong> @g.ProposedName</div>
                    }

                    <div class="row g-2 mt-1">
                        <div class="col-md-4"><div class="border rounded p-2 h-100"><small class="text-muted d-block">YEARS FOUND</small><strong>@string.Join(", ",g.Years)</strong></div></div>
                        <div class="col-md-4"><div class="border rounded p-2 h-100"><small class="text-muted d-block">RELATIONSHIP EVIDENCE</small><strong>@g.RelationshipSummary</strong></div></div>
                        <div class="col-md-4"><div class="border rounded p-2 h-100"><small class="text-muted d-block">SENDERS / ORGANIZERS</small><strong>@g.SenderSummary</strong></div></div>
                    </div>

                    <div class="row g-2 mt-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label mb-1">Use an existing show instead</label>
                            <select class="form-select" value="@SelectedGroupEvent(g)" @onchange="e=>SetSelectedGroupEvent(g,e.Value?.ToString())">
                                <option value="">No existing show selected</option>
                                @foreach(var ev in ExistingShowEvents)
                                {<option value="@ev.Id">@ev.Name</option>}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1">Relationship handling</label>
                            <select class="form-select" value="@SelectedGroupRelationship(g)" @onchange="e=>SetGroupRelationship(g,e.Value?.ToString())">
                                <option value="Brain infer per email">Brain infer per email</option>
                                @foreach(var r in Relationships){<option value="@r">@r for all</option>}
                            </select>
                        </div>
                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                            <button class="btn btn-dark" disabled="@_busy" @onclick="()=>ConsolidateHistoricalGroupAsync(g,false)">Create / consolidate show</button>
                            <button class="btn btn-outline-dark" disabled="@(_busy || SelectedGroupEvent(g) is null)" @onclick="()=>ConsolidateHistoricalGroupAsync(g,true)">Use existing show</button>
                            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="()=>NotOurHistoricalGroupAsync(g)">Not our show</button>
                        </div>
                    </div>

                    <details class="mt-3">
                        <summary><strong>Review @g.Items.Count source email@(g.Items.Count==1?"":"s")</strong></summary>
                        <div class="mt-2">
                            @foreach(var x in g.Items.OrderBy(x=>x.MessageDate??x.ReceivedAt))
                            {
                                <div class="border-top py-2">
                                    <strong>@(x.Subject??"(no subject)")</strong>
                                    <small class="d-block">@((x.MessageDate??x.ReceivedAt).LocalDateTime.ToString("g")) · @x.FromAddress · @InferHistoricalRelationship(x)</small>
                                    @if(!string.IsNullOrWhiteSpace(x.BrainSummary)){<span class="d-block">@x.BrainSummary</span>}
                                </div>
                            }
                        </div>
                    </details>
                </div>
            }
        }
    }
    else
    {
        @if(Visible.Count==0)
        {
            <div class="showarm-empty"><strong>Nothing in this view.</strong><span>@EmptyMessage</span></div>
        }
        @foreach(var x in Visible)
        {
            <div class="showarm-evidence-item mb-3">
                <div class="d-flex justify-content-between gap-3">
                    <strong>@(x.Subject??"(no subject)")</strong>
                    <div class="text-end"><span class="badge text-bg-light">@x.Route</span><small class="d-block text-muted mt-1">@RouteDestination(x.Route)</small></div>
                </div>
                <small>From @x.FromAddress · via @x.MailboxAddress · @(x.MessageDate?.LocalDateTime.ToString("g")??x.ReceivedAt.LocalDateTime.ToString("g"))</small>
                @if(!string.IsNullOrWhiteSpace(x.BrainSummary)){<span>@x.BrainSummary</span>}
                @if(!string.IsNullOrWhiteSpace(x.ActionSummary)){<div class="alert alert-warning py-1 mt-2 mb-1">@x.ActionSummary</div>}
                @if(!string.IsNullOrWhiteSpace(x.AttachmentSummary)){<small><strong>Attachments:</strong> @x.AttachmentSummary</small>}
                @if(x.UnsubscribeRecommended)
                {
                    <div class="alert alert-light py-2 mt-2 mb-0">
                        <strong>Unsubscribe suggested.</strong> The Brain has NOT unsubscribed or changed Gmail.
                        @if(x.IsProtectedSender){<span> Protected sender — automatic unsubscribe prohibited.</span>}else{<span> Review this recommendation before any future action.</span>}
                    </div>
                }
                @if(true) // S12_EMAIL_ACTIONS_ALL_QUEUES
                {
                    <div class="border rounded p-3 mt-2 bg-body-tertiary" data-b93="EMAIL_SNIPPET">
                        @if(!string.IsNullOrWhiteSpace(x.BrainSummary))
                        {
                            <div class="mb-2"><strong>Brain summary:</strong> @x.BrainSummary</div>
                        }
                        <div><strong>Email excerpt:</strong> @EmailExcerpt(x.BodyText)</div>
                        @if(!string.IsNullOrWhiteSpace(x.BodyText))
                        {
                            <details class="mt-2">
                                <summary class="text-body-secondary">Show full email</summary>
                                <div class="mt-2 small" style="white-space: pre-wrap">@x.BodyText</div>
                            </details>
                        }
                    </div>
                    <div class="border rounded p-2 mt-2" data-b7="B7_EMAIL_ACTIONS">
                        <div class="fw-semibold mb-2">What should the Brain do?</div>
                        <small class="text-muted d-block mb-2"><strong>Your decision clears this queue item.</strong> Gmail is not changed. The choice is recorded in the Brain decision ledger as evidence.</small>
                        <div class="d-flex gap-2 flex-wrap" data-s12="EMAIL_ACTIONS_ALL_QUEUES">
                            @if(x.Status == "IGNORED")
                            {
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"RESTORE")'>Restore to Needs Review</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-success" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"BRAIN_HANDLED")'>Brain handle</button>
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"SHOW")'>Send to Show Arm</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"IGNORED")'>Ignore / no action</button>
                            }
                            @if(x.UnsubscribeRecommended)
                            {
                                <button class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"KEEP_SUBSCRIBED")'>Keep sender</button>
                            }
                            else if(!x.IsProtectedSender)
                            {
                                <button class="btn btn-sm btn-outline-dark" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"UNSUBSCRIBE_CANDIDATE")'>Mark unsubscribe candidate</button>
                            }
                            @if(x.Status == "BRAIN_HANDLED")
                            {
                                <button class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick='()=>ResolveEmailAsync(x,"RESTORE")'>Reopen for review</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    List<ShowEmailIntakeEntity> _items=[];
    List<ShowEditionEntity> _editions=[];
    readonly Dictionary<long,long?> _selectedEditions=[];
    readonly Dictionary<long,string> _relationships=[];
    readonly Dictionary<string,long?> _selectedGroupEvents=[];
    readonly Dictionary<string,string> _groupRelationships=[];
    static readonly string[] Relationships=["Unknown","Considering","Applied","Accepted","Rejected","Waitlisted","Attended","Solicitation Only"];
    string _tab="direct", _message="", _busyScope="";
    bool _busy;
    HistoricalEmailPreviewResult? _historyPreview;

    string IntakeAddress => Config["BrainEmail:IntakeAddress"] ?? Environment.GetEnvironmentVariable("BRAIN_EMAIL_INTAKE_ADDRESS") ?? "ai-brain@ancient-innovations.com";
    int DirectCount => _items.Count(IsDirect);
    int Count(string status)=>_items.Count(x=>x.Status==status);
    static string RouteDestination(string route)=>route switch
    {
        "SHOW" => "→ Show Arm",
        "CUSTOMER" => "→ Customer decision",
        "OPERATIONS" => "→ Operations memory",
        "STORE" => "→ Store / wholesale",
        "TAX_FINANCIAL" => "→ Financial memory",
        "MARKETING" => "→ Marketing review",
        "SYSTEM_FYI" => "→ Brain handled",
        "IGNORE" => "→ No work created",
        _ => "→ Needs classification"
    };

    List<ShowEmailIntakeEntity> Visible => _tab switch
    {
        "direct" => _items.Where(IsDirect).ToList(),
        "needs" => _items.Where(x=>x.Status=="NEEDS_YOU").ToList(),
        "review" => _items.Where(x=>x.Status=="NEEDS_REVIEW").ToList(),
        "handled" => _items.Where(x=>x.Status=="BRAIN_HANDLED").ToList(),
        "junk" => _items.Where(x=>x.Status=="IGNORED").ToList(),
        "unsubscribe" => _items.Where(x=>x.UnsubscribeRecommended).ToList(), // B92_UNSUBSCRIBE_FILTER
        "history" => _items.Where(x=>x.Status=="HISTORICAL_REVIEW").ToList(),
        _ => _items.Where(x=>x.Status!="HISTORICAL").ToList()
    };

    string EmptyMessage => _tab=="direct"
        ? $"Click Check AI Brain Address to import only mail delivered to {IntakeAddress}."
        : "The Brain will put exceptions here as it reads your business inboxes.";

    protected override async Task OnInitializedAsync()
    {
        _editions=await Db.ShowEditions.AsNoTracking().Include(x=>x.ShowEvent).ToListAsync();
        await Load();
        await AutoResolveHighConfidenceAsync();
    }

    async Task Load()
    {
        var recent=await Db.ShowEmailIntakes.AsNoTracking().OrderByDescending(x=>x.MessageDate??x.ReceivedAt).Take(1000).ToListAsync();
        var history=await Db.ShowEmailIntakes.AsNoTracking().Where(x=>x.Status=="HISTORICAL_REVIEW").OrderByDescending(x=>x.MessageDate??x.ReceivedAt).ToListAsync();
        _items=recent.Concat(history).GroupBy(x=>x.Id).Select(g=>g.First()).OrderByDescending(x=>x.MessageDate??x.ReceivedAt).ToList();
    }

    async Task ImportDirectAsync()=>await ImportAsync(BrainEmailImportScope.DirectBrainAddress,"direct");
    async Task ImportBusinessAsync()=>await ImportAsync(BrainEmailImportScope.BusinessInboxes,"business");

    async Task ReprocessCurrentAsync()
    {
        _busy=true; _busyScope="reprocess";
        try
        {
            var r=await BrainEmail.ReprocessCurrentAsync();
            _message=r.Message;
            await Load();
        }
        catch(Exception ex){_message="Current-mail reprocess failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    async Task BackfillAttachmentsAsync()
    {
        _busy=true; _busyScope="attachments";
        try
        {
            var r=await BrainEmail.BackfillCurrentAttachmentsAsync();
            _message=r.Message;
            await Load();
        }
        catch(Exception ex){_message="Attachment backfill failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    async Task ImportAsync(BrainEmailImportScope scope,string busyScope)
    {
        _busy=true; _busyScope=busyScope;
        try
        {
            var r=await BrainEmail.ImportAsync(scope);
            _message=r.Message;
            await Load();
            _tab=scope==BrainEmailImportScope.DirectBrainAddress?"direct":_tab;
        }
        catch(Exception ex){_message="Email check failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }


    async Task PreviewHistoryAsync()
    {
        _busy=true; _busyScope="history-preview";
        try { _historyPreview=await BrainEmail.PreviewHistoricalAsync(); _message=_historyPreview.Message; }
        catch(Exception ex){_message="Historical preview failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    async Task ImportHistoryAsync()
    {
        _busy=true; _busyScope="history-import";
        try { var r=await BrainEmail.ImportHistoricalAsync(); _message=r.Message; await Load(); await AutoResolveHighConfidenceAsync(); _tab="history"; }
        catch(Exception ex){_message="Historical import failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    sealed record HistoricalShowGroup(string Key,string ProposedName,List<ShowEmailIntakeEntity> Items,List<int> Years,List<string> Mailboxes,string RelationshipSummary,string SenderSummary,string? ExistingShowName,long? ExistingShowEventId);

    int HistoricalReviewCount => _items.Count(x=>x.Status=="HISTORICAL_REVIEW");
    List<ShowEventEntity> ExistingShowEvents => _editions.GroupBy(e=>e.ShowEventId).Select(g=>g.First().ShowEvent).OrderBy(e=>e.Name).ToList();

    List<HistoricalShowGroup> HistoricalGroups
    {
        get
        {
            var source=_items.Where(x=>x.Status=="HISTORICAL_REVIEW").ToList();
            return source
                .Select(x=>new { Item=x, Name=InferShowName(x.Subject) ?? FallbackHistoricalShowName(x), Year=HistoricalYear(x) })
                .Where(z=>!string.IsNullOrWhiteSpace(z.Name))
                .GroupBy(z=>Normalize(z.Name))
                .Select(g=>BuildHistoricalGroup(g.Key,g.Select(z=>z.Item).ToList(),g.Select(z=>z.Name!).ToList(),g.Select(z=>z.Year).ToList()))
                .OrderByDescending(g=>g.Items.Count)
                .ThenBy(g=>g.ProposedName)
                .ToList();
        }
    }

    HistoricalShowGroup BuildHistoricalGroup(string key,List<ShowEmailIntakeEntity> items,List<string> names,List<int> years)
    {
        var proposed=names.Where(n=>!string.IsNullOrWhiteSpace(n)).GroupBy(n=>Normalize(n)).OrderByDescending(g=>g.Count()).ThenByDescending(g=>g.Key.Length).First().First();
        var cleanYears=years.Where(y=>y>=2000&&y<=2100).Distinct().OrderBy(y=>y).ToList();
        if(cleanYears.Count==0) cleanYears.Add(items.Select(HistoricalYear).FirstOrDefault(y=>y>0));
        var mailboxes=items.Select(x=>x.MailboxAddress??"Unknown").Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x).ToList();
        var rels=items.Select(InferHistoricalRelationship).GroupBy(x=>x).OrderByDescending(g=>g.Count()).Select(g=>$"{g.Key} {g.Count()}").ToList();
        var senders=items.Select(x=>SenderLabel(x.FromAddress)).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Take(4).ToList();

        var eventScores=ExistingShowEvents.Select(ev=>new { Event=ev, Score=GroupEventIdentityScore(ev,items,proposed) }).Where(x=>x.Score>=18).OrderByDescending(x=>x.Score).ToList();
        var best=eventScores.FirstOrDefault();
        var second=eventScores.Skip(1).FirstOrDefault();
        var confident=best is not null && (second is null || best.Score-second.Score>=5);
        return new HistoricalShowGroup(key,proposed,items,cleanYears,mailboxes,string.Join(" · ",rels),senders.Count==0?"Unknown":string.Join(", ",senders),confident?best!.Event.Name:null,confident?best!.Event.Id:null);
    }

    int GroupEventIdentityScore(ShowEventEntity ev,List<ShowEmailIntakeEntity> items,string proposed)
    {
        var name=Normalize(ev.Name); var proposal=Normalize(proposed); if(string.IsNullOrWhiteSpace(name)||string.IsNullOrWhiteSpace(proposal))return 0;
        if(name==proposal) return 50;
        if(ContainsPhrase(name,proposal)||ContainsPhrase(proposal,name)) return 40;
        var eventWords=MeaningfulWords(name).ToHashSet(); var proposalWords=MeaningfulWords(proposal).ToHashSet();
        var overlap=eventWords.Intersect(proposalWords).Count(); var score=overlap>=2?22+overlap*2:overlap==1&&eventWords.Count==1?20:0;
        if(score>0)
        {
            var text=Normalize(string.Join(" ",items.Select(x=>$"{x.Subject} {x.BodyText} {x.FromAddress}")));
            if(!string.IsNullOrWhiteSpace(ev.PromoterName)&&ContainsPhrase(text,Normalize(ev.PromoterName)))score+=5;
            if(!string.IsNullOrWhiteSpace(ev.City)&&ContainsWord(text,Normalize(ev.City)))score+=3;
            if(!string.IsNullOrWhiteSpace(ev.State)&&ContainsWord(text,Normalize(ev.State)))score+=1;
        }
        return score;
    }

    static int HistoricalYear(ShowEmailIntakeEntity x)=>ExtractExplicitYear(x.Subject) ?? ExtractExplicitYear(x.BodyText) ?? x.MessageDate?.Year ?? x.ReceivedAt.Year;
    static string FallbackHistoricalShowName(ShowEmailIntakeEntity x)
    {
        var subject=x.Subject??"Historical show";
        subject=System.Text.RegularExpressions.Regex.Replace(subject,@"^(re|fw|fwd)\s*:\s*","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        subject=System.Text.RegularExpressions.Regex.Replace(subject,@"\b20\d{2}\b"," ");
        subject=System.Text.RegularExpressions.Regex.Replace(subject,@"\s+"," ").Trim(' ','-','·',':');
        return subject.Length>100?subject[..100]:subject;
    }
    static string SenderLabel(string? address)
    {
        if(string.IsNullOrWhiteSpace(address))return "";
        var at=address.LastIndexOf('@'); return at>=0&&at<address.Length-1?address[(at+1)..].Trim('>',' '):address;
    }

    static string InferHistoricalRelationship(ShowEmailIntakeEntity x)
    {
        var text=Normalize($"{x.Subject} {x.BodyText}");
        if(text.Contains(" waitlist")||text.Contains(" wait list")) return "Waitlisted";
        if(text.Contains(" not accepted")||text.Contains(" regret to inform")||text.Contains(" declined")||text.Contains(" rejected")) return "Rejected";
        if(text.Contains(" congratulations")||text.Contains(" accepted")||text.Contains(" acceptance")) return "Accepted";
        if(text.Contains(" booth assignment")||text.Contains(" load in")||text.Contains(" setup instructions")||text.Contains(" pre festival info")||text.Contains(" vendor packet")) return "Attended";
        if(text.Contains(" application received")||text.Contains(" application submitted")||text.Contains(" thank you for applying")||text.Contains(" vendor application")) return "Applied";
        if(text.Contains(" invitation to apply")||text.Contains(" apply now")||text.Contains(" reminder to register")||text.Contains(" vendor opportunity")) return "Considering";
        if(text.Contains(" this weekend")||text.Contains(" join us")||text.Contains(" art lovers unite")) return "Solicitation Only";
        return "Unknown";
    }

