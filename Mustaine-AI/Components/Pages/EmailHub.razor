    async Task AcceptHistoricalAsync(ShowEmailIntakeEntity x,MatchSuggestion suggestion)
    {
        var editionId=SelectedEdition(x); if(editionId is null){_message="Choose a show/year before accepting this historical email.";return;}
        var e=_editions.First(z=>z.Id==editionId.Value); var row=await Db.ShowEmailIntakes.FindAsync(x.Id); if(row is null)return;
        row.ShowEditionId=e.Id; row.Status="HISTORICAL"; row.MatchNotes=$"Historical evidence confirmed to {e.ShowEvent.Name} · {e.Year}. Confidence: {(suggestion.Edition?.Id==e.Id?suggestion.Confidence:"OWNER_SELECTED")}."; row.ActionSummary=$"Historical relationship: {SelectedRelationship(x)}";
        await Db.SaveChangesAsync(); _message=$"Matched {x.Subject} to {e.ShowEvent.Name} · {e.Year}."; await Load();
    }
    async Task CreateHistoricalShowAsync(ShowEmailIntakeEntity x,MatchSuggestion suggestion)
    {
        if(string.IsNullOrWhiteSpace(suggestion.PossibleNewShow)){_message="The Brain could not infer a safe show name from this email.";return;}
        var year=suggestion.SuggestedYear>1900?suggestion.SuggestedYear:(x.MessageDate?.Year??DateTime.UtcNow.Year);
        var normalized=Normalize(suggestion.PossibleNewShow);
        var existing=_editions.FirstOrDefault(e=>e.Year==year && Normalize(e.ShowEvent.Name)==normalized);
        ShowEditionEntity edition;
        if(existing is not null) edition=existing;
        else
        {
            var show=new ShowEventEntity { Name=suggestion.PossibleNewShow, EventType="Historical/Unknown", Notes=$"Created from historical email evidence: {x.Subject}" };
            edition=new ShowEditionEntity { ShowEvent=show, Year=year, Status="RESEARCHING", LeadSource="HISTORICAL_EMAIL", ResearchStatus="NEEDS_RESEARCH", Recommendation="UNDECIDED", LeadNote=$"Historical email evidence from {x.MailboxAddress}: {x.Subject}" };
            Db.ShowEditions.Add(edition);
            await Db.SaveChangesAsync();
            _editions.Add(edition);
        }
        var row=await Db.ShowEmailIntakes.FindAsync(x.Id); if(row is null)return;
        row.ShowEditionId=edition.Id; row.Status="HISTORICAL"; row.MatchNotes=$"Historical evidence created/matched to {edition.ShowEvent.Name} · {edition.Year}. Owner confirmed new historical show."; row.ActionSummary=$"Historical relationship: {SelectedRelationship(x)}";
        await Db.SaveChangesAsync(); _message=$"Created historical show {edition.ShowEvent.Name} · {edition.Year} and attached this email."; await Load();
    }

    async Task NotOurShowAsync(ShowEmailIntakeEntity x)
    {
        var row=await Db.ShowEmailIntakes.FindAsync(x.Id); if(row is null)return; row.ShowEditionId=null; row.Status="HISTORICAL"; row.MatchNotes="Historical review: confirmed not one of our shows."; row.ActionSummary="Historical relationship: Solicitation Only"; await Db.SaveChangesAsync(); _message=$"Marked {x.Subject} as not our show."; await Load();
    }
    async Task AutoResolveHighConfidenceAsync()
    {
        var reviews=_items.Where(x=>x.Status=="HISTORICAL_REVIEW").ToList(); var changed=0;
        foreach(var x in reviews){var s=Suggest(x); if(s.Confidence!="HIGH"||s.Edition is null)continue; var row=await Db.ShowEmailIntakes.FindAsync(x.Id); if(row is null)continue; row.ShowEditionId=s.Edition.Id; row.Status="HISTORICAL"; row.MatchNotes=$"Historical evidence auto-matched to {s.Edition.ShowEvent.Name} · {s.Edition.Year}. Confidence: HIGH. {s.Reason}"; changed++;}
        if(changed>0){await Db.SaveChangesAsync(); _message=$"Brain auto-matched {changed} high-confidence historical show emails. Lower-confidence matches remain for review."; await Load();}
    }

    bool IsDirect(ShowEmailIntakeEntity x)
        => (!string.IsNullOrWhiteSpace(x.ToAddress) && x.ToAddress.Contains(IntakeAddress,StringComparison.OrdinalIgnoreCase))
           || (!string.IsNullOrWhiteSpace(x.MatchNotes) && x.MatchNotes.Contains(IntakeAddress,StringComparison.OrdinalIgnoreCase));

    static string EmailExcerpt(string? body)
    {
        if(string.IsNullOrWhiteSpace(body)) return "No useful message text was stored.";
        var text=System.Net.WebUtility.HtmlDecode(body);
        text=System.Text.RegularExpressions.Regex.Replace(text, @"https?://\S+", " ");
        text=System.Text.RegularExpressions.Regex.Replace(text, @"<[^>]+>", " ");
        text=System.Text.RegularExpressions.Regex.Replace(text, @"(?i)\b(view email in browser|view in browser|unsubscribe|privacy policy)\b", " ");
        text=System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        if(string.IsNullOrWhiteSpace(text)) return "No useful message text remains after removing links and boilerplate.";
        const int max=420;
        return text.Length<=max ? text : text[..max].TrimEnd()+"…";
    }

    string Tab(string x)=>"shows-tab "+(_tab==x?"active":"");
    // B7_EMAIL_ACTIONS — resolves the Brain's internal queue only; Gmail is never modified here.
    async Task ResolveEmailAsync(ShowEmailIntakeEntity item, string resolution)
    {
        _busy=true; _busyScope="email-decision";
        try
        {
            var row=await Db.ShowEmailIntakes.FindAsync(item.Id);
            if(row is null){_message="Email decision failed: record not found.";return;}

            string decision;
            switch(resolution)
            {
                case "SHOW":
                    row.Route="SHOW"; row.Status="BRAIN_HANDLED";
                    row.ActionSummary="Owner decision: route to Show Arm. Gmail unchanged.";
                    decision="ROUTE_SHOW_ARM";
                    break;
                case "IGNORED":
                    row.Status="IGNORED";
                    row.ActionSummary="Owner decision: no action needed. Gmail unchanged.";
                    decision="IGNORE_NO_ACTION";
                    break;
                case "UNSUBSCRIBE_CANDIDATE":
                    row.UnsubscribeRecommended=true; row.Status="IGNORED";
                    row.ActionSummary="Owner decision: unsubscribe candidate. No unsubscribe was performed; Gmail unchanged.";
                    decision="UNSUBSCRIBE_CANDIDATE";
                    break;
                case "RESTORE":
                    row.Status="NEEDS_REVIEW";
                    row.ActionSummary="Owner decision: reopen for review. Gmail unchanged.";
                    decision="REOPEN_REVIEW";
                    break;
                case "KEEP_SUBSCRIBED":
                    row.UnsubscribeRecommended=false;
                    if(row.Status=="IGNORED") row.Status="NEEDS_REVIEW";
                    row.ActionSummary="Owner decision: keep sender; unsubscribe suggestion cleared. Gmail unchanged.";
                    decision="KEEP_SUBSCRIBED";
                    break;
                default:
                    row.Status="BRAIN_HANDLED";
                    row.ActionSummary="Owner decision: Brain may handle this informational item. Gmail unchanged.";
                    decision="BRAIN_HANDLE";
                    break;
            }

            BrainDb.BrainDecisionRecords.Add(new BrainDecisionRecordEntity
            {
                AgentKey="BRAIN_EMAIL", ArmScope="BRAIN_CORE", SubjectType="EMAIL", SubjectKey=row.Id.ToString(), DecisionType="EMAIL_ROUTING",
                Recommendation=$"Brain route/status before owner decision: {item.Route} / {item.Status}",
                RecommendationReasoning=item.BrainSummary, HumanDecision=decision, HumanReasoning=row.ActionSummary, DecidedAt=DateTimeOffset.UtcNow
            });
            await Db.SaveChangesAsync();
            await BrainDb.SaveChangesAsync();
            await Load();
            _message=$"Email decision recorded: {decision}. Queue status updated; Gmail was not changed.";
        }
        catch(Exception ex){_message="Email decision failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

