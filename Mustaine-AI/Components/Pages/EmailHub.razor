    async Task ConsolidateHistoricalGroupAsync(HistoricalShowGroup g,bool requireExisting)
    {
        _busy=true; _busyScope="history-consolidate";
        try
        {
            ShowEventEntity show;
            var selectedId=SelectedGroupEvent(g);
            if(requireExisting)
            {
                if(selectedId is null){_message="Choose an existing show first.";return;}
                show=ExistingShowEvents.First(e=>e.Id==selectedId.Value);
            }
            else if(selectedId is not null)
            {
                show=ExistingShowEvents.First(e=>e.Id==selectedId.Value);
            }
            else
            {
                var exact=ExistingShowEvents.FirstOrDefault(e=>Normalize(e.Name)==Normalize(g.ProposedName));
                if(exact is not null) show=exact;
                else
                {
                    show=new ShowEventEntity { Name=g.ProposedName, EventType="Historical/Unknown", Notes=$"Created from {g.Items.Count} consolidated historical email records." };
                    Db.ShowEvents.Add(show); await Db.SaveChangesAsync();
                }
            }

            var overrideRelationship=SelectedGroupRelationship(g);
            var attached=0; var editionsCreated=0;
            foreach(var item in g.Items)
            {
                var year=HistoricalYear(item); if(year<2000||year>2100)continue;
                var edition=await Db.ShowEditions.FirstOrDefaultAsync(e=>e.ShowEventId==show.Id&&e.Year==year);
                if(edition is null)
                {
                    edition=new ShowEditionEntity { ShowEventId=show.Id, Year=year, Status="RESEARCHING", LeadSource="HISTORICAL_EMAIL", ResearchStatus="NEEDS_RESEARCH", Recommendation="UNDECIDED", LeadNote=$"Created by historical email consolidation for {g.ProposedName}." };
                    Db.ShowEditions.Add(edition); await Db.SaveChangesAsync(); editionsCreated++;
                }
                var row=await Db.ShowEmailIntakes.FindAsync(item.Id); if(row is null)continue;
                var relationship=overrideRelationship=="Brain infer per email"?InferHistoricalRelationship(item):overrideRelationship;
                row.ShowEditionId=edition.Id; row.Status="HISTORICAL"; row.MatchNotes=$"Historical consolidation: {g.ProposedName} → {show.Name} · {year}. Group contained {g.Items.Count} source emails."; row.ActionSummary=$"Historical relationship: {relationship}"; attached++;
            }
            await Db.SaveChangesAsync();
            _editions=await Db.ShowEditions.AsNoTracking().Include(x=>x.ShowEvent).ToListAsync();
            await Load();
            _message=$"Consolidated {attached} historical emails into {show.Name}; {editionsCreated} year edition(s) created.";
        }
        catch(Exception ex){_message="Historical consolidation failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    async Task NotOurHistoricalGroupAsync(HistoricalShowGroup g)
    {
        _busy=true; _busyScope="history-not-ours";
        try
        {
            foreach(var item in g.Items)
            {
                var row=await Db.ShowEmailIntakes.FindAsync(item.Id); if(row is null)continue;
                row.ShowEditionId=null; row.Status="HISTORICAL"; row.MatchNotes=$"Historical consolidation: {g.ProposedName} confirmed not one of our shows."; row.ActionSummary="Historical relationship: Solicitation Only";
            }
            await Db.SaveChangesAsync(); await Load(); _message=$"Marked {g.Items.Count} {g.ProposedName} email(s) as not our show.";
        }
        catch(Exception ex){_message="Historical consolidation failed: "+ex.Message;}
        finally{_busy=false;_busyScope="";}
    }

    sealed record MatchSuggestion(ShowEditionEntity? Edition,int Score,string Confidence,string Reason,string? PossibleNewShow,int SuggestedYear);

    MatchSuggestion Suggest(ShowEmailIntakeEntity x)
    {
        var subject=Normalize(x.Subject);
        var body=Normalize(x.BodyText);
        var combined=$" {subject} {body} ";
        var messageYear=x.MessageDate?.Year ?? 0;
        var explicitYear=ExtractExplicitYear(x.Subject) ?? ExtractExplicitYear(x.BodyText);
        var inferredSubjectName=InferShowName(x.Subject);
        var inferredSubject=Normalize(inferredSubjectName);
        var subjectIdentityWords=MeaningfulWords(inferredSubject).ToList();
        var subjectNamesAShow=!string.IsNullOrWhiteSpace(inferredSubjectName) && subjectIdentityWords.Count>0;

        // If the subject itself names a show, it is the identity anchor.  An unrelated show
        // mentioned later in a newsletter/body must never steal the match.
        var eventCandidates=_editions
            .GroupBy(e=>e.ShowEventId)
            .Select(g=>
            {
                var sample=g.First();
                var identity=IdentityScore(sample.ShowEvent,subject,combined,subjectNamesAShow);
                return new { Event=sample.ShowEvent, Identity=identity, Editions=g.ToList() };
            })
            .Where(z=>z.Identity.Score>0)
            .OrderByDescending(z=>z.Identity.Score)
            .ToList();

        if(eventCandidates.Count==0 || eventCandidates[0].Identity.Score<8)
        {
            var why=subjectNamesAShow
                ? $"Subject identifies ‘{inferredSubjectName}’, but no existing show has enough matching name evidence. Body mentions and year were ignored for show identity."
                : "No existing show has enough name, organizer, or location identity evidence.";
            return NewShowSuggestion(x,messageYear,why);
        }

        var best=eventCandidates[0];
        var second=eventCandidates.Skip(1).FirstOrDefault();
        var identityGap=second is null?best.Identity.Score:best.Identity.Score-second.Identity.Score;
        if(identityGap<4 && best.Identity.Score<24)
            return NewShowSuggestion(x,messageYear,$"Existing-show identity is ambiguous: best identity score {best.Identity.Score}, next-best gap {identityGap}.");

        // Only after the show itself is identified do we choose its year/edition.
        var targetYear=explicitYear ?? messageYear;
        var edition=best.Editions.FirstOrDefault(e=>e.Year==targetYear)
            ?? best.Editions.OrderBy(e=>Math.Abs(e.Year-targetYear)).FirstOrDefault();
        if(edition is null)
            return NewShowSuggestion(x,messageYear,"The show identity looks plausible, but there is no edition record to attach.");

        var yearEvidence=edition.Year==explicitYear?5:edition.Year==messageYear?2:0;
        var total=best.Identity.Score+yearEvidence;
        var confidence=best.Identity.Score>=24 && identityGap>=6?"HIGH":best.Identity.Score>=14 && identityGap>=4?"MEDIUM":"LOW";
        var reason=$"Show identity from {best.Identity.Reason}; identity score {best.Identity.Score}, next-best gap {identityGap}. " +
                   (yearEvidence>0?$"Year selected after identity ({edition.Year}).":"Year was not used to identify the show.");
        return new(edition,total,confidence,reason,null,edition.Year);
    }

    sealed record IdentityEvidence(int Score,string Reason);

    IdentityEvidence IdentityScore(ShowEventEntity show,string subject,string combined,bool subjectNamesAShow)
    {
        var name=Normalize(show.Name);
        if(string.IsNullOrWhiteSpace(name)) return new(0,"no event name");
        if(ContainsPhrase(subject,name)) return new(34,"exact show name in subject");

        var words=MeaningfulWords(name).ToList();
        var subjectHits=words.Count(w=>ContainsWord(subject,w));
        var bodyHits=words.Count(w=>ContainsWord(combined,w));
        var score=0; var reasons=new List<string>();
        if(subjectHits>=2){score+=22+Math.Min(subjectHits,4); reasons.Add($"{subjectHits} distinctive show-name words in subject");}
        else if(subjectHits==1 && words.Count==1){score+=18; reasons.Add("unique show-name word in subject");}
        else if(subjectHits==1){score+=9; reasons.Add("one distinctive show-name word in subject");}

        // When the subject names a show, body-only name hits cannot identify a different event.
        // The body may only strengthen an event already supported by the subject.
        if(!subjectNamesAShow && score==0)
        {
            if(ContainsPhrase(combined,name)){score=26; reasons.Add("exact show name in message");}
            else if(bodyHits>=2){score=12+Math.Min(bodyHits,3); reasons.Add($"{bodyHits} distinctive show-name words in message");}
            else if(bodyHits==1 && words.Count==1){score=10; reasons.Add("unique show-name word in message");}
        }

        var promoter=Normalize(show.PromoterName);
        if(score>=7 && !string.IsNullOrWhiteSpace(promoter)&&ContainsPhrase(combined,promoter)){score+=5; reasons.Add("organizer/promoter");}
        var city=Normalize(show.City);
        if(score>=7 && !string.IsNullOrWhiteSpace(city)&&ContainsWord(combined,city)){score+=3; reasons.Add("city");}
        var state=Normalize(show.State);
        if(score>=7 && !string.IsNullOrWhiteSpace(state)&&ContainsWord(combined,state)){score+=1; reasons.Add("state");}

        // City/state/promoter and year never create identity by themselves.
        return new(score,reasons.Count==0?"no meaningful show identity":string.Join(", ",reasons));
    }

    MatchSuggestion NewShowSuggestion(ShowEmailIntakeEntity x,int messageYear,string reason)
    {
        var proposed=InferShowName(x.Subject);
        var year=ExtractExplicitYear(x.Subject) ?? ExtractExplicitYear(x.BodyText) ?? messageYear;
        return new(null,0,"NO MATCH",reason,string.IsNullOrWhiteSpace(proposed)?null:proposed,year);
    }

    static IEnumerable<string> MeaningfulWords(string name)
    {
        var stop=new HashSet<string>(["festival","market","craft","show","fair","arts","art","the","and","of","at","annual","vendor","event"]);
        return name.Split(' ',StringSplitOptions.RemoveEmptyEntries)
            .Where(w=>w.Length>=4&&!stop.Contains(w)).Distinct();
    }
    static bool ContainsPhrase(string haystack,string phrase)=>!string.IsNullOrWhiteSpace(phrase) && $" {haystack} ".Contains($" {phrase} ");
    static bool ContainsWord(string haystack,string word)=>!string.IsNullOrWhiteSpace(word) && $" {haystack} ".Contains($" {word} ");
    static int? ExtractExplicitYear(string? value)
    {
        if(string.IsNullOrWhiteSpace(value)) return null;
        var m=System.Text.RegularExpressions.Regex.Match(value,@"\b(20\d{2})\b");
        return m.Success&&int.TryParse(m.Groups[1].Value,out var y)?y:null;
    }
    static string? InferShowName(string? subject)
    {
        if(string.IsNullOrWhiteSpace(subject)) return null;
        var s=System.Net.WebUtility.HtmlDecode(subject).Trim();
        s=System.Text.RegularExpressions.Regex.Replace(s,@"^(re|fw|fwd)\s*:\s*","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s=System.Text.RegularExpressions.Regex.Replace(s,@"^20\d{2}\s+","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if(s.Contains(':'))
        {
            var parts=s.Split(':',2);
            if(parts[0].Contains("reminder",StringComparison.OrdinalIgnoreCase)||parts[0].Contains("art lovers",StringComparison.OrdinalIgnoreCase)||parts[0].Contains("invitation",StringComparison.OrdinalIgnoreCase)) s=parts[1].Trim();
        }
        s=System.Text.RegularExpressions.Regex.Replace(s,@"\s*[·|-]\s*(reminder.*|pre[- ]?festival.*|vendor information.*|application information.*)$","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s=System.Text.RegularExpressions.Regex.Replace(s,@",?\s*(monday|tuesday|wednesday|thursday|friday|saturday|sunday)?\s*\d{1,2}/\d{1,2}/20\d{2}.*$","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s=System.Text.RegularExpressions.Regex.Replace(s,@"\s+(vendor\s+application|application|reminder to register|this weekend!?|registration reminder)\s*$","",System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s=System.Text.RegularExpressions.Regex.Replace(s,@"[^\p{L}\p{N}&'’ -]+"," ");
        s=System.Text.RegularExpressions.Regex.Replace(s,@"\s+"," ").Trim(' ','-');
        return s.Length is >=4 and <=120?s:null;
    }
    static string Normalize(string? s)
    {
        var chars=(s??"").ToLowerInvariant().Select(c=>char.IsLetterOrDigit(c)?c:' ').ToArray();
        return string.Join(' ',new string(chars).Split(' ',StringSplitOptions.RemoveEmptyEntries));
    }

