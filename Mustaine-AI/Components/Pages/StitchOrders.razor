    private static string? FindDirectoryIgnoreCase(string parentDirectory, string directoryName)
    {
        if (!Directory.Exists(parentDirectory))
        {
            return null;
        }

        return Directory.GetDirectories(parentDirectory)
            .FirstOrDefault(directory =>
                string.Equals(Path.GetFileName(directory), directoryName, StringComparison.OrdinalIgnoreCase));
    }

    private static string ToDisplaySegment(string segment) =>
        segment.Replace('_', ' ').Replace('-', ' ').Trim();

    private static bool IsMetadataFile(string filePath)
    {
        var fileName = Path.GetFileName(filePath);
        return string.Equals(fileName, "colors.txt", StringComparison.OrdinalIgnoreCase)
               || string.Equals(fileName, "cogs.txt", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSupportedAssetFile(string filePath)
    {
        if (IsMetadataFile(filePath))
        {
            return false;
        }

        var extension = Path.GetExtension(filePath);
        return IsImageFile(filePath)
               || extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".nc", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".gc", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".gcode", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".tap", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".lbrn", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".lbrn2", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".svg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".dxf", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsImageFile(string filePath)
    {
        var extension = Path.GetExtension(filePath);
        return extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".png", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".gif", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".webp", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".bmp", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".svg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".tif", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".tiff", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".avif", StringComparison.OrdinalIgnoreCase);
    }

    private static IEnumerable<string> EnumerateAssetDirectories(string directory)
    {
        var childDirectories = Directory.GetDirectories(directory)
            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var childAssetDirectories = childDirectories
            .SelectMany(EnumerateAssetDirectories)
            .ToList();
        var assetFiles = Directory.GetFiles(directory).Where(IsSupportedAssetFile).ToList();

        if (assetFiles.Count > 0 && childAssetDirectories.Count == 0)
        {
            yield return directory;
        }

        foreach (var childAssetDirectory in childAssetDirectories)
        {
            yield return childAssetDirectory;
        }
    }

    private static string GetCogsLabel(string filePath)
    {
        var current = new FileInfo(filePath).Directory;
        while (current is not null)
        {
            var cogsPath = Path.Combine(current.FullName, "cogs.txt");
            if (File.Exists(cogsPath))
            {
                var cogs = File.ReadAllText(cogsPath).Trim();
                var cogsValue = TryParseCogsValue(cogs);
                return cogsValue is null ? "COGS unset" : $"COGS {cogsValue.Value.ToString("C")}";
            }

            current = current.Parent;
        }

        return "COGS unset";
    }

    private static decimal? TryParseCogsValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var normalized = value.Trim();

        if (normalized.StartsWith("COGS", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized[4..].TrimStart(':', '-', ' ').Trim();
        }

        normalized = normalized.Replace("$", string.Empty).Trim();

        if (decimal.TryParse(
                normalized,
                System.Globalization.NumberStyles.Number | System.Globalization.NumberStyles.AllowCurrencySymbol,
                System.Globalization.CultureInfo.CurrentCulture,
                out var parsedCurrentCulture))
        {
            return parsedCurrentCulture;
        }

        if (decimal.TryParse(
                normalized,
                System.Globalization.NumberStyles.Number | System.Globalization.NumberStyles.AllowCurrencySymbol,
                System.Globalization.CultureInfo.InvariantCulture,
                out var parsedInvariantCulture))
        {
            return parsedInvariantCulture;
        }

        return null;
    }

    private static string? FirstConfigured(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private void SyncConfigurationDrafts(IEnumerable<ProductionQueueItemEntity> queueItems)
    {
        var ids = new HashSet<Guid>();

        foreach (var queueItem in queueItems)
        {
            ids.Add(queueItem.Id);
            _configurationDrafts[queueItem.Id] = ParseConfigurationFromNotes(queueItem.Notes);
        }

        foreach (var staleKey in _configurationDrafts.Keys.Where(key => !ids.Contains(key)).ToList())
        {
            _configurationDrafts.Remove(staleKey);
        }
    }

    private static StitchConfigurationDraft ParseConfigurationFromNotes(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return new StitchConfigurationDraft();
        }

        try
        {
            var payload = JsonSerializer.Deserialize<StitchConfigurationPayload>(notes);
            if (payload is not null && IsSupportedConfigurationSchema(payload.Schema))
            {
                return new StitchConfigurationDraft
                {
                    ProductCategory = payload.ProductCategory ?? payload.ProductTarget ?? string.Empty,
                    ProductName = payload.ProductName ?? payload.Variant ?? string.Empty,
                    ProductCogs = payload.ProductCogs ?? string.Empty,
                    SellPrice = payload.SellPrice ?? string.Empty,
                    AdditionalNotes = payload.AdditionalNotes ?? string.Empty,
                };
            }
        }
        catch
        {
            // Fallback below for legacy/plain notes values.
        }

        return new StitchConfigurationDraft
        {
            AdditionalNotes = notes,
        };
    }

    private static string BuildConfigurationNotes(StitchConfigurationDraft draft)
    {
        var payload = new StitchConfigurationPayload(
            StitchConfigurationPayload.SchemaVersion,
            NormalizeInput(draft.ProductCategory),
            NormalizeInput(draft.ProductName),
            NormalizeNumericInput(draft.ProductCogs),
            NormalizeNumericInput(draft.SellPrice),
            NormalizeInput(draft.AdditionalNotes));

        return JsonSerializer.Serialize(payload);
    }

    private static bool IsSupportedConfigurationSchema(string? schema) =>
        string.Equals(schema, StitchConfigurationPayload.SchemaVersion, StringComparison.Ordinal)
        || string.Equals(schema, StitchConfigurationPayload.LegacySchemaVersion, StringComparison.Ordinal);

    private static string? NormalizeInput(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? NormalizeNumericInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        return decimal.TryParse(trimmed, out var parsed)
            ? parsed.ToString("0.##")
            : null;
    }

    private string GetConfiguredOutputSummary(ProductionQueueRow item)
    {
        var draft = GetConfigurationDraft(item.Id);
        var segments = new List<string>();

        var category = NormalizeInput(draft.ProductCategory);
        var name = NormalizeInput(draft.ProductName);

        if (!string.IsNullOrWhiteSpace(category) && !string.IsNullOrWhiteSpace(name))
        {
            segments.Add($"{category} / {name}");
        }
        else if (!string.IsNullOrWhiteSpace(name))
        {
            segments.Add(name);
        }
        else if (!string.IsNullOrWhiteSpace(category))
        {
            segments.Add(category);
        }

        if (TryGetCurrencyLabel(draft.ProductCogs, out var cogsLabel))
        {
            segments.Add($"COGS {cogsLabel}");
        }

        if (TryGetCurrencyLabel(draft.SellPrice, out var sellPriceLabel))
        {
            segments.Add($"Sell {sellPriceLabel}");
        }

        return string.Join(" • ", segments);
    }

    private string GetLabelDisplayName(ProductionQueueRow item)
    {
        var configuredName = NormalizeInput(GetConfigurationDraft(item.Id).ProductName);
        return string.IsNullOrWhiteSpace(configuredName) ? item.ElementName : configuredName;
    }

    private string? GetLabelPriceText(ProductionQueueRow item)
    {
        if (!_labelTemplateIncludePrice)
        {
            return null;
        }

        if (TryGetCurrencyLabel(GetConfigurationDraft(item.Id).SellPrice, out var configuredPriceLabel))
        {
            return configuredPriceLabel;
        }

        return NormalizeInput(_labelTemplatePriceText);
    }

    private static bool TryGetCurrencyLabel(string? value, out string currency)
    {
        currency = string.Empty;

        var normalized = NormalizeNumericInput(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return false;
        }

        if (!decimal.TryParse(normalized, out var parsed))
        {
            return false;
        }

        currency = parsed.ToString("C");
        return true;
    }

    private string GetLabelSku(ProductionQueueRow item) =>
        string.IsNullOrWhiteSpace(item.Sku) ? item.ElementKey : item.Sku;

