    private string BuildLabelPrintUrl()
    {
        var query = new List<string>
        {
            $"date={Uri.EscapeDataString(_productionDate.ToString("yyyy-MM-dd"))}",
            $"width={Uri.EscapeDataString(_labelTemplateWidthInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"height={Uri.EscapeDataString(_labelTemplateHeightInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"marginTop={Uri.EscapeDataString(_labelTemplateMarginTopInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"marginRight={Uri.EscapeDataString(_labelTemplateMarginRightInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"marginBottom={Uri.EscapeDataString(_labelTemplateMarginBottomInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"marginLeft={Uri.EscapeDataString(_labelTemplateMarginLeftInInches.ToString(System.Globalization.CultureInfo.InvariantCulture))}",
            $"includePrice={_labelTemplateIncludePrice.ToString().ToLowerInvariant()}",
            $"price={Uri.EscapeDataString(_labelTemplatePriceText ?? string.Empty)}",
            "autoprint=true"
        };

        return NavigationManager.ToAbsoluteUri($"/production/labels?{string.Join("&", query)}").ToString();
    }

