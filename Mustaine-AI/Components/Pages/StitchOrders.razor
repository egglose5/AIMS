    private static string GenerateCode128Svg(string value)
    {
        var payload = string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();
        var codes = new List<int> { 104 };

        foreach (var character in payload)
        {
            var normalized = character is < ' ' or > '~' ? '?' : character;
            codes.Add(normalized - 32);
        }

        var checksum = codes[0];
        for (var index = 1; index < codes.Count; index++)
        {
            checksum += codes[index] * index;
        }

        checksum %= 103;
        codes.Add(checksum);
        codes.Add(106);

        const int moduleWidth = 2;
        const int quietZone = 10;
        const int barHeight = 48;

        var x = quietZone;
        var bars = new List<string>();

        foreach (var code in codes)
        {
            var pattern = Code128Patterns[code];
            var drawBar = true;

            foreach (var digit in pattern)
            {
                var width = (digit - '0') * moduleWidth;
                if (drawBar)
                {
                    bars.Add($"<rect x=\"{x}\" y=\"0\" width=\"{width}\" height=\"{barHeight}\" fill=\"#000\" />");
                }

                x += width;
                drawBar = !drawBar;
            }
        }

        var totalWidth = x + quietZone;
        var text = System.Net.WebUtility.HtmlEncode(payload);

        return $"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{totalWidth}\" height=\"{barHeight}\" viewBox=\"0 0 {totalWidth} {barHeight}\" shape-rendering=\"crispEdges\" role=\"img\" aria-label=\"Code 128 barcode for {text}\"><rect width=\"100%\" height=\"100%\" fill=\"#fff\" />{string.Join(string.Empty, bars)}</svg>";
    }

