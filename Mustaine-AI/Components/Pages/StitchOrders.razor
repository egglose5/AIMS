    private static bool MatchesElementSearch(StitchElementLibraryRow element, string? searchTerm)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        var query = searchTerm.Trim();
        return ContainsIgnoreCase(element.Name, query)
            || ContainsIgnoreCase(element.ElementType, query)
            || ContainsIgnoreCase(element.SourceGroup, query)
            || ContainsIgnoreCase(element.SourceReference, query)
            || ContainsIgnoreCase(element.Details, query)
            || ContainsIgnoreCase(element.BadgeLabel, query)
            || ContainsIgnoreCase(element.ElementKey, query);
    }

    private static bool ContainsIgnoreCase(string? value, string query) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

