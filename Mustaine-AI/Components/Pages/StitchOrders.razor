@page "/stitch-orders"
@rendermode InteractiveServer
@using MustaineAI.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject ApplicationDbContext DbContext
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Stitch Orders</PageTitle>

<div class="production-hero">
    <p class="production-eyebrow">Dynamo</p>
    <h1 class="production-title">Stitch Orders</h1>
    <p class="production-subtitle">
        Manage stitcher assignments, completed product options, and production labels in one stitch-focused workspace.
    </p>
</div>

<section class="production-card mb-3">
    <div class="production-card-header">
        <div>
            <h2>Stitch Team</h2>
            <span class="text-body-secondary">Non-Square employees with the Stitcher role</span>
        </div>
        <span class="production-badge">@Stitchers.Count stitcher(s)</span>
    </div>

    @if (_isLoadingStitchers)
    {
        <div class="production-empty">Loading stitchers...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_stitcherLoadError))
    {
        <div class="production-status production-status-error">@_stitcherLoadError</div>
    }
    else if (!Stitchers.Any())
    {
        <div class="production-empty">No non-Square employees with role "Stitcher" were found.</div>
    }
    else
    {
        <div class="production-label-template-form">
            <div>
                <label class="form-label" for="stitcher-picker">Assigned Stitcher</label>
                <select id="stitcher-picker" class="form-select" @bind="_selectedStitcherId">
                    @foreach (var stitcher in Stitchers)
                    {
                        <option value="@stitcher.Id.ToString()">@stitcher.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Role</label>
                <input class="form-control" value="@SelectedStitcherRoleLabel" disabled />
            </div>
            <div>
                <label class="form-label">Contact</label>
                <input class="form-control" value="@SelectedStitcherContactLabel" disabled />
            </div>
        </div>
    }
</section>

<section class="production-card mb-3">
    <div class="production-card-header">
        <div>
            <h2>Available Front-Face Elements</h2>
            <span class="text-body-secondary">All front faces from process files</span>
        </div>
        <span class="production-badge">@FilteredAvailableFrontFaceElements.Count item(s)</span>
    </div>

    <div class="production-label-template-form mb-3">
        <div>
            <label class="form-label" for="stitch-elements-search">Search Elements</label>
            <InputText id="stitch-elements-search"
                       class="form-control"
                       @bind-Value="_availableElementsSearchTerm"
                       placeholder="Search name, category, details, or COGS" />
        </div>
        <div class="d-flex align-items-end">
            <button class="btn btn-outline-secondary" type="button" @onclick="ClearAvailableElementsSearch" disabled="@string.IsNullOrWhiteSpace(_availableElementsSearchTerm)">
                Clear
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_availableElementsLoadError))
    {
        <div class="production-status production-status-error">@_availableElementsLoadError</div>
    }

    @if (!AvailableFrontFaceElements.Any())
    {
        <div class="production-empty">No front-face elements were found.</div>
    }
    else if (!FilteredAvailableFrontFaceElements.Any())
    {
        <div class="production-empty">No front-face elements match your search.</div>
    }
    else
    {
        <div class="production-element-list">
            @foreach (var element in FilteredAvailableFrontFaceElements)
            {
                var queuedItem = GetQueuedItem(element);

                <article class="production-element-row @(queuedItem is not null ? "is-queued" : string.Empty)">
                    <div class="production-element-main">
                        <div class="production-element-topline">
                            <div class="production-name">@element.Name</div>
                            <div class="production-element-badges">
                                <span class="production-badge production-badge-muted">@element.ElementType</span>
                                <span class="production-badge production-badge-primary">@element.BadgeLabel</span>
                                @if (queuedItem is not null)
                                {
                                    <span class="production-badge production-badge-success">In Queue: @queuedItem.Quantity</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(element.SourceReference))
                        {
                            <div class="production-meta">@element.SourceReference</div>
                        }

                        <div class="production-meta">@element.Details</div>
                    </div>

                    <div class="production-element-action-shell">
                        <div class="production-element-action">
                            <button class="btn btn-sm btn-outline-primary"
                                    type="button"
                                    @onclick="() => AddElementToProductionQueueAsync(element, 1)"
                                    disabled="@_isSavingQueueItem">
                                +1
                            </button>
                            <input class="form-control form-control-sm production-amount-input"
                                   type="number"
                                   min="1"
                                   step="1"
                                   value="@GetDraftQuantity(element.ElementKey)"
                                   @oninput="eventArgs => UpdateDraftQuantity(element.ElementKey, eventArgs.Value?.ToString())" />
                            <button class="btn btn-sm btn-primary"
                                    type="button"
                                    @onclick="() => AddElementToProductionQueueAsync(element, GetDraftQuantity(element.ElementKey))"
                                    disabled="@_isSavingQueueItem">
                                Add
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="production-card mb-3">
    <div class="production-card-header">
        <div>
            <h2>Completed Product Options</h2>
            <span class="text-body-secondary">Set front-face tier/color options for queued stitch work</span>
        </div>
        <span class="production-badge">@FrontFaceQueueItems.Count item(s)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_queueMessage))
    {
        <div class="production-status">@_queueMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_queueLoadError))
    {
        <div class="production-status production-status-error">@_queueLoadError</div>
    }

    @if (_isLoadingQueue)
    {
        <div class="production-empty">Loading queued products...</div>
    }
    else if (!FrontFaceQueueItems.Any())
    {
        <div class="production-empty">No front-face products are queued for today.</div>
    }
    else
    {
        <div class="production-element-list">
            @foreach (var item in FrontFaceQueueItems)
            {
                <article class="production-element-row is-queued">
                    <div class="production-element-main">
                        <div class="production-element-topline">
                            <div class="production-name">@item.ElementName</div>
                            <div class="production-element-badges">
                                <span class="production-badge production-badge-primary">Qty @item.Quantity</span>
                                <span class="production-badge @GetStageClass(item.Stage)">@item.Stage</span>
                            </div>
                        </div>

                        <div class="production-meta">@item.SourceGroup</div>

                        @if (!string.IsNullOrWhiteSpace(GetConfiguredOutputSummary(item)))
                        {
                            <div class="production-meta">Configured Output: @GetConfiguredOutputSummary(item)</div>
                        }

                        <div class="production-front-face-tier-prompt">
                            <span>Is this base or deluxe?</span>
                            <div class="production-front-face-tier-actions">
                                @foreach (var tierOption in FrontFaceTierOptions)
                                {
                                    <button class="btn btn-sm @(string.Equals(item.FrontFaceTier, tierOption, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-primary")"
                                            type="button"
                                            @onclick='() => SetFrontFaceTierAsync(item, tierOption)'
                                            disabled="@_isSavingQueueItem">
                                        @tierOption
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.FrontFaceTier))
                        {
                            <div class="production-front-face-tier-prompt">
                                <span>Is this black or brown?</span>
                                <div class="production-front-face-tier-actions">
                                    @foreach (var colorOption in FrontFaceColorOptions)
                                    {
                                        <button class="btn btn-sm @(string.Equals(item.FrontFaceColor, colorOption, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-primary")"
                                                type="button"
                                                @onclick='() => SetFrontFaceColorAsync(item, colorOption)'
                                                disabled="@_isSavingQueueItem">
                                            @colorOption
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                           <div class="production-front-face-tier-prompt">
                            <span>Finished Goods Category</span>
                            <input class="form-control form-control-sm"
                                value="@GetConfigurationDraft(item.Id).ProductCategory"
                                @oninput='eventArgs => UpdateConfigurationCategory(item.Id, eventArgs.Value?.ToString())'
                                placeholder="Passport Sleeves, Travel Games, etc." />
                        </div>

                        <div class="production-front-face-tier-prompt">
                            <span>Finished Goods Name</span>
                            <input class="form-control form-control-sm"
                                value="@GetConfigurationDraft(item.Id).ProductName"
                                @oninput='eventArgs => UpdateConfigurationName(item.Id, eventArgs.Value?.ToString())'
                                placeholder="Passport Sleeve Deluxe, etc." />
                           </div>

                           <div class="production-front-face-tier-prompt">
                            <span>Product COGS</span>
                            <input class="form-control form-control-sm"
                                type="number"
                                min="0"
                                step="0.01"
                                value="@GetConfigurationDraft(item.Id).ProductCogs"
                                @oninput='eventArgs => UpdateConfigurationCogs(item.Id, eventArgs.Value?.ToString())'
                                placeholder="0.00" />
                           </div>

                           <div class="production-front-face-tier-prompt">
                            <span>Sell Price</span>
                            <input class="form-control form-control-sm"
                                type="number"
                                min="0"
                                step="0.01"
                                value="@GetConfigurationDraft(item.Id).SellPrice"
                                @oninput='eventArgs => UpdateConfigurationSellPrice(item.Id, eventArgs.Value?.ToString())'
                                placeholder="0.00" />
                        </div>

                        <div class="production-front-face-tier-prompt">
                            <span>Any stitch notes?</span>
                            <input class="form-control form-control-sm"
                                   value="@GetConfigurationDraft(item.Id).AdditionalNotes"
                                   @oninput='eventArgs => UpdateConfigurationNotes(item.Id, eventArgs.Value?.ToString())'
                                   placeholder="Special assembly instructions" />
                            <div class="d-flex justify-content-end mt-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        type="button"
                                        @onclick='() => SaveConfigurationAsync(item)'
                                        disabled="@_isSavingConfiguration">
                                    Save Configuration
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="production-card mb-3">
    <div class="production-card-header">
        <div>
            <h2>Recent Production Adds</h2>
            <span class="text-body-secondary">Everything added to today's production sheet, including notebook parts and other non-stitch builds.</span>
        </div>
        <span class="production-badge">@RecentProductionAdds.Count item(s)</span>
    </div>

    @if (!RecentProductionAdds.Any())
    {
        <div class="production-empty">No production items have been added yet.</div>
    }
    else
    {
        <div class="production-folder-list">
            @foreach (var item in RecentProductionAdds)
            {
                <article class="production-folder-row">
                    <div>
                        <div class="production-name">@item.ElementName</div>
                        <div class="production-meta">@item.ElementType / @item.SourceGroup</div>
                        @if (!string.IsNullOrWhiteSpace(item.SourceReference))
                        {
                            <div class="production-meta">@item.SourceReference</div>
                        }
                    </div>
                    <div class="production-complete-meta">
                        <span>@item.AddedLabel</span>
                        <strong>Qty @item.Quantity</strong>
                        <span class="production-badge @(string.Equals(item.Stage, "Queued", StringComparison.OrdinalIgnoreCase) ? "production-badge-success" : "production-badge-muted")">
                            @item.Stage
                        </span>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="production-card">
    <div class="production-card-header">
        <div>
            <h2>Label Template</h2>
            <span class="text-body-secondary">Dymo-style label layout with name, barcode image, SKU text, and optional price line.</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
            <span class="production-badge">@ProductionQueue.Count label(s)</span>
            <button class="btn btn-primary" type="button" @onclick="OpenLabelPrintPageAsync" disabled="@(!ProductionQueue.Any())">Print Labels</button>
        </div>
    </div>

    <div class="production-label-template-grid">
        <section class="production-focus-card">
            <div class="production-section-header">
                <div>
                    <h3>Label Template</h3>
                    <span>Adjust the print layout before opening the label sheet.</span>
                </div>
            </div>

            <div class="production-label-template-form">
                <div>
                    <label class="form-label" for="label-width">Label Width</label>
                    <InputNumber id="label-width" class="form-control" @bind-Value="_labelTemplateWidthInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-height">Label Height</label>
                    <InputNumber id="label-height" class="form-control" @bind-Value="_labelTemplateHeightInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-margin-top">Top Margin</label>
                    <InputNumber id="label-margin-top" class="form-control" @bind-Value="_labelTemplateMarginTopInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-margin-right">Right Margin</label>
                    <InputNumber id="label-margin-right" class="form-control" @bind-Value="_labelTemplateMarginRightInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-margin-bottom">Bottom Margin</label>
                    <InputNumber id="label-margin-bottom" class="form-control" @bind-Value="_labelTemplateMarginBottomInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-margin-left">Left Margin</label>
                    <InputNumber id="label-margin-left" class="form-control" @bind-Value="_labelTemplateMarginLeftInInches" />
                </div>
                <div>
                    <label class="form-label" for="label-price-text">Optional Price</label>
                    <InputText id="label-price-text" class="form-control" @bind-Value="_labelTemplatePriceText" placeholder="$12.00" />
                </div>
                <div class="form-check production-label-template-include-price">
                    <input id="label-include-price" class="form-check-input" type="checkbox" @bind="_labelTemplateIncludePrice" />
                    <label class="form-check-label" for="label-include-price">Include price line</label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_labelTemplateMessage))
            {
                <div class="production-status">@_labelTemplateMessage</div>
            }
        </section>

        <section class="production-focus-card production-label-template-preview" aria-label="Label preview">
            <div class="production-section-header">
                <div>
                    <h3>Preview</h3>
                    <span>Name, barcode image, SKU text, and optional price match the print sheet.</span>
                </div>
            </div>

            @if (!ProductionQueue.Any())
            {
                <div class="production-empty">No queued items to label yet.</div>
            }
            else
            {
                <div class="production-label-grid">
                    @foreach (var item in ProductionQueue)
                    {
                        <article class="production-label-card" style="width:@($"{_labelTemplateWidthInInches}in"); min-height:@($"{_labelTemplateHeightInInches}in"); padding:@($"{_labelTemplateMarginTopInInches}in {_labelTemplateMarginRightInInches}in {_labelTemplateMarginBottomInInches}in {_labelTemplateMarginLeftInInches}in")">
                            <div class="production-label-name">@GetLabelDisplayName(item)</div>
                            <div class="production-label-barcode">
                                @((MarkupString)GenerateCode128Svg(GetLabelSku(item)))
                            </div>
                            <div class="production-label-sku">SKU: @GetLabelSku(item)</div>
                            @if (!string.IsNullOrWhiteSpace(GetLabelPriceText(item)))
                            {
                                <div class="production-label-price">@GetLabelPriceText(item)</div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>

@code {
    private readonly DateOnly _productionDate = DateOnly.FromDateTime(DateTime.Now);
    private bool _isLoadingStitchers = true;
    private bool _isLoadingQueue = true;
    private bool _isSavingQueueItem;
    private bool _isSavingConfiguration;
    private string? _stitcherLoadError;
    private string? _availableElementsLoadError;
    private string? _queueLoadError;
    private string? _queueMessage;
    private string? _availableElementsSearchTerm;
    private Guid? _selectedStitcherId;
    private readonly Dictionary<string, int> _quantityDrafts = new(StringComparer.Ordinal);
    private readonly Dictionary<Guid, StitchConfigurationDraft> _configurationDrafts = new();

    private IReadOnlyList<StitcherRow> Stitchers = [];
    private IReadOnlyList<ProductionQueueRow> ProductionQueue = [];
    private IReadOnlyList<StitchElementLibraryRow> AvailableFrontFaceElements = [];
    private IReadOnlyList<string> FrontFaceTierOptions = ["Base", "Deluxe"];
    private IReadOnlyList<string> FrontFaceColorOptions = ["Black", "Brown"];

    private decimal _labelTemplateWidthInInches = 2.13m;
    private decimal _labelTemplateHeightInInches = 1.13m;
    private decimal _labelTemplateMarginTopInInches = 0.10m;
    private decimal _labelTemplateMarginRightInInches = 0.10m;
    private decimal _labelTemplateMarginBottomInInches = 0.10m;
    private decimal _labelTemplateMarginLeftInInches = 0.10m;
    private bool _labelTemplateIncludePrice;
    private string? _labelTemplatePriceText;
    private string? _labelTemplateMessage;

    private IReadOnlyList<ProductionQueueRow> FrontFaceQueueItems =>
        ProductionQueue
            .Where(IsFrontFaceQueueItem)
            .OrderBy(item => item.ElementName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<ProductionQueueRow> RecentProductionAdds =>
        ProductionQueue
            .OrderByDescending(item => item.AddedAt)
            .ThenByDescending(item => item.Quantity)
            .Take(8)
            .ToList();

    private IReadOnlyList<StitchElementLibraryRow> FilteredAvailableFrontFaceElements =>
        string.IsNullOrWhiteSpace(_availableElementsSearchTerm)
            ? AvailableFrontFaceElements
            : AvailableFrontFaceElements
                .Where(element => MatchesElementSearch(element, _availableElementsSearchTerm))
                .ToList();

    private StitcherRow? SelectedStitcher =>
        _selectedStitcherId is null
            ? null
            : Stitchers.FirstOrDefault(stitcher => stitcher.Id == _selectedStitcherId.Value);

    private string SelectedStitcherRoleLabel =>
        string.IsNullOrWhiteSpace(SelectedStitcher?.Role)
            ? "Stitcher"
            : SelectedStitcher.Role!;

    private string SelectedStitcherContactLabel =>
        FirstConfigured(SelectedStitcher?.EmailAddress, SelectedStitcher?.PhoneNumber)
            ?? "No contact saved";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplateOptionsAsync();
        await LoadStitchersAsync();
        await LoadAvailableFrontFaceElementsAsync();
        await LoadProductionQueueAsync();
    }

    private Task LoadAvailableFrontFaceElementsAsync()
    {
        try
        {
            var processFilesRoot = GetProcessFilesRoot();

            if (!Directory.Exists(processFilesRoot))
            {
                AvailableFrontFaceElements = [];
                _availableElementsLoadError = null;
                return Task.CompletedTask;
            }

            var frontFacesRoot = FindDirectoryIgnoreCase(processFilesRoot, "front-faces");

            if (string.IsNullOrWhiteSpace(frontFacesRoot) || !Directory.Exists(frontFacesRoot))
            {
                AvailableFrontFaceElements = [];
                _availableElementsLoadError = null;
                return Task.CompletedTask;
            }

            var elements = EnumerateAssetDirectories(frontFacesRoot)
                .Select(assetDirectory =>
                {
                    var relativePath = Path.GetRelativePath(frontFacesRoot, assetDirectory);
                    var segments = relativePath
                        .Split([Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar], StringSplitOptions.RemoveEmptyEntries);
                    var displayPath = string.Join(" / ", segments.Select(ToDisplaySegment));
                    var files = Directory.GetFiles(assetDirectory)
                        .Where(IsSupportedAssetFile)
                        .OrderBy(file => file, StringComparer.OrdinalIgnoreCase)
                        .Select(Path.GetFileName)
                        .ToList();
                    var cogsLabel = GetCogsLabel(assetDirectory);

                    return new StitchElementLibraryRow(
                        "Front Face",
                        $"front-faces::{relativePath.Replace(Path.DirectorySeparatorChar, '/')}".ToLowerInvariant(),
                        displayPath,
                        "Front Faces",
                        displayPath,
                        files.Count == 0 ? cogsLabel : $"{files.Count} file(s) · {cogsLabel}",
                        cogsLabel);
                })
                .DistinctBy(item => item.ElementKey)
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            AvailableFrontFaceElements = elements;

            _availableElementsLoadError = null;
        }
        catch (Exception exception)
        {
            AvailableFrontFaceElements = [];
            _availableElementsLoadError = $"Front-face elements could not be loaded. {exception.Message}";
        }

        return Task.CompletedTask;
    }

    private async Task LoadTemplateOptionsAsync()
    {
        try
        {
            var template = await DbContext.FinishedGoodsTemplates
                .AsNoTracking()
                .FirstOrDefaultAsync(entity => entity.Id == FinishedGoodsTemplateEntity.DefaultId);

            if (template is null)
            {
                return;
            }

            var tierOptions = ParseCsvValues(template.FrontFaceTierOptionsCsv);
            if (tierOptions.Count > 0)
            {
                FrontFaceTierOptions = tierOptions;
            }

            var colorOptions = ParseCsvValues(template.FrontFaceColorOptionsCsv);
            if (colorOptions.Count > 0)
            {
                FrontFaceColorOptions = colorOptions;
            }
        }
        catch
        {
            // Keep defaults if templates are unavailable.
        }
    }

    private async Task LoadStitchersAsync()
    {
        _isLoadingStitchers = true;

        try
        {
            Stitchers = await DbContext.EmployeeRosterEntries
                .AsNoTracking()
                .Where(employee => EF.Functions.ILike(employee.Status, "active"))
                .Where(employee => employee.Role != null && EF.Functions.ILike(employee.Role, "%stitcher%"))
                .OrderBy(employee => employee.Name)
                .Select(employee => new StitcherRow(
                    employee.Id,
                    employee.Name,
                    employee.Role,
                    employee.Department,
                    employee.EmailAddress,
                    employee.PhoneNumber))
                .ToListAsync();

            if (_selectedStitcherId is null || Stitchers.All(stitcher => stitcher.Id != _selectedStitcherId))
            {
                _selectedStitcherId = Stitchers.FirstOrDefault()?.Id;
            }

            _stitcherLoadError = null;
        }
        catch (Exception exception)
        {
            Stitchers = [];
            _stitcherLoadError = $"Stitchers could not be loaded. {exception.Message}";
        }
        finally
        {
            _isLoadingStitchers = false;
        }
    }

    private async Task LoadProductionQueueAsync()
    {
        _isLoadingQueue = true;

        try
        {
            var queueItems = await DbContext.ProductionQueueItems
                .AsNoTracking()
                .Where(item => item.ProductionDate == _productionDate)
                .Where(item => !(item.ElementType == "Sheet"
                    && item.SourceGroup == "System"
                    && item.Stage == "Sheet"))
                .OrderBy(item => item.Stage)
                .ThenBy(item => item.ElementName, StringComparer.OrdinalIgnoreCase)
                .ToListAsync();

            ProductionQueue = queueItems
                .Select(item => new ProductionQueueRow(
                    item.Id,
                    item.ElementType,
                    item.ElementKey,
                    item.Sku,
                    item.ElementName,
                    item.SourceGroup,
                    item.SourceReference,
                    item.Stage,
                    item.FrontFaceTier,
                    item.FrontFaceColor,
                    item.Quantity,
                    item.AddedAt))
                .ToList();

            SyncConfigurationDrafts(queueItems);

            _queueLoadError = null;
        }
        catch (Exception exception)
        {
            ProductionQueue = [];
            _queueLoadError = $"Production queue could not be loaded. {exception.Message}";
        }
        finally
        {
            _isLoadingQueue = false;
        }
    }

    private async Task AddElementToProductionQueueAsync(StitchElementLibraryRow element, int quantity)
    {
        _queueMessage = null;

        if (quantity < 1)
        {
            _queueMessage = "Quantity must be at least 1.";
            return;
        }

        _isSavingQueueItem = true;

        try
        {
            var now = DateTimeOffset.UtcNow;
            var queueItem = await DbContext.ProductionQueueItems
                .FirstOrDefaultAsync(item => item.ProductionDate == _productionDate && item.ElementKey == element.ElementKey);

            if (queueItem is null)
            {
                queueItem = new ProductionQueueItemEntity
                {
                    ProductionDate = _productionDate,
                    ElementType = element.ElementType,
                    ElementKey = element.ElementKey,
                    Sku = element.ElementKey,
                    ElementName = element.Name,
                    SourceGroup = element.SourceGroup,
                    SourceReference = element.SourceReference,
                    Stage = "Queued",
                    Quantity = quantity,
                    AddedAt = now,
                    UpdatedAt = now,
                };

                DbContext.ProductionQueueItems.Add(queueItem);
            }
            else
            {
                queueItem.Quantity += quantity;
                queueItem.UpdatedAt = now;
            }

            await DbContext.SaveChangesAsync();
