    private async Task SaveConfigurationAsync(ProductionQueueRow queuedItem)
    {
        _queueMessage = null;
        _isSavingConfiguration = true;

        try
        {
            var queueItem = await DbContext.ProductionQueueItems
                .FirstOrDefaultAsync(item => item.Id == queuedItem.Id);

            if (queueItem is null)
            {
                _queueMessage = "The queued item could not be found.";
                return;
            }

            var draft = GetConfigurationDraft(queuedItem.Id);
            queueItem.Notes = BuildConfigurationNotes(draft);
            queueItem.UpdatedAt = DateTimeOffset.UtcNow;

            await DbContext.SaveChangesAsync();
            _queueMessage = $"Saved configuration for {queuedItem.ElementName}.";
        }
        catch (Exception exception)
        {
            _queueMessage = $"Configuration could not be saved. {exception.Message}";
        }
        finally
        {
            _isSavingConfiguration = false;
        }
    }

