BRAIN_EMAIL_USERNAME=info@ancient-innovations.com
BRAIN_EMAIL_APP_PASSWORD=replace-with-google-app-password
BRAIN_EMAIL_INTAKE_ADDRESS=ai-brain@ancient-innovations.com

# Optional: explicit one-time bootstrap admin creation for a brand-new install.
# Leave disabled for existing systems. Startup will never reset an existing password.
CONTROLAPP_BOOTSTRAP_ADMIN_ENABLED=false
CONTROLAPP_BOOTSTRAP_ADMIN_USERNAME=admin
CONTROLAPP_BOOTSTRAP_ADMIN_EMAIL=admin@control-app.local
CONTROLAPP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-non-default-password
